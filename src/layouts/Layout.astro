      'KW': { regionLabel: 'Governorate',    regionPh: 'Al Asimah',     postalLabel: 'Postal Code',    postalPh: '13001'       },
      'BH': { regionLabel: 'Governorate',    regionPh: 'Capital',       postalLabel: 'Postal Code',    postalPh: '317'         },
      'OM': { regionLabel: 'Governorate',    regionPh: 'Muscat',        postalLabel: 'Postal Code',    postalPh: '100'         },
      'IL': { regionLabel: 'District',       regionPh: 'Tel Aviv',      postalLabel: 'Postal Code',    postalPh: '6100000'     },
      'TR': { regionLabel: 'Province',       regionPh: 'İstanbul',      postalLabel: 'Posta Kodu',     postalPh: '34000'       },
      'EG': { regionLabel: 'Governorate',    regionPh: 'Cairo',         postalLabel: 'Postal Code',    postalPh: '11511'       },
      'MA': { regionLabel: 'Region',         regionPh: 'Casablanca',    postalLabel: 'Code Postal',    postalPh: '20000'       },
      'KE': { regionLabel: 'County',         regionPh: 'Nairobi',       postalLabel: 'Postal Code',    postalPh: '00100'       },
      'GH': { regionLabel: 'Region',         regionPh: 'Greater Accra', postalLabel: null,             postalPh: ''            },
    };
    var ADDR_DEFAULT = { regionLabel: 'State / Region', regionPh: '', postalLabel: 'Postal Code', postalPh: '' };

    function updateAddrLabels() {
      var code = (document.getElementById('biz-modal-country')?.value || 'US');
      var cfg  = ADDR_CONFIG[code] || ADDR_DEFAULT;
      var lblState = document.getElementById('lbl-biz-state');
      var lblZip   = document.getElementById('lbl-biz-zip');
      var fldState = document.getElementById('field-biz-state');
      var fldZip   = document.getElementById('field-biz-zip');
      var inpState = document.getElementById('biz-modal-state');
      var inpZip   = document.getElementById('biz-modal-zip');
      if (cfg.regionLabel) {
        if (fldState) fldState.style.display = '';
        if (lblState) lblState.textContent = cfg.regionLabel;
        if (inpState) inpState.placeholder  = cfg.regionPh;
      } else {
        if (fldState) fldState.style.display = 'none';
        if (inpState) inpState.value = '';
      }
      if (cfg.postalLabel) {
        if (fldZip) fldZip.style.display = '';
        if (lblZip) lblZip.textContent = cfg.postalLabel;
        if (inpZip) inpZip.placeholder  = cfg.postalPh;
      } else {
        if (fldZip) fldZip.style.display = 'none';
        if (inpZip) inpZip.value = '';
      }
    }

    function openBizModal() {
      document.getElementById('biz-modal').style.display = 'flex';
      _loadBizToModal();
    }
    function closeBizModal() {
      document.getElementById('biz-modal').style.display = 'none';
      localStorage.setItem('biz_setup_done', '1');
    }
    function _loadBizToModal() {
      var countrySel = document.getElementById('biz-modal-country');
      if (countrySel) countrySel.value = localStorage.getItem('biz_country') || 'US';
      document.getElementById('biz-modal-name').value   = localStorage.getItem('biz_name')   || '';
      document.getElementById('biz-modal-email').value  = localStorage.getItem('biz_email')  || '';
      document.getElementById('biz-modal-phone').value  = localStorage.getItem('biz_phone')  || '';
      document.getElementById('biz-modal-street').value = localStorage.getItem('biz_street') || '';
      document.getElementById('biz-modal-city').value   = localStorage.getItem('biz_city')   || '';
      document.getElementById('biz-modal-state').value  = localStorage.getItem('biz_state')  || '';
      document.getElementById('biz-modal-zip').value    = localStorage.getItem('biz_zip')    || '';
      const logo = localStorage.getItem('biz_logo');
      const prev = document.getElementById('biz-logo-preview');
      const ph   = document.getElementById('biz-logo-placeholder');
      if (logo) { prev.src = logo; prev.style.display = 'block'; ph.style.display = 'none'; }
      else       { prev.style.display = 'none'; ph.style.display = 'block'; }
      updateAddrLabels();
      updateBizPreview();
    }
    function saveBizProfile() {
      localStorage.setItem('biz_country', document.getElementById('biz-modal-country').value);
      localStorage.setItem('biz_name',    document.getElementById('biz-modal-name').value.trim());
      localStorage.setItem('biz_email',   document.getElementById('biz-modal-email').value.trim());
      localStorage.setItem('biz_phone',   document.getElementById('biz-modal-phone').value.trim());
      localStorage.setItem('biz_street',  document.getElementById('biz-modal-street').value.trim());
      localStorage.setItem('biz_city',    document.getElementById('biz-modal-city').value.trim());
      localStorage.setItem('biz_state',   document.getElementById('biz-modal-state').value.trim());
      localStorage.setItem('biz_zip',     document.getElementById('biz-modal-zip').value.trim());
      localStorage.setItem('biz_setup_done', '1');
      closeBizModal();
      if (typeof fillDocFromBiz === 'function') fillDocFromBiz();
    }
    function updateBizPreview() {
      var name   = (document.getElementById('biz-modal-name')?.value   || '').trim();
      var street = (document.getElementById('biz-modal-street')?.value || '').trim();
      var city   = (document.getElementById('biz-modal-city')?.value   || '').trim();
      var state  = (document.getElementById('biz-modal-state')?.value  || '').trim();
      var zip    = (document.getElementById('biz-modal-zip')?.value    || '').trim();
      var phone  = (document.getElementById('biz-modal-phone')?.value  || '').trim();
      var email  = (document.getElementById('biz-modal-email')?.value  || '').trim();
      var cSel   = document.getElementById('biz-modal-country');
      var countryName = (cSel && cSel.selectedIndex >= 0) ? cSel.options[cSel.selectedIndex].text : '';
      var countryCode = cSel?.value || 'US';
      var elName    = document.getElementById('bp-prev-name');
      var elStreet  = document.getElementById('bp-prev-street');
      var elCity    = document.getElementById('bp-prev-cityline');
      var elCountry = document.getElementById('bp-prev-country');
      var elContact = document.getElementById('bp-prev-contact');
      var elLogo    = document.getElementById('bp-prev-logo');
      if (elName) {
        elName.textContent = name || 'Your Business Name';
        elName.style.color = name ? 'var(--text)' : '#c0c8d4';
      }
      if (elStreet) elStreet.textContent = street;
      if (elCity) {
        var parts = [];
        if (city)  parts.push(city);
        if (state) parts.push(state);
        var line = parts.join(', ');
        if (zip)   line += (line ? ' ' : '') + zip;
        elCity.textContent = line;
      }
      if (elCountry) elCountry.textContent = (countryCode && countryCode !== 'US') ? countryName : '';
      if (elContact) {
        var cp = [];
        if (phone) cp.push(phone);
        if (email) cp.push(email);
        elContact.textContent = cp.join('  ·  ');
      }
      if (elLogo) {
        var logo = localStorage.getItem('biz_logo');
        if (logo) { elLogo.src = logo; elLogo.style.display = 'block'; }
        else { elLogo.style.display = 'none'; }
      }
    }
    document.getElementById('biz-logo-input').addEventListener('change', function() {
      const file = this.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const b64 = e.target.result;
        localStorage.setItem('biz_logo', b64);
        const prev = document.getElementById('biz-logo-preview');
        const ph   = document.getElementById('biz-logo-placeholder');
        prev.src = b64; prev.style.display = 'block'; ph.style.display = 'none';
        updateBizPreview();
      };
      reader.readAsDataURL(file);
    });

    // ── Address Autocomplete (flip on: replace YOUR_MAPBOX_TOKEN with a real token) ──
    // When active, attaches a live dropdown to the street input and fills all four
    // structured fields (street / city / state / zip) on selection.
    var MAPBOX_TOKEN = 'YOUR_MAPBOX_TOKEN';
    function initAutocomplete(streetInput) {
      if (!streetInput || MAPBOX_TOKEN === 'YOUR_MAPBOX_TOKEN') return;
      var prefix = streetInput.id ? streetInput.id.replace('-street', '') : null;
      var _timer = null, _drop = null;
      function removeDrop() { if (_drop) { _drop.remove(); _drop = null; } }
      function fillStructured(feature) {
        if (!prefix) return;
        var placeName = feature.place_name || '';
        // Mapbox context array: [neighborhood, place/city, region/state, postcode, country]
        var ctx = {};
        (feature.context || []).forEach(function(c) {
          var type = c.id.split('.')[0];
          ctx[type] = c.text;
        });
        var streetText = (feature.address ? feature.address + ' ' : '') + (feature.text || '');
        if (document.getElementById(prefix+'-street')) document.getElementById(prefix+'-street').value = streetText;
        if (document.getElementById(prefix+'-city'))   document.getElementById(prefix+'-city').value   = ctx.place || ctx.locality || '';
        if (document.getElementById(prefix+'-state'))  document.getElementById(prefix+'-state').value  = ctx.region || '';
        if (document.getElementById(prefix+'-zip'))    document.getElementById(prefix+'-zip').value    = ctx.postcode || '';
      }
      streetInput.addEventListener('input', function() {
        clearTimeout(_timer);
        var q = streetInput.value.trim();
        if (q.length < 3) { removeDrop(); return; }
        _timer = setTimeout(function() {
          fetch('https://api.mapbox.com/geocoding/v5/mapbox.places/' + encodeURIComponent(q)
            + '.json?access_token=' + MAPBOX_TOKEN + '&autocomplete=true&limit=6&types=address')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              removeDrop();
              if (!data.features || !data.features.length) return;
              _drop = document.createElement('div');
              _drop.className = 'addr-dropdown';
              data.features.forEach(function(f) {
                var label = f.place_name || ''; if (!label) return;
                var item = document.createElement('div');
                item.className = 'addr-item';
                item.textContent = label;
                item.addEventListener('mousedown', function(e) {
                  e.preventDefault(); fillStructured(f); removeDrop();
                });
                _drop.appendChild(item);
              });
              var wrap = streetInput.closest('.addr-wrap') || streetInput.parentElement;
              wrap.style.position = 'relative';
              wrap.appendChild(_drop);
            }).catch(function() {});
        }, 280);
      });
      streetInput.addEventListener('blur', function() { setTimeout(removeDrop, 200); });
    }
  </script>
