---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <!-- Google AdSense — swap ca-pub-XXXXXXXXXXXXXXXX once approved -->
  <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #0f2d52;
      --fox: #d4500a;
      --fox-light: #f0884a;
      --bg: #f5f7fa;
      --card: #ffffff;
      --border: #e1e8ed;
      --text: #1a2332;
      --muted: #6b7c93;
      --radius: 10px;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }
    a { color: var(--fox); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* Nav */
    header {
      background: var(--navy);
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    nav {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      height: 56px;
    }
    .logo {
      font-size: 1.2rem;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
    }
    .logo-icon { margin-right: 0.35rem; }
    .logo span { color: var(--fox-light); }
    .logo:hover { text-decoration: none; }
    nav ul {
      display: flex;
      list-style: none;
      gap: 0.15rem;
      flex-wrap: wrap;
    }
    nav ul a {
      color: rgba(255,255,255,0.8);
      font-size: 0.82rem;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      transition: background 0.15s;
      white-space: nowrap;
    }
    nav ul a:hover { background: rgba(255,255,255,0.1); color: #fff; text-decoration: none; }
    nav ul a.active { color: var(--fox-light); font-weight: 600; }
    .nav-divider { width: 1px; height: 18px; background: rgba(255,255,255,0.2); margin: 0 0.15rem; align-self: center; flex-shrink: 0; }
    .nav-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }
    .currency-select {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.85);
      font-size: 0.82rem;
      padding: 0.25rem 0.5rem;
      border-radius: 5px;
      cursor: pointer;
    }
    .currency-select:focus { outline: none; border-color: var(--fox-light); }
    .currency-select option { background: var(--navy); color: #fff; }
    .biz-nav-btn {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.85);
      font-size: 0.78rem;
      padding: 0.28rem 0.65rem;
      border-radius: 5px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.15s;
    }
    .biz-nav-btn:hover { background: rgba(255,255,255,0.22); color: #fff; }

    /* Layout */
    .page-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }
    main { min-width: 0; }

    /* Card */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem;
      margin-bottom: 1.5rem;
    }
    .card h1 { font-size: 1.6rem; color: var(--navy); margin-bottom: 0.5rem; }
    .card h2 { font-size: 1.15rem; color: var(--navy); margin-bottom: 1rem; }
    .card p { color: var(--muted); margin-bottom: 1rem; }

    /* Calculator form — :global so slot content in pages inherits these */
    :global(.calc-form) { display: flex; flex-direction: column; gap: 1rem; }
    :global(.field label) {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 0.4rem;
    }
    :global(.field input), :global(.field select), :global(.field textarea) {
      width: 100%;
      padding: 0.6rem 0.85rem;
      border: 1.5px solid var(--border);
      border-radius: 7px;
      font-size: 1rem;
      color: var(--text);
      background: #fff;
      transition: border-color 0.15s;
      font-family: inherit;
    }
    :global(.field input:focus), :global(.field select:focus), :global(.field textarea:focus) {
      outline: none;
      border-color: var(--fox);
    }
    :global(.field-row) { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 480px) { :global(.field-row) { grid-template-columns: 1fr; } }
    .btn {
      background: var(--fox);
      color: #fff;
      border: none;
      padding: 0.75rem 1.5rem;
      border-radius: 7px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      align-self: flex-start;
    }
    .btn:hover { background: var(--fox-light); }
    .btn-outline {
      background: transparent;
      color: var(--fox);
      border: 1.5px solid var(--fox);
    }
    .btn-outline:hover { background: var(--fox); color: #fff; }
    .btn-green {
      background: #059669;
    }
    .btn-green:hover { background: #047857; }

    /* Results */
    .results {
      display: none;
      margin-top: 1.25rem;
      padding: 1.25rem;
      background: #f0f7ff;
      border: 1.5px solid #c3daf9;
      border-radius: var(--radius);
    }
    .results.show { display: block; }
    .results-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1rem;
      margin-top: 0.75rem;
    }
    .result-item { text-align: center; }
    .result-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--navy);
      display: block;
    }
    .result-label {
      font-size: 0.78rem;
      color: var(--muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .result-highlight .result-value { color: var(--fox); }

    /* Ad slots */
    .ad-slot {
      background: var(--card);
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
    }
    .ad-slot-banner { height: 90px; }
    .ad-slot-sidebar { height: 250px; margin-bottom: 1rem; }
    .ad-slot-sidebar-tall { height: 600px; }

    /* Sidebar */
    .sidebar { position: sticky; top: 72px; }
    .sidebar-links { list-style: none; }
    .sidebar-links li { border-bottom: 1px solid var(--border); }
    .sidebar-links a {
      display: block;
      padding: 0.65rem 0.5rem;
      font-size: 0.9rem;
      color: var(--text);
    }
    .sidebar-links a:hover { color: var(--fox); text-decoration: none; }

    /* FAQ */
    details {
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 0;
    }
    details summary {
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--navy);
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    details summary::after { content: '+'; font-size: 1.2rem; color: var(--fox); }
    details[open] summary::after { content: '−'; }
    details p { margin-top: 0.6rem; font-size: 0.9rem; color: var(--muted); }

    /* Document section labels */
    .section-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--fox);
      padding-bottom: 0.25rem;
      border-bottom: 1px solid var(--border);
    }

    /* Address fields — structured layout */
    :global(.addr-grid) { display: grid; grid-template-columns: 1fr 80px 110px; gap: 0.75rem; }
    @media (max-width: 520px) { :global(.addr-grid) { grid-template-columns: 1fr 1fr; } }

    /* Address autocomplete dropdown (activated when live token is set) */
    .addr-wrap { position: relative; }
    .addr-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border: 1.5px solid var(--border);
      border-top: none;
      border-radius: 0 0 7px 7px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.1);
      z-index: 200;
      max-height: 200px;
      overflow-y: auto;
    }
    .addr-item {
      padding: 0.6rem 0.85rem;
      font-size: 0.88rem;
      color: var(--text);
      cursor: pointer;
      border-bottom: 1px solid #f0f4f8;
    }
    .addr-item:last-child { border-bottom: none; }
    .addr-item:hover { background: #f0f7ff; color: var(--navy); }

    /* Business Profile Modal */
    .biz-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 45, 82, 0.72);
      z-index: 1000;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 3vh 1rem;
      backdrop-filter: blur(3px);
      overflow-y: auto;
    }
    .biz-modal {
      background: #fff;
      border-radius: 14px;
      padding: 1.75rem 2rem;
      width: 100%;
      max-width: 900px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.22);
      position: relative;
    }
    .biz-modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1.25rem;
    }
    .biz-modal-header h3 { font-size: 1.2rem; color: var(--navy); margin-bottom: 0.2rem; }
    .biz-modal-header p { font-size: 0.83rem; color: var(--muted); margin: 0; }
    .biz-modal-close {
      background: none;
      border: none;
      font-size: 1.4rem;
      color: var(--muted);
      cursor: pointer;
      line-height: 1;
      padding: 0 0 0 0.75rem;
      flex-shrink: 0;
    }
    .biz-modal-close:hover { color: var(--text); }
    .biz-modal-cols {
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 1.75rem;
      align-items: start;
    }
    @media (max-width: 680px) {
      .biz-modal-cols { grid-template-columns: 1fr; }
      .biz-paper-col { display: none; }
    }
    .biz-form-col { display: flex; flex-direction: column; }
    .biz-paper-col { display: flex; flex-direction: column; gap: 0.5rem; }
    .biz-paper-hint {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--muted);
      text-align: center;
    }
    .biz-paper {
      background: #fff;
      border: 1px solid #d0d7e2;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08), 0 10px 32px rgba(0,0,0,0.10);
      width: 100%;
      aspect-ratio: 8.5 / 11;
      padding: 7% 8%;
      position: relative;
      overflow: hidden;
      border-radius: 2px;
      font-size: 9px;
    }
    .bp-doc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 5%; }
    .bp-logo-img { max-height: 3.4em; max-width: 10em; object-fit: contain; display: block; }
    .bp-doc-type { font-size: 2.2em; font-weight: 800; color: var(--navy); letter-spacing: -0.01em; line-height: 1; }
    .bp-biz-name { font-size: 1.25em; font-weight: 700; color: var(--text); margin-bottom: 0.4em; line-height: 1.3; transition: color 0.15s; }
    .bp-biz-addr { font-size: 1em; color: var(--muted); line-height: 1.6; min-height: 1.2em; }
    .bp-biz-contact { font-size: 0.95em; color: var(--muted); margin-top: 0.4em; }
    .bp-divider { border: none; border-top: 1.5px solid var(--navy); margin: 4% 0 3%; }
    .bp-ghost-section { margin-bottom: 4%; }
    .bp-ghost-label { font-size: 0.8em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fox); margin-bottom: 1.8%; }
    .bp-ghost-line { height: 0.88em; background: #e4e9f0; border-radius: 3px; margin-bottom: 1.4%; }
    .bp-ghost-table { margin-bottom: 3%; }
    .bp-ghost-thead { height: 1.6em; background: var(--navy); border-radius: 2px; margin-bottom: 1.5%; opacity: 0.85; }
    .bp-ghost-row { height: 1.1em; background: #e4e9f0; border-radius: 2px; margin-bottom: 1.2%; }
    .bp-ghost-totals { margin-left: 55%; margin-bottom: 2%; }
    .bp-ghost-total-row { height: 0.9em; background: #e4e9f0; border-radius: 2px; margin-bottom: 1.5%; }
    .bp-ghost-total-grand { height: 1.35em; background: var(--navy); border-radius: 2px; opacity: 0.75; }
    .bp-fade { position: absolute; bottom: 0; left: 0; right: 0; height: 28%; background: linear-gradient(to bottom, transparent 0%, #fff 90%); pointer-events: none; }
    .biz-logo-upload {
      border: 2px dashed var(--border);
      border-radius: 8px;
      padding: 0.85rem;
      text-align: center;
      cursor: pointer;
      margin-bottom: 0.75rem;
      transition: border-color 0.15s, background 0.15s;
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 0.35rem;
    }
    .biz-logo-upload:hover { border-color: var(--fox); background: #fff8f5; }
    .biz-logo-upload span { font-size: 0.82rem; color: var(--muted); }
    .biz-logo-upload img { max-height: 48px; max-width: 160px; object-fit: contain; }
    .biz-modal-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
    .btn-skip {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 0.85rem;
      cursor: pointer;
      padding: 0.4rem 0;
    }
    .btn-skip:hover { color: var(--text); }
    .biz-profile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 0.85rem;
      background: #f0f7ff;
      border: 1px solid #c3daf9;
      border-radius: 7px;
      margin-bottom: 1.25rem;
      font-size: 0.83rem;
      color: var(--navy);
    }
    .biz-profile-bar button {
      background: none;
      border: none;
      color: var(--fox);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      padding: 0;
    }
    .biz-profile-bar button:hover { text-decoration: underline; }

    /* Line items (document generators) */
    .line-item-row {
      display: grid;
      grid-template-columns: 1fr 80px 110px 90px 28px;
      gap: 0.5rem;
      align-items: end;
      margin-bottom: 0.5rem;
    }
    @media (max-width: 520px) {
      .line-item-row { grid-template-columns: 1fr 1fr; }
      .li-total, .li-remove { grid-column: span 2; }
    }
    .li-total-val {
      display: block;
      padding: 0.6rem 0.75rem;
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: 7px;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--navy);
    }
    .li-remove-btn {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 1.1rem;
      cursor: pointer;
      padding: 0.5rem 0.3rem;
      line-height: 1;
      align-self: center;
    }
    .li-remove-btn:hover { color: #dc2626; }

    /* Document preview shared styles */
    .doc-preview { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 0.9rem; color: #1a2332; }
    .doc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
    .doc-title { font-size: 2rem; font-weight: 800; color: var(--navy); letter-spacing: -0.02em; }
    .doc-meta { text-align: right; }
    .doc-meta p { margin: 0.1rem 0; font-size: 0.85rem; color: var(--muted); }
    .doc-meta strong { color: var(--text); }
    .doc-parties { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem; }
    .doc-parties h3 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fox); margin-bottom: 0.4rem; }
    .doc-parties p { margin: 0; font-size: 0.88rem; line-height: 1.6; color: var(--muted); }
    .doc-parties .party-name { font-size: 1rem; font-weight: 600; color: var(--text); }
    .doc-table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
    .doc-table th { background: var(--navy); color: #fff; padding: 0.5rem 0.75rem; text-align: left; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .doc-table th:last-child, .doc-table td:last-child { text-align: right; }
    .doc-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); font-size: 0.88rem; color: var(--muted); }
    .doc-totals { margin-left: auto; width: 260px; }
    .doc-total-row { display: flex; justify-content: space-between; padding: 0.35rem 0; font-size: 0.9rem; color: var(--muted); }
    .doc-total-row.grand { font-size: 1.1rem; font-weight: 700; color: var(--navy); border-top: 2px solid var(--navy); padding-top: 0.5rem; margin-top: 0.25rem; }
    .doc-total-row.balance-zero { color: #059669; font-weight: 600; }
    .doc-total-row.balance-owing { color: #dc2626; font-weight: 600; }
    .doc-notes { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.82rem; color: var(--muted); }
    .doc-notes strong { display: block; margin-bottom: 0.25rem; color: var(--text); }
    .doc-logo { max-height: 64px; max-width: 200px; object-fit: contain; margin-bottom: 0.5rem; display: block; }
    .doc-stamp {
      display: inline-block;
      border: 3px solid #059669;
      border-radius: 5px;
      color: #059669;
      font-size: 1.6rem;
      font-weight: 900;
      letter-spacing: 0.12em;
      padding: 0.2rem 0.9rem;
      transform: rotate(-4deg);
      opacity: 0.88;
      margin-top: 0.75rem;
    }
    .doc-stamp.partial { border-color: #d97706; color: #d97706; }
    .doc-acceptance {
      margin-top: 2rem;
      padding: 1.25rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fafafa;
    }
    .doc-acceptance h4 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fox); margin-bottom: 0.85rem; }
    .doc-sig-line { display: flex; gap: 2rem; margin-top: 1.5rem; flex-wrap: wrap; }
    .doc-sig-field { flex: 1; min-width: 120px; border-top: 1px solid var(--text); padding-top: 0.35rem; font-size: 0.78rem; color: var(--muted); }

    /* ── Document Workspace (invoice, receipt, quote, PO) — :global so slot content matches ── */
    :global(.inv-workspace) {
      display: grid;
      grid-template-columns: 420px 1fr;
      gap: 1.75rem;
      align-items: start;
    }
    :global(.inv-form-col) { display: flex; flex-direction: column; gap: 0.85rem; }
    :global(.inv-paper-col) { position: sticky; top: 72px; display: flex; flex-direction: column; gap: 0.65rem; }

    /* Form cards — match modal design language */
    :global(.ws-card) {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem 1.5rem 1.25rem;
    }
    :global(.ws-card-label) {
      font-size: 0.67rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--fox);
      padding-bottom: 0.7rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1rem;
    }

    /* Compact inputs inside ws-card — smaller than modal, fits the narrower column */
    :global(.ws-card .field label) {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 0.28rem;
    }
    :global(.ws-card .field input),
    :global(.ws-card .field select) {
      padding: 0.45rem 0.7rem;
      font-size: 0.9rem;
      border-radius: 6px;
    }
    :global(.ws-card .calc-form) { gap: 0.7rem; }
    /* Hide number spinners on inputs inside ws-card */
    :global(.ws-card .field input[type="number"]) { -moz-appearance: textfield; }
    :global(.ws-card .field input[type="number"]::-webkit-inner-spin-button),
    :global(.ws-card .field input[type="number"]::-webkit-outer-spin-button) { -webkit-appearance: none; margin: 0; }

    /* My Business bar */
    :global(.inv-biz-bar) { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
    :global(.inv-biz-bar-left) { display: flex; align-items: center; gap: 0.65rem; min-width: 0; }
    :global(.inv-biz-logo-thumb) {
      width: 38px;
      height: 38px;
      object-fit: contain;
      border-radius: 6px;
      border: 1px solid var(--border);
      flex-shrink: 0;
    }
    :global(.inv-biz-text) { min-width: 0; }
    :global(.inv-biz-name) { font-size: 0.9rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    :global(.inv-biz-meta) { font-size: 0.75rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.1rem; }
    :global(.ws-edit-btn) {
      background: none;
      border: 1.5px solid var(--border);
      color: var(--fox);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      padding: 0.35rem 0.85rem;
      border-radius: 7px;
      white-space: nowrap;
      flex-shrink: 0;
      transition: border-color 0.15s, background 0.15s;
    }
    :global(.ws-edit-btn:hover) { border-color: var(--fox); background: #fff8f5; }

    /* Line item rows — no nested card, just clean dividers */
    :global(.li-card) {
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    :global(.li-card:first-child) { padding-top: 0; }
    :global(.li-card:last-child) { border-bottom: none; padding-bottom: 0.25rem; }
    :global(.li-card .field label) {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--navy);
      margin-bottom: 0.3rem;
    }
    :global(.li-card .field input) {
      padding: 0.55rem 0.7rem;
      font-size: 0.93rem;
      border: 1.5px solid var(--border);
      border-radius: 7px;
      background: #fff;
      color: var(--text);
      font-family: inherit;
      width: 100%;
      transition: border-color 0.15s;
    }
    :global(.li-card .field input:focus) { outline: none; border-color: var(--fox); }
    :global(.li-bottom-row) {
      display: grid;
      grid-template-columns: 68px 1fr 80px 24px;
      gap: 0.5rem;
      align-items: end;
    }
    :global(.li-field-sm label), :global(.li-field-md label) {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--navy);
      display: block;
      margin-bottom: 0.3rem;
    }
    :global(.li-total-block) {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      justify-content: flex-end;
      padding-bottom: 0.45rem;
    }
    :global(.li-total-label) {
      font-size: 0.65rem;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.2rem;
    }
    :global(.li-total-val) { font-size: 0.95rem; font-weight: 700; color: var(--navy); white-space: nowrap; }
    :global(.li-remove-placeholder) { width: 24px; }
    :global(.li-remove-btn) {
      background: none;
      border: none;
      color: #c8d0db;
      font-size: 1.2rem;
      cursor: pointer;
      padding: 0 0 0.45rem;
      line-height: 1;
      align-self: end;
      transition: color 0.15s;
    }
    :global(.li-remove-btn:hover) { color: #dc2626; }
    :global(.ws-add-line-btn) {
      background: none;
      border: 1.5px dashed var(--border);
      color: var(--fox);
      font-size: 0.83rem;
      font-weight: 600;
      cursor: pointer;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      width: 100%;
      margin-top: 0.2rem;
      transition: border-color 0.15s, background 0.15s;
    }
    :global(.ws-add-line-btn:hover) { border-color: var(--fox); background: #fff8f5; }

    /* Notes textarea inside ws-card */
    :global(.ws-card .field textarea) {
      width: 100%;
      padding: 0.7rem 0.85rem;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-size: 0.9rem;
      resize: vertical;
      font-family: inherit;
      color: var(--text);
      background: #fff;
      transition: border-color 0.15s;
      line-height: 1.5;
    }
    :global(.ws-card .field textarea:focus) { outline: none; border-color: var(--fox); }

    /* Paper preview */
    :global(.inv-paper-actions) { display: flex; justify-content: space-between; align-items: center; }
    :global(.inv-paper-label) { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
    :global(.inv-paper) {
      background: #fff;
      border: 1px solid #d0d7e2;
      box-shadow: 0 2px 8px rgba(0,0,0,0.07), 0 12px 40px rgba(0,0,0,0.10);
      border-radius: 2px;
      aspect-ratio: 8.5 / 11;
      padding: 8.5% 9%;
      font-size: 13px;
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.55;
      overflow: visible;
    }
    @media (max-width: 900px) {
      :global(.inv-workspace) { grid-template-columns: 1fr; }
      :global(.inv-paper-col) { position: static; order: -1; }
      :global(.inv-paper) { aspect-ratio: unset; min-height: 520px; }
    }
    @media print {
      :global(.inv-form-col), :global(.inv-paper-actions) { display: none !important; }
      :global(.inv-workspace) { display: block !important; }
      :global(.inv-paper-col) { position: static !important; }
      :global(.inv-paper) { box-shadow: none !important; border: none !important; padding: 0 !important; font-size: 11pt !important; aspect-ratio: unset !important; }
    }

    /* Footer */
    footer {
      background: var(--navy);
      color: rgba(255,255,255,0.6);
      text-align: center;
      padding: 1.5rem;
      font-size: 0.82rem;
      margin-top: 2rem;
    }
    footer a { color: rgba(255,255,255,0.7); }
    footer .footer-links { display: flex; justify-content: center; gap: 1.5rem; margin-bottom: 0.75rem; flex-wrap: wrap; }

    @media print {
      header, footer, .ad-slot, .doc-builder, #ad-below, .card:has(.embed-code-block),
      .biz-overlay, .print-hide { display: none !important; }
      .doc-preview-card { display: block !important; border: none !important; box-shadow: none !important; }
      .page-wrap { padding: 0; }
    }
  </style>
</head>
