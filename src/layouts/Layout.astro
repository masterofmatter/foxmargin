---
import BusinessProfileModal from '../components/BusinessProfileModal.astro';
import '../styles/layout.css';
import '../styles/document-workspace.css';
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: string;
}
const { title, description, canonical, schema } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/foxmargin-logo.png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="FoxMargin" />
  <meta property="og:image" content="https://foxmargin.com/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://foxmargin.com/og-image.png" />
  {schema && <Fragment set:html={`<script type="application/ld+json">${schema}</script>`} />}
  <!-- Plausible Analytics -->
  <script defer data-domain="foxmargin.com" src="https://plausible.io/js/script.js"></script>
  <!-- Google AdSense — swap ca-pub-XXXXXXXXXXXXXXXX once approved -->
  <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script> -->
  <!-- Layout-wide styles are imported from src/styles/layout.css (see frontmatter) -->
</head>
<body>
  <header>
    <nav>
      <a href="/" class="logo"><img class="logo-icon" src="/foxmargin-logo.png" alt="FoxMargin" width="24" height="24" />Fox<span>Margin</span></a>
      <ul>
        <li><a href="/invoice-generator/">Invoice</a></li>
        <li><a href="/receipt-generator/">Receipt</a></li>
        <li><a href="/quote-generator/">Quote</a></li>
        <li><a href="/purchase-order/">Purchase Order</a></li>
        <li class="nav-divider" style="list-style:none;width:1px;height:18px;background:rgba(255,255,255,0.2);margin:0 0.2rem;"></li>
        <li class="nav-dd-item">
          <details class="nav-dropdown">
            <summary>Calculators</summary>
            <div class="nav-dropdown-panel">
              <a href="/profit-margin-calculator/">Profit Margin</a>
              <a href="/break-even-calculator/">Break-Even</a>
              <a href="/markup-calculator/">Markup</a>
              <a href="/vat-calculator/">VAT / GST</a>
              <a href="/hourly-rate-calculator/">Hourly Rate</a>
            </div>
          </details>
        </li>
        <li class="nav-divider" style="list-style:none;width:1px;height:18px;background:rgba(255,255,255,0.2);margin:0 0.2rem;"></li>
        <li><a href="/blog/" style="color:rgba(255,255,255,0.75);font-size:0.88rem;">Guides</a></li>
      </ul>
      <div class="nav-right">
        <button class="biz-nav-btn" onclick="openBizModal()">👤 My Business</button>
        <button class="nav-hamburger" id="nav-toggle" aria-label="Menu">&#9776;</button>
      </div>
    </nav>
  </header>

  <div class="page-wrap">
    <main>
      <slot />
    </main>
  </div>

  <BusinessProfileModal />

  <script is:inline>
    window.__CURRENCIES = [
      { code: 'USD', locale: 'en-US', symbol: '$'  },
      { code: 'GBP', locale: 'en-GB', symbol: '£'  },
      { code: 'EUR', locale: 'de-DE', symbol: '€'  },
      { code: 'AUD', locale: 'en-AU', symbol: 'A$' },
      { code: 'CAD', locale: 'en-CA', symbol: 'C$' },
      { code: 'INR', locale: 'en-IN', symbol: '₹'  },
    ];
    function setCurrency(code) {
      localStorage.setItem('preferred_currency', code);
      window.__currency = window.__CURRENCIES.find(c => c.code === code) || window.__CURRENCIES[0];
      document.dispatchEvent(new Event('currencychange'));
    }
    (function initCurrency() {
      const saved = localStorage.getItem('preferred_currency') || 'USD';
      window.__currency = window.__CURRENCIES.find(c => c.code === saved) || window.__CURRENCIES[0];
      const sel = document.getElementById('currency-select');
      if (sel) sel.value = window.__currency.code;
    })();

    // Mobile nav toggle
    (function() {
      var toggle = document.getElementById('nav-toggle');
      var navList = document.querySelector('nav ul');
      if (toggle && navList) {
        toggle.addEventListener('click', function(e) {
          e.stopPropagation();
          navList.classList.toggle('nav-open');
        });
        navList.querySelectorAll('a').forEach(function(a) {
          a.addEventListener('click', function() { navList.classList.remove('nav-open'); });
        });
      }
    })();

    // Close nav dropdowns when clicking outside
    document.addEventListener('click', function(e) {
      document.querySelectorAll('.nav-dropdown[open]').forEach(function(d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
      // Also close mobile nav when clicking outside header
      if (!e.target.closest('header')) {
        document.querySelector('nav ul')?.classList.remove('nav-open');
      }
    });

    // ── FoxMargin global utilities ──
    window.isPro = function() { return localStorage.getItem('fm_pro') === '1'; };
    window.setPro = function(v) { localStorage.setItem('fm_pro', v ? '1' : ''); };
    // track(event, props) — fires Plausible if loaded, GA4 gtag if loaded, otherwise no-op.
    // Wire up analytics by adding the Plausible <script> tag or gtag.js to <head>.
    window.track = function(event, props) {
      if (typeof window.plausible === 'function') window.plausible(event, { props: props || {} });
      else if (typeof window.gtag === 'function') window.gtag('event', event, props || {});
    };

    // ── Email a document — two paths: Web Share (mobile) or Print + mailto (desktop) ──
    // opts: { kind: 'Invoice'|'Receipt'|'Quote'|'Purchase Order',
    //         numberId: 'inv-number'|'rec-number'|'qte-number'|'po-number',
    //         eventName: 'email_invoice' (optional, for analytics) }
    //
    // Why two paths? mailto: URLs cannot carry attachments (RFC 6068 — no mail
    // client honors it), so we can't just open a mail draft with a PDF inside.
    // Workarounds:
    //   - Path C (mobile / iOS Safari / Android Chrome): navigator.share({files})
    //     lets the OS share sheet attach an image directly to whichever app the
    //     user picks (Mail / Messages / WhatsApp). We render the preview to a
    //     high-DPI PNG via html2canvas, loaded on demand from cdnjs.
    //   - Path A (everything else): trigger window.print() so the user saves the
    //     PDF via the browser's print engine (high fidelity, all styling intact),
    //     then open mailto with subject + short body. User drags the saved PDF
    //     onto the draft. Same two-step workflow Stripe / Wave / FreshBooks use.
    window.emailDoc = function(opts) {
      opts = opts || {};
      var toEmail = (document.getElementById('to-email') && document.getElementById('to-email').value || '').trim();
      var toName  = (document.getElementById('to-name')  && document.getElementById('to-name').value  || '').trim() || 'there';
      var docNum  = (document.getElementById(opts.numberId) && document.getElementById(opts.numberId).value || '').trim();
      var bizName = (localStorage.getItem('biz_name') || '').trim();
      var kind    = opts.kind || 'Document';

      var subject  = kind + (docNum ? ' ' + docNum : '') + (bizName ? ' from ' + bizName : '');
      var bodyText =
        'Hi ' + toName + ',\n\n' +
        'Please find ' + kind.toLowerCase() + (docNum ? ' ' + docNum : '') + ' attached.\n\n' +
        'Let me know if you have any questions.\n\n' +
        'Thanks,\n' + (bizName || '');

      if (opts.eventName && typeof window.track === 'function') window.track(opts.eventName);

      var safe = (docNum || kind).replace(/[^a-zA-Z0-9_-]/g, '_');

      // Path C feature-detect — needs File constructor + canShare({files}) returning true.
      var canShareFile = false;
      try {
        canShareFile = !!(navigator.canShare && navigator.canShare({
          files: [new File(['probe'], 'probe.png', { type: 'image/png' })]
        }));
      } catch (e) { canShareFile = false; }

      if (canShareFile) {
        shareViaImage().catch(function(err) {
          // User-cancelled share sheet → don't barge into the print dialog.
          if (err && err.name === 'AbortError') return;
          openMailAfterPrint();
        });
        return;
      }

      openMailAfterPrint();

      function openMailAfterPrint() {
        try { window.print(); } catch (e) {}
        // The print dialog blocks on most browsers; once it closes the timeout
        // resolves and the mail client opens. 300ms gives Safari/Firefox time
        // to finish their async print teardown before the navigation.
        setTimeout(function() {
          var body = encodeURIComponent(
            bodyText + '\n\n[Attach the PDF you just saved to this email before sending.]'
          );
          window.location.href = 'mailto:' + (toEmail ? encodeURIComponent(toEmail) : '')
            + '?subject=' + encodeURIComponent(subject)
            + '&body=' + body;
        }, 300);
      }

      function shareViaImage() {
        return loadHtml2Canvas().then(function(h2c) {
          var paper = document.getElementById('doc-paper') || document.getElementById('invoice-paper');
          if (!paper) throw new Error('preview element missing');
          return h2c(paper, { backgroundColor: '#ffffff', scale: 2, useCORS: true });
        }).then(function(canvas) {
          return new Promise(function(resolve, reject) {
            canvas.toBlob(function(blob) {
              if (!blob) return reject(new Error('blob conversion failed'));
              var file = new File([blob], safe + '.png', { type: 'image/png' });
              if (!navigator.canShare({ files: [file] })) {
                return reject(new Error('cannot share file'));
              }
              navigator.share({ title: subject, text: bodyText, files: [file] })
                .then(resolve, reject);
            }, 'image/png');
          });
        });
      }
    };

    // html2canvas loaded on demand from cdnjs the first time mobile share fires.
    // No SRI hash — this is a no-PII static site and the cdnjs HTTPS endpoint is
    // the same source pattern used for JSZip elsewhere in the codebase.
    function loadHtml2Canvas() {
      if (window.html2canvas) return Promise.resolve(window.html2canvas);
      return new Promise(function(resolve, reject) {
        var s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
        s.crossOrigin = 'anonymous';
        s.referrerPolicy = 'no-referrer';
        s.onload  = function() { resolve(window.html2canvas); };
        s.onerror = function() { reject(new Error('Failed to load html2canvas')); };
        document.head.appendChild(s);
      });
    }

    // ── Saved recipients (clients/customers/vendors) — free: 1 slot, Pro: unlimited ──
    window.fmClients = {
      KEY: 'fm_clients',
      list: function () {
        try { return JSON.parse(localStorage.getItem(this.KEY) || '[]'); }
        catch (e) { return []; }
      },
      readForm: function () {
        var g = function (id) { var el = document.getElementById(id); return (el && el.value || '').trim(); };
        var name = g('to-name'); if (!name) return null;
        return {
          name: name, email: g('to-email'), country: g('to-country'),
          street: g('to-street'), city: g('to-city'),
          state: g('to-state'), zip: g('to-zip'),
          savedAt: Date.now()
        };
      },
      saveCurrent: function () {
        var c = this.readForm(); if (!c) return { ok: false, reason: 'noname' };
        var arr = this.list();
        arr = arr.filter(function (x) { return (x.name || '').toLowerCase() !== c.name.toLowerCase(); });
        if (!window.isPro() && arr.length >= 1) {
          if (typeof window.track === 'function') window.track('upgrade_prompt_shown', { feature: 'saved_clients' });
          return { ok: false, reason: 'limit' };
        }
        arr.unshift(c);
        localStorage.setItem(this.KEY, JSON.stringify(arr));
        if (typeof window.track === 'function') window.track('client_saved');
        return { ok: true };
      },
      apply: function (idx) {
        var c = this.list()[idx]; if (!c) return;
        var set = function (id, v) { var el = document.getElementById(id); if (el) { el.value = v || ''; el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); } };
        set('to-name', c.name); set('to-email', c.email); set('to-country', c.country);
        set('to-street', c.street); set('to-city', c.city); set('to-state', c.state); set('to-zip', c.zip);
      }
    };

    // UI wiring for the "Save / Recent" recipient widget (one shared instance per page).
    window.refreshClientPicker = function () {
      var s = document.getElementById('client-picker'); if (!s) return;
      var arr = window.fmClients.list();
      s.innerHTML = '<option value="">Recent…</option>' +
        arr.map(function (c, i) { return '<option value="' + i + '">' + (c.name || '').replace(/</g, '&lt;') + '</option>'; }).join('');
    };
    window.loadRecipient = function (i) { if (i === '') return; window.fmClients.apply(parseInt(i, 10)); };
    window.saveRecipient = function () {
      var r = window.fmClients.saveCurrent();
      var m = document.getElementById('client-msg'); if (!m) return;
      if (r.ok) { m.textContent = '✓ Saved'; m.style.color = '#16a34a'; window.refreshClientPicker(); }
      else if (r.reason === 'noname') { m.textContent = 'Enter a name first'; m.style.color = '#dc2626'; }
      else if (r.reason === 'limit') { m.innerHTML = 'Free: 1 saved. <a href="/pro" style="color:var(--fox);">Upgrade →</a>'; m.style.color = 'var(--text)'; }
      setTimeout(function () { if (r.ok) m.textContent = ''; }, 4000);
    };
    document.addEventListener('DOMContentLoaded', function () { window.refreshClientPicker(); });

    // ── Address Autocomplete (flip on: replace YOUR_MAPBOX_TOKEN with a real token) ──
    // When active, attaches a live dropdown to the street input and fills all four
    // structured fields (street / city / state / zip) on selection.
    var MAPBOX_TOKEN = 'YOUR_MAPBOX_TOKEN';
    function initAutocomplete(streetInput) {
      if (!streetInput || MAPBOX_TOKEN === 'YOUR_MAPBOX_TOKEN') return;
      var prefix = streetInput.id ? streetInput.id.replace('-street', '') : null;
      var _timer = null, _drop = null;
      function removeDrop() { if (_drop) { _drop.remove(); _drop = null; } }
      function fillStructured(feature) {
        if (!prefix) return;
        var placeName = feature.place_name || '';
        // Mapbox context array: [neighborhood, place/city, region/state, postcode, country]
        var ctx = {};
        (feature.context || []).forEach(function(c) {
          var type = c.id.split('.')[0];
          ctx[type] = c.text;
        });
        var streetText = (feature.address ? feature.address + ' ' : '') + (feature.text || '');
        if (document.getElementById(prefix+'-street')) document.getElementById(prefix+'-street').value = streetText;
        if (document.getElementById(prefix+'-city'))   document.getElementById(prefix+'-city').value   = ctx.place || ctx.locality || '';
        if (document.getElementById(prefix+'-state'))  document.getElementById(prefix+'-state').value  = ctx.region || '';
        if (document.getElementById(prefix+'-zip'))    document.getElementById(prefix+'-zip').value    = ctx.postcode || '';
      }
      streetInput.addEventListener('input', function() {
        clearTimeout(_timer);
        var q = streetInput.value.trim();
        if (q.length < 3) { removeDrop(); return; }
        _timer = setTimeout(function() {
          fetch('https://api.mapbox.com/geocoding/v5/mapbox.places/' + encodeURIComponent(q)
            + '.json?access_token=' + MAPBOX_TOKEN + '&autocomplete=true&limit=6&types=address')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              removeDrop();
              if (!data.features || !data.features.length) return;
              _drop = document.createElement('div');
              _drop.className = 'addr-dropdown';
              data.features.forEach(function(f) {
                var label = f.place_name || ''; if (!label) return;
                var item = document.createElement('div');
                item.className = 'addr-item';
                item.textContent = label;
                item.addEventListener('mousedown', function(e) {
                  e.preventDefault(); fillStructured(f); removeDrop();
                });
                _drop.appendChild(item);
              });
              var wrap = streetInput.closest('.addr-wrap') || streetInput.parentElement;
              wrap.style.position = 'relative';
              wrap.appendChild(_drop);
            }).catch(function() {});
        }, 280);
      });
      streetInput.addEventListener('blur', function() { setTimeout(removeDrop, 200); });
    }
  </script>
  <footer>
    <div class="footer-email-bar">
      <p>New tools and updates — no spam.</p>
      <form class="footer-email-form"
        action="https://buttondown.com/api/emails/embed-subscribe/foxmargin"
        method="POST"
        target="_blank"
        onsubmit="track('email_signup')">
        <input type="email" name="email" placeholder="your@email.com" required />
        <button type="submit">Notify me</button>
      </form>
    </div>
    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/invoice-generator/">Invoice</a>
      <a href="/receipt-generator/">Receipt</a>
      <a href="/quote-generator/">Quote</a>
      <a href="/purchase-order/">Purchase Order</a>
      <a href="/profit-margin-calculator/">Profit Margin</a>
      <a href="/break-even-calculator/">Break-Even</a>
      <a href="/markup-calculator/">Markup</a>
    </div>
    <p>© {new Date().getFullYear()} FoxMargin.com — Free Business Tools</p>
    <p style="margin-top:0.5rem;font-size:0.82rem;">Feedback? <a href="mailto:foxmargin@protonmail.com">foxmargin@protonmail.com</a></p>
    <p style="margin-top:0.4rem;font-size:0.75rem;">Results are for informational purposes only. Always verify with a qualified accountant.</p>
  </footer>
</body>
</html>
