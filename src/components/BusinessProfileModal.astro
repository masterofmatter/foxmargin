          </div>
        </div>
        <div class="biz-modal-actions">
          <button type="button" class="btn" onclick="saveBizProfile()">Save Profile</button>
          <div class="biz-actions-secondary">
            <button type="button" class="action-btn has-tooltip" data-tooltip="Download a JSON backup of your profile, logo, and saved clients" onclick="exportBizSettings()">Export backup</button>
            <button type="button" class="action-btn has-tooltip" data-tooltip="Restore settings from a backup file" onclick="document.getElementById('biz-import-input').click()">Restore</button>
