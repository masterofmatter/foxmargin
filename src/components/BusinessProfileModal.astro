---
import { ADDR_CONFIG, ADDR_DEFAULT } from '../data/address-config';
/**
 * Business Profile Modal — extracted from Layout.astro.
 *
 * Renders the "My Business Profile" overlay used to collect the user's
 * business details (name, address, logo, colors, payment options) and
 * persist them to localStorage. Pre-fills every document generator
 * (invoice, receipt, quote, purchase order) via the global
 * fillDocFromBiz() hook defined on each page.
 *
 * Globals exposed on window (called from inline onclick= and from pages):
 *   openBizModal, closeBizModal, saveBizProfile, updateBizPreview,
 *   updateAddrLabels, autoSetCountryFlag, ADDR_CONFIG, ADDR_DEFAULT
 *
 * ADDR_CONFIG / ADDR_DEFAULT are imported from src/data/address-config.ts
 * (single source of truth) and serialized into a top-level `var` in the
 * first inline script — keeping them as bare globals so document-page
 * code can do `typeof ADDR_CONFIG !== 'undefined' ? ADDR_CONFIG[code] : ...`.
 *
 * localStorage keys (DO NOT RENAME — persistence contract):
 *   biz_name, biz_email, biz_phone, biz_street, biz_city, biz_state,
 *   biz_zip, biz_country, biz_country_name, biz_show_country, biz_logo,
 *   biz_primary_color, biz_accent_color, biz_paypal, biz_bank_name,
 *   biz_bank_holder, biz_bank_acct, biz_bank_routing, biz_bank_iban,
 *   biz_setup_done
 */
---

<script is:inline set:html={`
  var ADDR_CONFIG = ${JSON.stringify(ADDR_CONFIG)};
  var ADDR_DEFAULT = ${JSON.stringify(ADDR_DEFAULT)};
`}></script>
<style>
  .biz-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 45, 82, 0.72);
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 3vh 1rem;
    backdrop-filter: blur(3px);
    overflow-y: auto;
  }
  .biz-modal {
    background: #fff;
    border-radius: 14px;
    padding: 1.75rem 2rem;
    width: 100%;
    max-width: 900px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.22);
    position: relative;
  }
  .biz-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .biz-modal-header h3 { font-size: 1.2rem; color: var(--navy); margin-bottom: 0.2rem; }
  .biz-modal-header p { font-size: 0.83rem; color: var(--muted); margin: 0; }
  .biz-modal-close {
    background: none;
    border: none;
    font-size: 1.4rem;
    color: var(--muted);
    cursor: pointer;
    line-height: 1;
    padding: 0 0 0 0.75rem;
    flex-shrink: 0;
  }
  .biz-modal-close:hover { color: var(--text); }
  .biz-modal-cols {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 1.75rem;
    align-items: start;
  }
  @media (max-width: 680px) {
    .biz-modal-cols { grid-template-columns: 1fr; }
    .biz-paper-col { display: none; }
  }
  .biz-form-col { display: flex; flex-direction: column; }
  .biz-paper-col { display: flex; flex-direction: column; gap: 0.5rem; }
  .biz-paper-hint {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    text-align: center;
  }
  .biz-paper {
    background: #fff;
    border: 1px solid #d0d7e2;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08), 0 10px 32px rgba(0,0,0,0.10);
    width: 100%;
    aspect-ratio: 8.5 / 11;
    padding: 7% 8%;
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    font-size: 9px;
  }
  .bp-doc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 5%; }
  .bp-logo-img { max-height: 3.4em; max-width: 10em; object-fit: contain; display: block; }
  .bp-doc-type { font-size: 2.2em; font-weight: 800; color: var(--navy); letter-spacing: -0.01em; line-height: 1; }
  .bp-biz-name { font-size: 1.25em; font-weight: 700; color: var(--text); margin-bottom: 0.4em; line-height: 1.3; transition: color 0.15s; }
  .bp-biz-addr { font-size: 1em; color: var(--muted); line-height: 1.6; min-height: 1.2em; }
  .bp-biz-contact { font-size: 0.95em; color: var(--muted); margin-top: 0.4em; }
  .bp-divider { border: none; border-top: 1.5px solid var(--navy); margin: 4% 0 3%; }
  .bp-ghost-section { margin-bottom: 4%; }
  .bp-ghost-label { font-size: 0.8em; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fox); margin-bottom: 1.8%; }
  .bp-ghost-line { height: 0.88em; background: #e4e9f0; border-radius: 3px; margin-bottom: 1.4%; }
  .bp-ghost-table { margin-bottom: 3%; }
  .bp-ghost-thead { height: 1.6em; background: var(--navy); border-radius: 2px; margin-bottom: 1.5%; opacity: 0.85; }
  .bp-ghost-row { height: 1.1em; background: #e4e9f0; border-radius: 2px; margin-bottom: 1.2%; }
  .bp-ghost-totals { margin-left: 55%; margin-bottom: 2%; }
  .bp-ghost-total-row { height: 0.9em; background: #e4e9f0; border-radius: 2px; margin-bottom: 1.5%; }
  .bp-ghost-total-grand { height: 1.35em; background: var(--navy); border-radius: 2px; opacity: 0.75; }
  .bp-fade { position: absolute; bottom: 0; left: 0; right: 0; height: 28%; background: linear-gradient(to bottom, transparent 0%, #fff 90%); pointer-events: none; }
  .biz-logo-upload {
    border: 2px dashed var(--border);
    border-radius: 8px;
    padding: 0.85rem;
    text-align: center;
    cursor: pointer;
    margin-bottom: 0.75rem;
    transition: border-color 0.15s, background 0.15s;
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.35rem;
  }
  .biz-logo-upload:hover { border-color: var(--fox); background: #fff8f5; }
  .biz-logo-upload span { font-size: 0.82rem; color: var(--muted); }
  .biz-logo-upload img { max-height: 48px; max-width: 160px; object-fit: contain; }
  .biz-country-flag { display:flex; align-items:center; gap:.4rem; margin-top:.45rem; cursor:pointer; }
  .biz-country-flag input[type="checkbox"] { width:auto; margin:0; accent-color:var(--fox); flex-shrink:0; }
  .biz-country-flag span { font-size:.8rem; color:var(--muted); user-select:none; }
  .biz-modal-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  /* Match Save Profile to the secondary action-btn scale so the row reads
     as one cohesive control strip, and keep the label on one line. */
  .biz-modal-actions .btn {
    align-self: auto;
    white-space: nowrap;
    padding: 0.55rem 1.15rem;
    font-size: 0.88rem;
    border-radius: 6px;
    flex-shrink: 0;
  }
  .biz-actions-secondary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .biz-import-msg { font-size: 0.74rem; color: var(--muted); margin-left: 0.25rem; }
  @media (max-width: 480px) {
    .biz-modal-actions { flex-direction: column-reverse; align-items: stretch; }
    .biz-modal-actions .btn { width: 100%; text-align: center; }
    .biz-actions-secondary { justify-content: flex-start; }
  }
</style>

<!-- Business Profile Modal -->
