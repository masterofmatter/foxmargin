<script is:inline>
  // ── Business Profile Modal ──
  // ADDR_CONFIG / ADDR_DEFAULT are declared by the preceding inline
  // script (serialized from src/data/address-config.ts) and visible
  // here as top-level vars.

  function updateAddrLabels() {
    var code = (document.getElementById('biz-modal-country')?.value || 'US');
    var cfg  = ADDR_CONFIG[code] || ADDR_DEFAULT;
    var lblState = document.getElementById('lbl-biz-state');
    var lblZip   = document.getElementById('lbl-biz-zip');
    var fldState = document.getElementById('field-biz-state');
    var fldZip   = document.getElementById('field-biz-zip');
    var inpState = document.getElementById('biz-modal-state');
    var inpZip   = document.getElementById('biz-modal-zip');
    if (cfg.regionLabel) {
      if (fldState) fldState.style.display = '';
      if (lblState) lblState.textContent = cfg.regionLabel;
      if (inpState) inpState.placeholder  = cfg.regionPh;
    } else {
      if (fldState) fldState.style.display = 'none';
      if (inpState) inpState.value = '';
    }
    if (cfg.postalLabel) {
      if (fldZip) fldZip.style.display = '';
      if (lblZip) lblZip.textContent = cfg.postalLabel;
      if (inpZip) inpZip.placeholder  = cfg.postalPh;
    } else {
      if (fldZip) fldZip.style.display = 'none';
      if (inpZip) inpZip.value = '';
    }
  }

  function openBizModal() {
    document.getElementById('biz-modal').style.display = 'flex';
    _loadBizToModal();
  }
  function closeBizModal() {
    document.getElementById('biz-modal').style.display = 'none';
    localStorage.setItem('biz_setup_done', '1');
  }
  function autoSetCountryFlag() {
    var sel = document.getElementById('biz-modal-country');
    var cb  = document.getElementById('biz-show-country');
    if (cb && sel) cb.checked = (sel.value !== 'US');
  }
  function _loadBizToModal() {
    var countrySel = document.getElementById('biz-modal-country');
    if (countrySel) countrySel.value = localStorage.getItem('biz_country') || 'US';
    var showCb = document.getElementById('biz-show-country');
    if (showCb) {
      var savedFlag = localStorage.getItem('biz_show_country');
      showCb.checked = savedFlag !== null ? (savedFlag === '1') : ((localStorage.getItem('biz_country') || 'US') !== 'US');
    }
    var currencySel = document.getElementById('biz-modal-currency');
    if (currencySel) currencySel.value = localStorage.getItem('preferred_currency') || 'USD';
    document.getElementById('biz-modal-name').value   = localStorage.getItem('biz_name')   || '';
    document.getElementById('biz-modal-email').value  = localStorage.getItem('biz_email')  || '';
    document.getElementById('biz-modal-phone').value  = localStorage.getItem('biz_phone')  || '';
    document.getElementById('biz-modal-street').value = localStorage.getItem('biz_street') || '';
    document.getElementById('biz-modal-city').value   = localStorage.getItem('biz_city')   || '';
    document.getElementById('biz-modal-state').value  = localStorage.getItem('biz_state')  || '';
    document.getElementById('biz-modal-zip').value    = localStorage.getItem('biz_zip')    || '';
    const logo = localStorage.getItem('biz_logo');
    const prev = document.getElementById('biz-logo-preview');
    const ph   = document.getElementById('biz-logo-placeholder');
    if (logo) { prev.src = logo; prev.style.display = 'block'; ph.style.display = 'none'; }
    else       { prev.style.display = 'none'; ph.style.display = 'block'; }
    var primaryEl = document.getElementById('biz-modal-primary');
    var accentEl  = document.getElementById('biz-modal-accent');
    if (primaryEl) primaryEl.value = localStorage.getItem('biz_primary_color') || '#0f2d52';
    if (accentEl)  accentEl.value  = localStorage.getItem('biz_accent_color')  || '#d4500a';
    var paypalEl = document.getElementById('biz-modal-paypal');
    if (paypalEl) paypalEl.value = localStorage.getItem('biz_paypal') || '';
    [['biz-modal-bank-name','biz_bank_name'],['biz-modal-bank-holder','biz_bank_holder'],
     ['biz-modal-bank-acct','biz_bank_acct'],['biz-modal-bank-routing','biz_bank_routing'],
     ['biz-modal-bank-iban','biz_bank_iban']].forEach(function(p) {
      var el = document.getElementById(p[0]); if (el) el.value = localStorage.getItem(p[1]) || '';
    });
    updateAddrLabels();
    updateBizPreview();
  }
  function saveBizProfile() {
    var cSel2 = document.getElementById('biz-modal-country');
    if (cSel2) {
      localStorage.setItem('biz_country', cSel2.value);
      var idx2 = cSel2.selectedIndex;
      localStorage.setItem('biz_country_name', idx2 >= 0 ? cSel2.options[idx2].text : '');
    }
    var showCb2 = document.getElementById('biz-show-country');
    if (showCb2) localStorage.setItem('biz_show_country', showCb2.checked ? '1' : '0');
    localStorage.setItem('biz_name',    document.getElementById('biz-modal-name').value.trim());
    localStorage.setItem('biz_email',   document.getElementById('biz-modal-email').value.trim());
    localStorage.setItem('biz_phone',   document.getElementById('biz-modal-phone').value.trim());
    localStorage.setItem('biz_street',  document.getElementById('biz-modal-street').value.trim());
    localStorage.setItem('biz_city',    document.getElementById('biz-modal-city').value.trim());
    localStorage.setItem('biz_state',   document.getElementById('biz-modal-state').value.trim());
    localStorage.setItem('biz_zip',     document.getElementById('biz-modal-zip').value.trim());
    var currencySel = document.getElementById('biz-modal-currency');
    if (currencySel) setCurrency(currencySel.value);
    var primaryEl = document.getElementById('biz-modal-primary');
    var accentEl  = document.getElementById('biz-modal-accent');
    if (primaryEl) localStorage.setItem('biz_primary_color', primaryEl.value);
    if (accentEl)  localStorage.setItem('biz_accent_color',  accentEl.value);
    var paypalEl2 = document.getElementById('biz-modal-paypal');
    if (paypalEl2) localStorage.setItem('biz_paypal', paypalEl2.value.trim().replace(/^@/, '').replace(/paypal\.me\//i, ''));
    [['biz-modal-bank-name','biz_bank_name'],['biz-modal-bank-holder','biz_bank_holder'],
     ['biz-modal-bank-acct','biz_bank_acct'],['biz-modal-bank-routing','biz_bank_routing'],
     ['biz-modal-bank-iban','biz_bank_iban']].forEach(function(p) {
      var el = document.getElementById(p[0]); if (el) localStorage.setItem(p[1], el.value.trim());
    });
    localStorage.setItem('biz_setup_done', '1');
    closeBizModal();
    if (typeof fillDocFromBiz === 'function') fillDocFromBiz();
  }
  // ── Backup / Restore ──
  // Exports all browser-local settings (biz_*, preferred_currency, fm_clients)
  // to a JSON file. Restores from the same file format. Excludes fm_pro
  // (Pro gate is intentionally not transferable).
  var FM_BACKUP_KEYS = [
    'biz_name','biz_email','biz_phone','biz_street','biz_city','biz_state','biz_zip',
    'biz_country','biz_country_name','biz_show_country','biz_logo',
    'biz_primary_color','biz_accent_color','biz_paypal',
    'biz_bank_name','biz_bank_holder','biz_bank_acct','biz_bank_routing','biz_bank_iban',
    'biz_setup_done','preferred_currency','fm_clients'
  ];
  function exportBizSettings() {
    var data = { foxmargin_settings: 1, exported_at: new Date().toISOString() };
    FM_BACKUP_KEYS.forEach(function(k) {
      var v = localStorage.getItem(k);
      if (v !== null) data[k] = v;
    });
    var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'foxmargin-settings.json';
    document.body.appendChild(a);
    a.click();
    setTimeout(function() { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    if (typeof window.track === 'function') window.track('settings_exported');
    var msg = document.getElementById('biz-import-msg');
    if (msg) {
      msg.textContent = '✓ Downloaded';
      msg.style.color = '#16a34a';
      setTimeout(function() { msg.textContent = ''; }, 3000);
    }
  }
  function importBizSettings(file) {
    if (!file) return;
    var msg = document.getElementById('biz-import-msg');
    var reader = new FileReader();
    reader.onload = function(e) {
      var data;
      try { data = JSON.parse(e.target.result); }
      catch (err) {
        if (msg) { msg.textContent = '✗ Not a valid JSON file'; msg.style.color = '#dc2626'; }
        return;
      }
      if (!data || data.foxmargin_settings !== 1) {
        if (msg) { msg.textContent = '✗ Not a FoxMargin backup'; msg.style.color = '#dc2626'; }
        return;
      }
      if (!window.confirm('Replace your current FoxMargin settings with this backup? This cannot be undone.')) return;
      FM_BACKUP_KEYS.forEach(function(k) {
        if (typeof data[k] === 'string') localStorage.setItem(k, data[k]);
      });
      if (typeof _loadBizToModal === 'function') _loadBizToModal();
      if (typeof fillDocFromBiz === 'function') fillDocFromBiz();
      if (typeof window.refreshClientPicker === 'function') window.refreshClientPicker();
      if (typeof window.track === 'function') window.track('settings_imported');
      if (msg) {
        msg.textContent = '✓ Settings restored';
        msg.style.color = '#16a34a';
        setTimeout(function() { msg.textContent = ''; }, 4000);
      }
    };
    reader.readAsText(file);
  }
  function updateBizPreview() {
    var name   = (document.getElementById('biz-modal-name')?.value   || '').trim();
    var street = (document.getElementById('biz-modal-street')?.value || '').trim();
    var city   = (document.getElementById('biz-modal-city')?.value   || '').trim();
    var state  = (document.getElementById('biz-modal-state')?.value  || '').trim();
    var zip    = (document.getElementById('biz-modal-zip')?.value    || '').trim();
    var phone  = (document.getElementById('biz-modal-phone')?.value  || '').trim();
    var email  = (document.getElementById('biz-modal-email')?.value  || '').trim();
    var cSel   = document.getElementById('biz-modal-country');
    var countryName = (cSel && cSel.selectedIndex >= 0) ? cSel.options[cSel.selectedIndex].text : '';
    var countryCode = cSel?.value || 'US';
    var elName    = document.getElementById('bp-prev-name');
    var elStreet  = document.getElementById('bp-prev-street');
    var elCity    = document.getElementById('bp-prev-cityline');
    var elCountry = document.getElementById('bp-prev-country');
    var elContact = document.getElementById('bp-prev-contact');
    var elLogo    = document.getElementById('bp-prev-logo');
    if (elName) {
      elName.textContent = name || 'Your Business Name';
      elName.style.color = name ? 'var(--text)' : '#c0c8d4';
    }
    if (elStreet) elStreet.textContent = street;
    if (elCity) {
      var parts = [];
      if (city)  parts.push(city);
      if (state) parts.push(state);
      var line = parts.join(', ');
      if (zip)   line += (line ? ' ' : '') + zip;
      elCity.textContent = line;
    }
    var showCb3 = document.getElementById('biz-show-country');
    if (elCountry) elCountry.textContent = (showCb3?.checked && countryCode !== 'US') ? countryName : '';
    if (elContact) {
      var cp = [];
      if (phone) cp.push(phone);
      if (email) cp.push(email);
      elContact.textContent = cp.join('  ·  ');
    }
    if (elLogo) {
      var logo = localStorage.getItem('biz_logo');
      if (logo) { elLogo.src = logo; elLogo.style.display = 'block'; }
      else { elLogo.style.display = 'none'; }
    }
    var primary = document.getElementById('biz-modal-primary')?.value || localStorage.getItem('biz_primary_color') || '#0f2d52';
    var accent  = document.getElementById('biz-modal-accent')?.value  || localStorage.getItem('biz_accent_color')  || '#d4500a';
    var paperEl = document.querySelector('.biz-paper');
    if (paperEl) {
      paperEl.style.setProperty('--navy', primary);
      paperEl.style.setProperty('--fox',  accent);
    }
  }
  document.getElementById('biz-logo-input').addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      const b64 = e.target.result;
      localStorage.setItem('biz_logo', b64);
      const prev = document.getElementById('biz-logo-preview');
      const ph   = document.getElementById('biz-logo-placeholder');
      prev.src = b64; prev.style.display = 'block'; ph.style.display = 'none';
      updateBizPreview();
    };
    reader.readAsDataURL(file);
  });
</script>
