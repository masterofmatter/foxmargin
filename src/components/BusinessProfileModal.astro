        <div class="biz-paper">
          <div class="bp-doc-header">
            <div class="bp-logo-area">
              <img id="bp-prev-logo" class="bp-logo-img" style="display:none;" />
            </div>
            <div class="bp-doc-type">INVOICE</div>
          </div>
          <div id="bp-prev-name" class="bp-biz-name" style="color:#c0c8d4;">Your Business Name</div>
          <div id="bp-prev-street" class="bp-biz-addr"></div>
          <div id="bp-prev-cityline" class="bp-biz-addr"></div>
