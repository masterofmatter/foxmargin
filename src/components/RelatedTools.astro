---
export interface Tool {
  href: string;
  label: string;
  description: string;
}
export interface Props {
  tools: Tool[];
}
const { tools } = Astro.props;
---
<div class="related-tools">
  <div class="ws-card-label">Related Tools</div>
  <div class="related-grid">
    {tools.map(t => (
      <a href={t.href} class="related-card">
        <div class="related-label">{t.label}</div>
        <div class="related-desc">{t.description}</div>
        <span class="related-cta">Open →</span>
      </a>
    ))}
  </div>
</div>

<style>
  .related-tools { margin-top: 1.5rem; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 0.9rem 1rem;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .related-card:hover {
    border-color: var(--fox);
    box-shadow: 0 2px 8px rgba(212,80,10,0.08);
    text-decoration: none;
  }
  .related-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--navy);
  }
  .related-desc {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.4;
    flex: 1;
  }
  .related-cta {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--fox);
    margin-top: 0.2rem;
  }
</style>
