---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    href: '/blog/how-to-write-a-professional-invoice/',
    title: 'How to Write a Professional Invoice: A Complete Guide',
    description: 'What to include, how to format it, and how to get paid faster. Covers line items, payment terms, invoice numbers, and common mistakes.',
    date: 'May 12, 2025',
    readingTime: '6 min',
    tag: 'Invoicing',
  },
  {
    href: '/blog/how-to-calculate-freelance-hourly-rate/',
    title: 'How to Calculate Your Freelance Hourly Rate',
    description: 'A step-by-step guide: income target, billable hours, expenses, taxes. Find your minimum rate and how much to charge above it.',
    date: 'May 12, 2025',
    readingTime: '5 min',
    tag: 'Freelance',
  },
  {
    href: '/blog/break-even-analysis-guide/',
    title: 'Break-Even Analysis: A Simple Guide for Small Businesses',
    description: 'What break-even analysis is, how to calculate it with the formula, and how to use it for pricing, hiring, and product launch decisions.',
    date: 'May 12, 2025',
    readingTime: '5 min',
    tag: 'Finance',
  },
];
---
<Layout
  title="Blog — Small Business & Freelance Finance Guides | FoxMargin"
  description="Free guides on invoicing, freelance pricing, break-even analysis, and running a small business. Written by FoxMargin."
>
  <section class="blog-hero">
    <h1>Guides</h1>
    <p class="blog-hero-sub">Practical finance and business guides for freelancers and small businesses.</p>
  </section>

  <div class="post-list">
    {posts.map(p => (
      <a href={p.href} class="post-card">
        <div class="post-tag">{p.tag}</div>
        <h2>{p.title}</h2>
        <p>{p.description}</p>
        <div class="post-meta">
          <span>{p.date}</span>
          <span>·</span>
          <span>{p.readingTime} read</span>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .blog-hero {
    background: #fff; border: 1px solid var(--border); border-radius: 14px;
    padding: 1.85rem 2.25rem; margin-bottom: 1.5rem;
  }
  .blog-hero h1 { font-size: 1.75rem; font-weight: 800; color: var(--navy); margin-bottom: 0.4rem; letter-spacing: -0.01em; }
  .blog-hero-sub { font-size: 0.95rem; color: var(--muted); margin: 0; }

  .post-list { display: flex; flex-direction: column; gap: 1rem; }

  .post-card {
    display: block;
    background: #fff; border: 1px solid var(--border); border-radius: 12px;
    padding: 1.5rem 1.75rem; text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .post-card:hover { border-color: var(--fox); box-shadow: 0 2px 12px rgba(212,80,10,0.07); text-decoration: none; }

  .post-tag {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--fox); background: #fff8f5; border: 1px solid #f5d6c4;
    border-radius: 20px; padding: 0.2rem 0.65rem; margin-bottom: 0.6rem;
  }
  .post-card h2 { font-size: 1.1rem; font-weight: 800; color: var(--navy); margin-bottom: 0.4rem; letter-spacing: -0.01em; line-height: 1.3; }
  .post-card p { font-size: 0.9rem; color: var(--muted); line-height: 1.55; margin: 0 0 0.75rem; }
  .post-meta { font-size: 0.78rem; color: var(--muted); display: flex; gap: 0.35rem; }

  @media (max-width: 600px) {
    .blog-hero { padding: 1.5rem; }
    .post-card { padding: 1.25rem 1.25rem; }
  }
</style>
