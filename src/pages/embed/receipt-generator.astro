---
import EmbedLayout from '../../layouts/EmbedLayout.astro';
---
<EmbedLayout
  title="Free Receipt Generator — FoxMargin"
  fullUrl="https://foxmargin.com/receipt-generator/"
  fullLabel="Free Receipt Generator"
>
  <div class="card">
    <h2>Receipt Generator</h2>
    <div class="calc-form">
      <div class="section-label">Your Business</div>
      <div class="field-row">
        <div class="field"><label for="from-name">Business Name</label><input type="text" id="from-name" placeholder="Acme Corp" /></div>
        <div class="field"><label for="from-phone">Phone</label><input type="tel" id="from-phone" placeholder="+1 (555) 000-0000" /></div>
      </div>
      <div class="field"><label for="from-email">Email</label><input type="email" id="from-email" placeholder="hello@yourcompany.com" /></div>

      <div class="section-label" style="margin-top:0.25rem;">Receipt For</div>
      <div class="field"><label for="to-name">Customer Name</label><input type="text" id="to-name" placeholder="Jane Smith" /></div>

      <div class="section-label" style="margin-top:0.25rem;">Details</div>
      <div class="field-row">
        <div class="field"><label for="rec-number">Receipt #</label><input type="text" id="rec-number" /></div>
        <div class="field"><label for="rec-date">Date</label><input type="date" id="rec-date" /></div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="payment-method">Payment Method</label>
          <select id="payment-method">
            <option>Credit Card</option><option>Debit Card</option><option>Cash</option>
            <option>Bank Transfer</option><option>Check</option><option>Other</option>
          </select>
        </div>
        <div class="field"><label for="tax-rate">Tax Rate (%)</label><input type="number" id="tax-rate" value="0" min="0" step="0.01" /></div>
      </div>

      <div class="section-label" style="margin-top:0.25rem;">Items</div>
      <div id="line-items">
        <div class="line-item-row">
          <div class="field li-desc"><label>Description</label><input type="text" placeholder="Item" class="li-description" /></div>
          <div class="field li-qty"><label>Qty</label><input type="number" value="1" min="0" step="0.01" class="li-qty-val" /></div>
          <div class="field li-rate"><label>Price</label><input type="number" placeholder="0.00" min="0" step="0.01" class="li-rate-val" /></div>
          <div class="field li-total"><label>Total</label><span class="li-total-val">—</span></div>
        </div>
      </div>
      <button class="btn btn-outline" onclick="addLine()" type="button" style="font-size:0.82rem;padding:0.45rem 0.85rem;">+ Add Item</button>
      <div class="field"><label for="amount-paid">Amount Paid ($)</label><input type="number" id="amount-paid" placeholder="Defaults to total" min="0" step="0.01" /></div>
      <button class="btn" onclick="generateDoc()" type="button">Generate Receipt</button>
    </div>

    <div class="results" id="results" style="margin-top:1rem;"></div>
  </div>
</EmbedLayout>

<script is:inline>
(function() {
  const t = new Date();
  document.getElementById('rec-date').value = t.toISOString().slice(0,10);
  document.getElementById('rec-number').value = 'REC-001';
  document.getElementById('line-items').addEventListener('input', updateTotals);
  const name = localStorage.getItem('biz_name');
  if (name) document.getElementById('from-name').value = name;
  const email = localStorage.getItem('biz_email');
  if (email) document.getElementById('from-email').value = email;
  const phone = localStorage.getItem('biz_phone');
  if (phone) document.getElementById('from-phone').value = phone;
})();
function fmt(n) {
  const c = window.__currency || { locale:'en-US', code:'USD' };
  return new Intl.NumberFormat(c.locale,{style:'currency',currency:c.code,minimumFractionDigits:2,maximumFractionDigits:2}).format(n);
}
function addLine() {
  const row = document.createElement('div'); row.className='line-item-row';
  row.innerHTML=`<div class="field li-desc"><input type="text" placeholder="Item" class="li-description"/></div><div class="field li-qty"><input type="number" value="1" min="0" step="0.01" class="li-qty-val"/></div><div class="field li-rate"><input type="number" placeholder="0.00" min="0" step="0.01" class="li-rate-val"/></div><div class="field li-total"><span class="li-total-val">—</span></div>`;
  document.getElementById('line-items').appendChild(row);
}
function updateTotals() {
  document.querySelectorAll('.line-item-row').forEach(r=>{
    const q=parseFloat(r.querySelector('.li-qty-val')?.value)||0, p=parseFloat(r.querySelector('.li-rate-val')?.value)||0, el=r.querySelector('.li-total-val');
    if(el) el.textContent=q*p>0?fmt(q*p):'—';
  });
}
function generateDoc() {
  const items=Array.from(document.querySelectorAll('.line-item-row')).map(r=>({desc:r.querySelector('.li-description')?.value||'',qty:parseFloat(r.querySelector('.li-qty-val')?.value)||0,rate:parseFloat(r.querySelector('.li-rate-val')?.value)||0})).filter(r=>r.desc||r.qty*r.rate>0);
  const sub=items.reduce((s,r)=>s+r.qty*r.rate,0), tax=sub*(parseFloat(document.getElementById('tax-rate').value)||0)/100, total=sub+tax;
  const paid=document.getElementById('amount-paid').value!==''?parseFloat(document.getElementById('amount-paid').value)||0:total;
  const bal=total-paid, isPaid=bal<=0.005;
  const res=document.getElementById('results');
  res.innerHTML=`<strong style="color:var(--navy);">${document.getElementById('from-name').value||'Receipt'} — #${document.getElementById('rec-number').value}</strong>
    <div style="margin:0.6rem 0;font-size:0.85rem;color:var(--muted);">Date: ${document.getElementById('rec-date').value} &nbsp;|&nbsp; Payment: ${document.getElementById('payment-method').value}</div>
    <table style="width:100%;border-collapse:collapse;margin:0.5rem 0;font-size:0.85rem;"><thead><tr style="background:var(--navy);color:#fff;"><th style="padding:0.4rem;text-align:left;">Item</th><th style="padding:0.4rem;text-align:right;">Total</th></tr></thead><tbody>${items.map(r=>`<tr><td style="padding:0.35rem 0.4rem;border-bottom:1px solid var(--border);">${r.desc} ×${r.qty}</td><td style="padding:0.35rem 0.4rem;border-bottom:1px solid var(--border);text-align:right;">${fmt(r.qty*r.rate)}</td></tr>`).join('')}</tbody></table>
    ${tax>0?`<div style="display:flex;justify-content:space-between;font-size:0.85rem;color:var(--muted);"><span>Tax</span><span>${fmt(tax)}</span></div>`:''}
    <div style="display:flex;justify-content:space-between;font-size:0.95rem;font-weight:700;color:var(--navy);border-top:2px solid var(--navy);padding-top:0.4rem;margin-top:0.3rem;"><span>Total</span><span>${fmt(total)}</span></div>
    <div style="display:flex;justify-content:space-between;font-size:0.88rem;color:var(--muted);margin-top:0.3rem;"><span>Amount Paid</span><span>${fmt(paid)}</span></div>
    <div style="display:flex;justify-content:space-between;font-size:0.88rem;font-weight:600;color:${isPaid?'#059669':'#dc2626'};"><span>Balance Due</span><span>${fmt(Math.max(0,bal))}</span></div>
    ${isPaid?'<div style="display:inline-block;border:2px solid #059669;color:#059669;font-weight:900;padding:0.2rem 0.9rem;border-radius:4px;margin-top:0.5rem;letter-spacing:0.1em;">PAID</div>':''}
    <p style="margin-top:0.75rem;font-size:0.78rem;color:var(--muted);">Open the <a href="https://foxmargin.com/receipt-generator/" target="_blank">full Receipt Generator</a> to add logo, address, and print.</p>`;
  res.classList.add('show');
}
</script>
