---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="FoxMargin — Free Business Calculators"
  description="Free profit margin, break-even, markup, and invoice calculators for small business owners. Fast, accurate, no signup required."
>
  <div class="card">
    <h1>Free Business Calculators</h1>
    <p>Fast, accurate tools for small business owners. No signup, no ads in the way — just answers.</p>
  </div>

  <div class="tools-grid">
    <a href="/profit-margin-calculator/" class="tool-card">
      <div class="tool-icon">📊</div>
      <div>
        <h2>Profit Margin Calculator</h2>
        <p>Calculate gross margin, net margin, and profit from revenue and cost.</p>
        <span class="tag">Most popular</span>
      </div>
    </a>
    <a href="/break-even-calculator/" class="tool-card">
      <div class="tool-icon">⚖️</div>
      <div>
        <h2>Break-Even Calculator</h2>
        <p>Find exactly how many units you need to sell to cover your costs.</p>
      </div>
    </a>
    <a href="/markup-calculator/" class="tool-card">
      <div class="tool-icon">🏷️</div>
      <div>
        <h2>Markup Calculator</h2>
        <p>Set the right price. Convert between markup percentage and profit margin.</p>
      </div>
    </a>
    <a href="/invoice-generator/" class="tool-card">
      <div class="tool-icon">🧾</div>
      <div>
        <h2>Invoice Generator</h2>
        <p>Create a professional invoice in seconds. Print or save as PDF, free.</p>
        <span class="tag tag-new">Free PDF</span>
      </div>
    </a>
  </div>
</Layout>

<style>
  .tools-grid { display: flex; flex-direction: column; gap: 1rem; }
  .tool-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .tool-card:hover {
    border-color: var(--fox);
    box-shadow: 0 2px 12px rgba(212,80,10,0.1);
    text-decoration: none;
  }
  .tool-icon { font-size: 2rem; flex-shrink: 0; line-height: 1; margin-top: 0.1rem; }
  .tool-card h2 { font-size: 1.05rem; color: var(--navy); margin-bottom: 0.25rem; }
  .tool-card p { font-size: 0.88rem; color: var(--muted); margin: 0; }
  .tag {
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: #fff3e0;
    color: var(--fox);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tag-new { background: #e8f5e9; color: #2e7d32; }
</style>
