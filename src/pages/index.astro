---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="FoxMargin — Free Business Calculators"
  description="Free profit margin, break-even, markup, and invoice calculators for small business owners. Fast, accurate, no signup required."
>
  <div class="card">
    <h1>Free Business Calculators</h1>
    <p>Fast, accurate tools for small business owners. No signup, no ads in the way — just answers.</p>
  </div>

  <div class="tools-grid">
    <a href="/profit-margin-calculator/" class="tool-card">
      <div class="tool-meta"><span class="tool-tag">Most popular</span></div>
      <h2>Profit Margin Calculator</h2>
      <p>Calculate gross margin, net margin, and profit from revenue and cost.</p>
    </a>
    <a href="/break-even-calculator/" class="tool-card">
      <div class="tool-meta"></div>
      <h2>Break-Even Calculator</h2>
      <p>Find exactly how many units you need to sell to cover your costs.</p>
    </a>
    <a href="/markup-calculator/" class="tool-card">
      <div class="tool-meta"></div>
      <h2>Markup Calculator</h2>
      <p>Set the right price. Convert between markup percentage and profit margin.</p>
    </a>
    <a href="/invoice-generator/" class="tool-card">
      <div class="tool-meta"><span class="tool-tag tool-tag-green">Free PDF</span></div>
      <h2>Invoice Generator</h2>
      <p>Create a professional invoice in seconds. Print or save as PDF, free.</p>
    </a>
  </div>
</Layout>

<style>
  .tools-grid { display: flex; flex-direction: column; gap: 0.85rem; }
  .tool-card {
    background: #fff;
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    border-radius: var(--radius);
    padding: 1.1rem 1.4rem;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .tool-card:hover {
    border-left-color: var(--fox);
    box-shadow: 0 2px 12px rgba(212,80,10,0.08);
    text-decoration: none;
  }
  .tool-meta { min-height: 1.4rem; margin-bottom: 0.3rem; }
  .tool-card h2 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 0.2rem; }
  .tool-card p { font-size: 0.87rem; color: var(--muted); margin: 0; }
  .tool-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: #fff3e0;
    color: var(--fox);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tool-tag-green { background: #e8f5e9; color: #2e7d32; }
</style>
