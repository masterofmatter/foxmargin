---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": [
  { "@type": "WebApplication", "name": "Markup Calculator",
    "url": "https://foxmargin.com/markup-calculator/",
    "description": "Calculate markup percentage, selling price, and profit margin. Convert between markup and margin instantly. Free business pricing calculator.",
    "applicationCategory": "FinanceApplication", "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": ["Markup percentage", "Selling price calculator", "Margin to markup conversion", "Live results", "No account required"] },
  { "@type": "FAQPage", "mainEntity": [
    { "@type": "Question", "name": "What markup should I use for retail?",
      "acceptedAnswer": { "@type": "Answer", "text": "Retail markup varies widely by category. Fashion typically uses 100–200%. Electronics are much lower at 10–30% due to thin margins. Specialty goods and handmade products can support 200–400% markup. Use your industry benchmarks as a starting point, then test price sensitivity." } },
    { "@type": "Question", "name": "What is keystone pricing?",
      "acceptedAnswer": { "@type": "Answer", "text": "Keystone pricing is doubling the wholesale cost — a 100% markup, which gives you a 50% margin. It was a traditional retail standard. Many modern retailers use it as a floor rather than a target, especially for premium or low-competition products." } },
    { "@type": "Question", "name": "How do I convert a target margin to a markup?",
      "acceptedAnswer": { "@type": "Answer", "text": "Use this formula: Markup % = Margin % divided by (1 minus Margin %). So a 40% target margin = 40 divided by 0.60 = 66.7% markup. The reverse: Margin % = Markup % divided by (1 + Markup %)." } }
  ]}
]});
---
<Layout
  title="Markup Calculator — Free | FoxMargin"
  description="Calculate markup percentage, selling price, and profit margin. Convert between markup and margin instantly. Free business pricing calculator."
  schema={schema}
>
  <!-- Hero -->
  <section class="calc-hero">
    <h1>Markup Calculator</h1>
    <p class="calc-hero-sub">Calculate selling price from cost and markup — or find your markup from cost and price. Margin conversion included, updated live.</p>
  </section>

  <!-- Calculator workspace -->
  <div class="calc-workspace">
    <!-- Inputs -->
    <div class="ws-card">
      <div class="ws-card-label">Inputs</div>

      <div class="calc-tabs">
        <button class="calc-tab active" type="button" onclick="setMode('markup')">Cost + Markup %</button>
        <button class="calc-tab" type="button" onclick="setMode('reverse')">Cost + Selling Price</button>
      </div>

      <!-- Mode 1: Cost + Markup -->
      <div id="mode-markup" class="calc-form" style="gap:0.75rem;">
        <div class="field-row">
          <div class="field">
            <label for="cost1">Cost</label>
            <input type="number" id="cost1" placeholder="e.g. 25.00" min="0" step="0.01" oninput="recalc()" />
          </div>
          <div class="field">
            <label for="markup-pct">Markup (%)</label>
            <input type="number" id="markup-pct" placeholder="e.g. 50" min="0" step="0.1" oninput="recalc()" />
          </div>
        </div>
      </div>

      <!-- Mode 2: Cost + Price -->
      <div id="mode-reverse" class="calc-form" style="gap:0.75rem;display:none;">
        <div class="field-row">
          <div class="field">
            <label for="cost2">Cost</label>
            <input type="number" id="cost2" placeholder="e.g. 25.00" min="0" step="0.01" oninput="recalc()" />
          </div>
          <div class="field">
            <label for="sell-price">Selling Price</label>
            <input type="number" id="sell-price" placeholder="e.g. 40.00" min="0" step="0.01" oninput="recalc()" />
          </div>
        </div>
      </div>
    </div>

    <!-- Results -->
    <div class="ws-card">
      <div class="ws-card-label">Results</div>
      <div class="calc-results-grid">
        <div class="calc-result-item primary">
          <div class="calc-result-value" id="res-price">—</div>
          <div class="calc-result-label">Selling Price</div>
        </div>
        <div class="calc-result-item">
          <div class="calc-result-value" id="res-profit">—</div>
          <div class="calc-result-label">Profit</div>
        </div>
        <div class="calc-result-item primary">
          <div class="calc-result-value" id="res-markup">—</div>
          <div class="calc-result-label">Markup %</div>
        </div>
        <div class="calc-result-item">
          <div class="calc-result-value" id="res-margin">—</div>
          <div class="calc-result-label">Margin %</div>
        </div>
      </div>
      <p id="mk-warning" class="calc-warning" style="display:none;">Selling price must be greater than cost to calculate markup.</p>
    </div>
  </div>

  <!-- About / Formula / Reference Table -->
  <div class="ws-card">
    <div class="ws-card-label">Markup vs Margin</div>
    <p class="ws-body">This is one of the most common pricing mistakes in small business. Markup and margin are calculated from different bases:</p>
    <div class="formula-box">
      <p><strong>Markup %</strong> = (Selling Price − Cost) ÷ Cost × 100</p>
      <p><strong>Margin %</strong> = (Selling Price − Cost) ÷ Selling Price × 100</p>
    </div>
    <p class="ws-body" style="margin-top:0.85rem;">Example: You buy for $10 and sell for $15.</p>
    <ul class="ws-list">
      <li>Markup = $5 ÷ $10 = <strong>50%</strong></li>
      <li>Margin = $5 ÷ $15 = <strong>33.3%</strong></li>
    </ul>
    <p class="ws-body">If you think in margin terms but price in markup terms, you'll underprice every product.</p>

    <div class="ws-card-label" style="margin-top:1.5rem;">Markup → Margin Reference</div>
    <table class="bench-table">
      <thead><tr><th>Markup %</th><th>Margin %</th></tr></thead>
      <tbody>
        <tr><td>25%</td><td>20.0%</td></tr>
        <tr><td>33%</td><td>24.8%</td></tr>
        <tr><td>50%</td><td>33.3%</td></tr>
        <tr><td>100%</td><td>50.0%</td></tr>
        <tr><td>200%</td><td>66.7%</td></tr>
        <tr><td>400%</td><td>80.0%</td></tr>
      </tbody>
    </table>
  </div>

  <!-- FAQ -->
  <div class="ws-card">
    <div class="ws-card-label">Frequently Asked Questions</div>
    <details>
      <summary>What markup should I use for retail?</summary>
      <p>Retail markup varies widely by product category. Fashion and apparel typically use 100–200% (keystone pricing and above). Electronics are much lower at 10–30% due to thin margins. Specialty goods and handmade products can support 200–400% markup. Use your industry benchmarks as a starting point, then test price sensitivity.</p>
    </details>
    <details>
      <summary>What is keystone pricing?</summary>
      <p>Keystone pricing is doubling the wholesale cost — a 100% markup, which gives you a 50% margin. It was a traditional retail standard. Many modern retailers use it as a floor rather than a target, especially for premium or low-competition products.</p>
    </details>
    <details>
      <summary>How do I convert a target margin to a markup?</summary>
      <p>Use this formula: Markup % = Margin % ÷ (1 − Margin %). So a 40% target margin = 40 ÷ 0.60 = 66.7% markup. The reverse: Margin % = Markup % ÷ (1 + Markup %).</p>
    </details>
  </div>

  <!-- Embed -->
  <div class="ws-card">
    <div class="ws-card-label">Embed This Calculator</div>
    <p class="ws-body">Free to use on your website or blog. Paste one line of HTML — no account or backend needed.</p>
    <pre id="embed-code" class="embed-code"></pre>
    <button id="embed-copy-btn" onclick="copyEmbed()" class="btn" style="font-size:0.85rem;padding:0.5rem 1rem;">Copy Embed Code</button>
  </div>
</Layout>

<style>
  /* ── Calculator hero ── */
  .calc-hero {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.85rem 2.25rem;
    margin-bottom: 1.25rem;
  }
  .calc-hero h1 {
    font-size: 1.75rem;
    color: var(--navy);
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .calc-hero-sub { font-size: 0.95rem; color: var(--muted); line-height: 1.55; margin: 0; }
  @media (max-width: 600px) {
    .calc-hero { padding: 1.5rem 1.5rem; }
    .calc-hero h1 { font-size: 1.45rem; }
  }

  /* ── Calculator workspace ── */
  .calc-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 760px) { .calc-workspace { grid-template-columns: 1fr; } }

  /* ── Segmented tab control ── */
  .calc-tabs {
    display: flex;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.2rem;
    gap: 0.2rem;
    margin-bottom: 0.9rem;
  }
  .calc-tab {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.5rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    font-family: inherit;
    white-space: nowrap;
  }
  .calc-tab.active { background: var(--fox); color: #fff; }
  .calc-tab:not(.active):hover { color: var(--text); background: rgba(0,0,0,0.04); }

  /* ── Result tiles ── */
  .calc-results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .calc-result-item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 1.1rem 1rem;
    text-align: center;
  }
  .calc-result-item.primary { background: #fff8f5; border-color: #f5d6c4; }
  .calc-result-value {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }
  .calc-result-item.primary .calc-result-value { color: var(--fox); }
  .calc-result-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .calc-warning {
    margin-top: 1rem;
    padding: 0.65rem 0.85rem;
    background: #fef3e6;
    border: 1px solid #f5d6a1;
    border-radius: 8px;
    color: #92400e;
    font-size: 0.83rem;
    line-height: 1.5;
  }

  /* ── Inline body inside ws-cards ── */
  .ws-body { font-size: 0.92rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.85rem; }
  .ws-list { margin: 0 0 0.85rem 1.2rem; color: var(--muted); font-size: 0.92rem; line-height: 1.75; }
  .ws-list strong { color: var(--text); }

  /* ── Formula box ── */
  .formula-box {
    background: #fff8f5;
    border-left: 3px solid var(--fox);
    padding: 0.85rem 1rem;
    border-radius: 0 7px 7px 0;
    font-family: 'SF Mono', Menlo, monospace;
    font-size: 0.87rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--text);
  }
  .formula-box strong { color: var(--navy); }

  /* ── Benchmark table ── */
  .bench-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .bench-table th {
    background: var(--navy); color: #fff; padding: 0.55rem 0.85rem;
    text-align: left; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;
  }
  .bench-table td { padding: 0.55rem 0.85rem; border-bottom: 1px solid var(--border); color: var(--muted); }
  .bench-table tr:last-child td { border-bottom: none; }

  /* ── Embed code block ── */
  .embed-code {
    background: var(--bg); border: 1.5px solid var(--border); border-radius: 7px;
    padding: 0.85rem 1rem; font-size: 0.78rem; overflow-x: auto;
    white-space: pre-wrap; word-break: break-all; color: var(--muted);
    line-height: 1.6; margin-bottom: 0.75rem;
  }
</style>

<script is:inline>
let _mode = 'markup';

function fmt(n, d) {
  if (typeof d !== 'number') d = 2;
  const c = window.__currency || { locale: 'en-US', code: 'USD' };
  return new Intl.NumberFormat(c.locale, { style: 'currency', currency: c.code, minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
}

function setMode(mode) {
  _mode = mode;
  document.getElementById('mode-markup').style.display  = mode === 'markup'  ? 'flex' : 'none';
  document.getElementById('mode-reverse').style.display = mode === 'reverse' ? 'flex' : 'none';
  document.querySelectorAll('.calc-tab').forEach((t, i) => t.classList.toggle('active', (mode === 'markup') === (i === 0)));
  recalc();
}

function clearResults() {
  ['res-price', 'res-profit', 'res-markup', 'res-margin'].forEach(id => document.getElementById(id).textContent = '—');
}

function recalc() {
  const warn = document.getElementById('mk-warning');
  warn.style.display = 'none';

  if (_mode === 'markup') {
    const cost = parseFloat(document.getElementById('cost1').value) || 0;
    const markupPct = parseFloat(document.getElementById('markup-pct').value) || 0;
    if (cost <= 0) { clearResults(); return; }
    const price = cost * (1 + markupPct / 100);
    const profit = price - cost;
    const margin = price > 0 ? (profit / price) * 100 : 0;
    document.getElementById('res-price').textContent  = fmt(price);
    document.getElementById('res-profit').textContent = fmt(profit);
    document.getElementById('res-markup').textContent = markupPct.toFixed(1) + '%';
    document.getElementById('res-margin').textContent = margin.toFixed(1) + '%';
  } else {
    const cost = parseFloat(document.getElementById('cost2').value) || 0;
    const price = parseFloat(document.getElementById('sell-price').value) || 0;
    if (cost <= 0 || price <= 0) { clearResults(); return; }
    if (price <= cost) { clearResults(); warn.style.display = 'block'; return; }
    const profit = price - cost;
    const markup = (profit / cost) * 100;
    const margin = (profit / price) * 100;
    document.getElementById('res-price').textContent  = fmt(price);
    document.getElementById('res-profit').textContent = fmt(profit);
    document.getElementById('res-markup').textContent = markup.toFixed(1) + '%';
    document.getElementById('res-margin').textContent = margin.toFixed(1) + '%';
  }
}

document.addEventListener('currencychange', recalc);
recalc();
</script>

<script is:inline>
document.getElementById('embed-code').textContent = '<iframe src="https://foxmargin.com/embed/markup-calculator/" width="100%" height="420" frameborder="0" style="border-radius:8px;border:1px solid #e1e8ed;" title="Markup Calculator — FoxMargin"></iframe>';
function copyEmbed() {
  navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(() => {
    const btn = document.getElementById('embed-copy-btn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = 'Copy Embed Code', 2000);
  });
}
</script>
