---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": [
  { "@type": "WebApplication", "name": "Free Receipt Generator",
    "url": "https://foxmargin.com/receipt-generator/",
    "description": "Create professional receipts online for free. Add your logo, line items, payment method, and get a PAID stamp. Print or save as PDF instantly. No signup.",
    "applicationCategory": "BusinessApplication", "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": ["Free receipt creation", "PDF export", "Logo upload", "PAID stamp", "Partial payment support", "No account required"] },
  { "@type": "FAQPage", "mainEntity": [
    { "@type": "Question", "name": "Is this receipt generator free?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — completely free, no account needed, no watermark. Your logo and data stay in your browser." } },
    { "@type": "Question", "name": "How do I get a PDF receipt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Click Print / Save PDF, then in the print dialog choose Save as PDF as the destination. On Mac, look for the PDF dropdown in the bottom-left of the print dialog. All modern browsers support this natively. Tip: open More settings and turn off Headers and footers so the date and foxmargin.com URL do not appear on your saved receipt." } },
    { "@type": "Question", "name": "Can I add my logo to the receipt?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — click Edit next to your business name, or click My Business in the nav. Your logo is stored in your browser and appears on every document automatically." } },
    { "@type": "Question", "name": "What if a customer partially paid?",
      "acceptedAnswer": { "@type": "Answer", "text": "Enter the amount they actually paid in the Amount Paid field. The receipt will show the balance due and stamp PARTIAL PAYMENT instead of PAID. Issue a follow-up receipt when the remainder is collected." } }
  ]}
]});
---
<Layout
  title="Free Receipt Generator — Create & Print Receipts | FoxMargin"
  description="Create professional receipts online for free. Add your logo, line items, payment method, and get a PAID stamp. Print or save as PDF instantly. No signup."
  schema={schema}
>

  <!-- Hidden inputs: filled by fillDocFromBiz() -->
  <input type="hidden" id="from-name" />
  <input type="hidden" id="from-email" />
  <input type="hidden" id="from-phone" />
  <input type="hidden" id="from-street" />
  <input type="hidden" id="from-city" />
  <input type="hidden" id="from-state" />
  <input type="hidden" id="from-zip" />

  <div class="inv-workspace">

    <!-- ── LEFT: scrollable form ── -->
    <div class="inv-form-col">

      <!-- My Business -->
      <div class="ws-card">
        <div class="ws-card-label">My Business</div>
        <div class="inv-biz-bar">
          <div class="inv-biz-bar-left">
            <img id="inv-biz-logo-thumb" class="inv-biz-logo-thumb" style="display:none;" alt="Logo" />
            <div class="inv-biz-text">
              <div class="inv-biz-name" id="inv-biz-disp-name" style="color:var(--muted);">No profile saved — click Edit to set up</div>
              <div class="inv-biz-meta" id="inv-biz-disp-meta"></div>
            </div>
          </div>
          <button class="ws-edit-btn" onclick="openBizModal()" type="button">Edit ›</button>
        </div>
      </div>

      <!-- Receipt Details -->
      <div class="ws-card">
        <div class="ws-card-label">Receipt Details</div>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field-row">
            <div class="field">
              <label for="rec-date">Date</label>
              <input type="text" id="rec-date" placeholder="YYYY-MM-DD" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="rec-number">Receipt #</label>
              <input type="text" id="rec-number" placeholder="REC-001" oninput="renderPreview()" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="payment-method">Payment Method</label>
              <select id="payment-method" onchange="renderPreview()">
                <option value="Credit Card">Credit Card</option>
                <option value="Debit Card">Debit Card</option>
                <option value="Cash">Cash</option>
                <option value="Bank Transfer">Bank Transfer</option>
                <option value="Check">Check</option>
                <option value="PayPal">PayPal</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="field">
              <label for="amount-paid">Amount Paid</label>
              <input type="text" inputmode="decimal" id="amount-paid" placeholder="Defaults to total" oninput="renderPreview()" />
            </div>
          </div>
          <label style="display:flex;align-items:center;gap:.4rem;margin-top:.15rem;cursor:pointer;">
            <input type="checkbox" id="show-stamp" onchange="localStorage.setItem('rec_show_stamp', this.checked ? '1' : '0'); renderPreview();" style="width:auto;margin:0;accent-color:var(--fox);flex-shrink:0;" />
            <span style="font-size:.8rem;color:var(--muted);user-select:none;">Show payment stamp on receipt</span>
          </label>
        </div>
        <div id="tax-lines" style="margin-top:0.75rem;">
          <div class="tax-row">
            <div class="field">
              <label>Tax Label</label>
              <input type="text" class="tax-name" placeholder="Sales Tax" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label>Rate (%)</label>
              <input type="text" inputmode="decimal" class="tax-pct" placeholder="0" oninput="renderPreview()" />
            </div>
            <div class="tax-remove-placeholder"></div>
          </div>
        </div>
        <button class="ws-add-line-btn" onclick="addTax()" type="button">+ Add Tax</button>
      </div>

      <!-- Receipt For -->
      <div class="ws-card">
        <div class="ws-card-label">Receipt For</div>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field-row">
            <div class="field">
              <label for="to-name">Customer Name / Company</label>
              <input type="text" id="to-name" placeholder="Jane Smith" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="to-email">Email</label>
              <input type="email" id="to-email" placeholder="customer@example.com" oninput="renderPreview()" />
            </div>
          </div>
          <div class="field">
            <label for="to-country">Country</label>
            <select id="to-country" onchange="updateToAddrLabels();renderPreview()">
              <optgroup label="Popular">
                <option value="US">United States</option>
                <option value="CA">Canada</option>
                <option value="GB">United Kingdom</option>
                <option value="AU">Australia</option>
                <option value="NZ">New Zealand</option>
                <option value="IE">Ireland</option>
                <option value="IN">India</option>
                <option value="SG">Singapore</option>
                <option value="ZA">South Africa</option>
                <option value="NG">Nigeria</option>
              </optgroup>
              <optgroup label="Europe">
                <option value="AT">Austria</option>
                <option value="BE">Belgium</option>
                <option value="CH">Switzerland</option>
                <option value="CZ">Czech Republic</option>
                <option value="DE">Germany</option>
                <option value="DK">Denmark</option>
                <option value="ES">Spain</option>
                <option value="FI">Finland</option>
                <option value="FR">France</option>
                <option value="GR">Greece</option>
                <option value="HU">Hungary</option>
                <option value="IT">Italy</option>
                <option value="NL">Netherlands</option>
                <option value="NO">Norway</option>
                <option value="PL">Poland</option>
                <option value="PT">Portugal</option>
                <option value="SE">Sweden</option>
              </optgroup>
              <optgroup label="Americas">
                <option value="AR">Argentina</option>
                <option value="BR">Brazil</option>
                <option value="CL">Chile</option>
                <option value="CO">Colombia</option>
                <option value="MX">Mexico</option>
              </optgroup>
              <optgroup label="Asia &amp; Pacific">
                <option value="AE">United Arab Emirates</option>
                <option value="CN">China</option>
                <option value="HK">Hong Kong</option>
                <option value="ID">Indonesia</option>
                <option value="JP">Japan</option>
                <option value="KR">South Korea</option>
                <option value="MY">Malaysia</option>
                <option value="PH">Philippines</option>
                <option value="TH">Thailand</option>
                <option value="TR">Turkey</option>
              </optgroup>
              <optgroup label="Africa &amp; Middle East">
                <option value="EG">Egypt</option>
                <option value="GH">Ghana</option>
                <option value="IL">Israel</option>
                <option value="KE">Kenya</option>
                <option value="SA">Saudi Arabia</option>
              </optgroup>
            </select>
          </div>
          <div class="field">
            <label for="to-street">Street Address</label>
            <input type="text" id="to-street" placeholder="456 Customer Ave" autocomplete="off" oninput="renderPreview()" />
          </div>
          <div class="addr-grid">
            <div class="field"><label for="to-city">City</label><input type="text" id="to-city" placeholder="City" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field" id="field-to-state"><label id="lbl-to-state" for="to-state">State</label><input type="text" id="to-state" placeholder="TX" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field" id="field-to-zip"><label id="lbl-to-zip" for="to-zip">ZIP Code</label><input type="text" id="to-zip" placeholder="10001" autocomplete="off" oninput="renderPreview()" /></div>
          </div>
          <div style="display:flex;gap:.4rem;align-items:center;margin-top:.25rem;flex-wrap:wrap;">
            <button type="button" onclick="saveRecipient()" style="font-size:.78rem;padding:.35rem .7rem;background:#fff;border:1px solid var(--border);border-radius:6px;cursor:pointer;">💾 Save customer</button>
            <select id="client-picker" onchange="loadRecipient(this.value)" style="font-size:.78rem;padding:.35rem .5rem;border:1px solid var(--border);border-radius:6px;">
              <option value="">Recent customers…</option>
            </select>
            <span id="client-msg" style="font-size:.74rem;color:var(--muted);"></span>
          </div>
        </div>
      </div>

      <!-- Items -->
      <div class="ws-card">
        <div class="ws-card-label">Items</div>
        <div id="line-items">
          <div class="li-card">
            <div class="field">
              <label>Description</label>
              <input type="text" class="li-description" placeholder="Product or service" oninput="renderPreview()" />
            </div>
            <div class="li-bottom-row">
              <div class="field li-field-sm">
                <label>Qty</label>
                <input type="text" inputmode="decimal" class="li-qty-val" placeholder="1" value="1" oninput="renderPreview()" />
              </div>
              <div class="field li-field-md">
                <label>Price</label>
                <input type="text" inputmode="decimal" class="li-rate-val" placeholder="0.00" oninput="renderPreview()" />
              </div>
              <div class="li-total-block">
                <div class="li-total-label">Total</div>
                <div class="li-total-val inv-li-total">—</div>
              </div>
              <div class="li-remove-placeholder"></div>
            </div>
          </div>
        </div>
        <button class="ws-add-line-btn" onclick="addLine()" type="button">+ Add Item</button>
      </div>

      <!-- Notes -->
      <div class="ws-card">
        <div class="ws-card-label">Notes</div>
        <div class="field">
          <textarea id="notes" placeholder="e.g. Thank you for your business!" rows="3" oninput="renderPreview()"></textarea>
        </div>
      </div>

    </div>

    <!-- ── RIGHT: sticky paper ── -->
    <div class="inv-paper-col">
      <div class="inv-paper-actions">
        <span class="inv-paper-label">Live Preview</span>
        <div style="display:flex;gap:0.4rem;align-items:center;">
          <button onclick="emailDoc({kind:'Receipt',numberId:'rec-number',eventName:'email_receipt'})" type="button" style="font-size:0.82rem;padding:0.45rem 0.9rem;background:#fff;color:var(--text);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-weight:500;">📧 Email</button>
          <button class="btn" onclick="track('print_receipt');window.print()" type="button" style="font-size:0.82rem;padding:0.45rem 1rem;">Print / Save PDF</button>
        </div>
      </div>
      <div class="inv-paper" id="doc-paper"></div>
    </div>

  </div>

  <div class="ws-card print-hide" style="margin-top:2rem;">
    <div class="ws-card-label">Frequently Asked Questions</div>
    <p style="font-size:0.88rem;color:var(--muted);margin-bottom:1.25rem;line-height:1.55;">Common questions about creating, customizing, and saving receipts with FoxMargin.</p>
    <details>
      <summary>Is this receipt generator free?</summary>
      <p>Yes — completely free, no account needed, no watermark. Your logo and data stay in your browser.</p>
    </details>
    <details>
      <summary>How do I get a PDF receipt?</summary>
      <p>Click "Print / Save PDF," then in the print dialog choose "Save as PDF" as the destination. On Mac, look for the PDF dropdown in the bottom-left of the print dialog. All modern browsers support this natively.</p>
      <p><strong>Tip:</strong> open <em>More settings</em> in the print dialog and turn off "Headers and footers" — otherwise the date and foxmargin.com URL will appear at the top/bottom of your saved receipt.</p>
    </details>
    <details>
      <summary>Can I add my logo?</summary>
      <p>Yes — click "Edit ›" next to your business name, or click "My Business" in the nav. Your logo is stored in your browser and appears on every document automatically.</p>
    </details>
    <details>
      <summary>What if a customer partially paid?</summary>
      <p>Enter the amount they actually paid in the "Amount Paid" field. The receipt will show the balance due and stamp "PARTIAL PAYMENT" instead of "PAID." Issue a follow-up receipt when the remainder is collected.</p>
    </details>
  </div>

  <div class="ws-card print-hide">
    <div class="ws-card-label">Embed This Receipt Generator</div>
    <p style="font-size:0.88rem;color:var(--muted);margin-bottom:1.25rem;line-height:1.55;">Free to use on your website or blog. Paste one line of HTML — no account or backend needed.</p>
    <pre id="embed-code" style="background:var(--bg);border:1.5px solid var(--border);border-radius:7px;padding:0.85rem 1rem;font-size:0.78rem;overflow-x:auto;white-space:pre-wrap;word-break:break-all;color:var(--muted);line-height:1.6;margin-bottom:0.75rem;"></pre>
    <button id="embed-copy-btn" onclick="copyEmbed()" class="btn" style="font-size:0.85rem;padding:0.5rem 1rem;">Copy Embed Code</button>
  </div>

</Layout>


<script is:inline>
(function() {
  const today = new Date();
  const fmtD = d => d.toISOString().slice(0, 10);
  document.getElementById('rec-date').value   = fmtD(today);
  document.getElementById('rec-number').value = 'REC-001';

  const stampCb = document.getElementById('show-stamp');
  if (stampCb) stampCb.checked = (localStorage.getItem('rec_show_stamp') ?? '1') === '1';

  document.addEventListener('currencychange', renderPreview);

  fillDocFromBiz();

  if (!localStorage.getItem('biz_setup_done')) setTimeout(openBizModal, 400);

  renderPreview();
})();

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function fmt(n) {
  const c = window.__currency || { locale: 'en-US', code: 'USD' };
  return new Intl.NumberFormat(c.locale, { style: 'currency', currency: c.code, minimumFractionDigits: 2 }).format(n);
}

function addrLines(street, city, state, zip) {
  const line2 = [city, state].filter(Boolean).join(', ') + (zip ? ' ' + zip : '');
  return [street, line2].filter(Boolean);
}

function getLineItems() {
  return Array.from(document.querySelectorAll('#line-items .li-card')).map(card => {
    const qty  = parseFloat(card.querySelector('.li-qty-val')?.value)  || 0;
    const rate = parseFloat(card.querySelector('.li-rate-val')?.value) || 0;
    return { desc: card.querySelector('.li-description')?.value || '', qty, rate, total: qty * rate };
  }).filter(r => r.desc || r.total > 0);
}

function updateLineTotals() {
  document.querySelectorAll('#line-items .li-card').forEach(card => {
    const qty  = parseFloat(card.querySelector('.li-qty-val')?.value)  || 0;
    const rate = parseFloat(card.querySelector('.li-rate-val')?.value) || 0;
    const el   = card.querySelector('.inv-li-total');
    if (el) el.textContent = (qty && rate) ? fmt(qty * rate) : '—';
  });
}

function fillDocFromBiz() {
  const get = k => localStorage.getItem(k) || '';
  const name = get('biz_name'), email = get('biz_email'), phone = get('biz_phone');
  const street = get('biz_street'), city = get('biz_city'), state = get('biz_state'), zip = get('biz_zip');
  const logo = get('biz_logo');

  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
  set('from-name', name); set('from-email', email); set('from-phone', phone);
  set('from-street', street); set('from-city', city); set('from-state', state); set('from-zip', zip);

  const dispName  = document.getElementById('inv-biz-disp-name');
  const dispMeta  = document.getElementById('inv-biz-disp-meta');
  const logoThumb = document.getElementById('inv-biz-logo-thumb');
  if (dispName) { dispName.textContent = name || 'No profile saved — click Edit to set up'; dispName.style.color = name ? 'var(--text)' : 'var(--muted)'; }
  if (dispMeta) { const p = []; if (phone) p.push(phone); if (email) p.push(email); dispMeta.textContent = p.join('  ·  '); }
  if (logoThumb) { if (logo) { logoThumb.src = logo; logoThumb.style.display = 'block'; } else { logoThumb.style.display = 'none'; } }

  renderPreview();
}

function updateToAddrLabels() {
  var code = (document.getElementById('to-country')?.value || 'US');
  var cfg  = (typeof ADDR_CONFIG !== 'undefined' ? ADDR_CONFIG[code] : null) || { regionLabel: 'State / Region', regionPh: '', postalLabel: 'Postal Code', postalPh: '' };
  var lblState = document.getElementById('lbl-to-state');
  var lblZip   = document.getElementById('lbl-to-zip');
  var fldState = document.getElementById('field-to-state');
  var fldZip   = document.getElementById('field-to-zip');
  var inpState = document.getElementById('to-state');
  var inpZip   = document.getElementById('to-zip');
  if (cfg.regionLabel) {
    if (fldState) fldState.style.display = '';
    if (lblState) lblState.textContent = cfg.regionLabel;
    if (inpState) inpState.placeholder  = cfg.regionPh;
  } else {
    if (fldState) fldState.style.display = 'none';
    if (inpState) inpState.value = '';
  }
  if (cfg.postalLabel) {
    if (fldZip) fldZip.style.display = '';
    if (lblZip) lblZip.textContent = cfg.postalLabel;
    if (inpZip) inpZip.placeholder  = cfg.postalPh;
  } else {
    if (fldZip) fldZip.style.display = 'none';
    if (inpZip) inpZip.value = '';
  }
}

function buildLineRow(desc, qty, rate, removable) {
  const card = document.createElement('div');
  card.className = 'li-card';
  const total = (parseFloat(qty) || 0) * (parseFloat(rate) || 0);
  card.innerHTML = `
    <div class="field">
      <label>Description</label>
      <input type="text" class="li-description" placeholder="Product or service" oninput="renderPreview()" value="${esc(desc || '')}" />
    </div>
    <div class="li-bottom-row">
      <div class="field li-field-sm">
        <label>Qty</label>
        <input type="text" inputmode="decimal" class="li-qty-val" placeholder="1" value="${qty || 1}" oninput="renderPreview()" />
      </div>
      <div class="field li-field-md">
        <label>Price</label>
        <input type="text" inputmode="decimal" class="li-rate-val" placeholder="0.00" value="${rate || ''}" oninput="renderPreview()" />
      </div>
      <div class="li-total-block">
        <div class="li-total-label">Total</div>
        <div class="li-total-val inv-li-total">${total > 0 ? fmt(total) : '—'}</div>
      </div>
      ${removable
        ? '<button class="li-remove-btn" onclick="this.closest(\'.li-card\').remove();renderPreview();" type="button" title="Remove line">×</button>'
        : '<div class="li-remove-placeholder"></div>'}
    </div>
  `;
  return card;
}

function addLine() {
  const container = document.getElementById('line-items');
  const card = buildLineRow('', 1, '', true);
  container.appendChild(card);
  card.querySelector('.li-description').focus();
}

function getTaxLines() {
  return Array.from(document.querySelectorAll('#tax-lines .tax-row')).map(row => {
    const label = (row.querySelector('.tax-name')?.value || '').trim();
    const rate  = parseFloat(row.querySelector('.tax-pct')?.value) || 0;
    return { label: label || 'Tax', rate };
  });
}

function buildTaxRow(label, rate) {
  const row = document.createElement('div');
  row.className = 'tax-row';
  row.innerHTML = `
    <div class="field">
      <label>Tax Label</label>
      <input type="text" class="tax-name" value="${esc(label)}" placeholder="Sales Tax" oninput="renderPreview()" />
    </div>
    <div class="field">
      <label>Rate (%)</label>
      <input type="text" inputmode="decimal" class="tax-pct" placeholder="0" value="${esc(String(rate))}" oninput="renderPreview()" />
    </div>
    <button class="li-remove-btn" onclick="this.closest('.tax-row').remove();renderPreview();" type="button" title="Remove tax">×</button>
  `;
  return row;
}

function addTax() {
  const container = document.getElementById('tax-lines');
  const row = buildTaxRow('', 0);
  container.appendChild(row);
  row.querySelector('.tax-name').focus();
}

function renderPreview() {
  updateLineTotals();

  const items    = getLineItems();
  const subtotal = items.reduce((s, r) => s + r.total, 0);
  const taxes    = getTaxLines().filter(t => t.rate > 0);
  const taxTotal = taxes.reduce((s, t) => s + subtotal * (t.rate / 100), 0);
  const total    = subtotal + taxTotal;

  const apRaw      = document.getElementById('amount-paid')?.value || '';
  const amountPaid = apRaw.trim() !== '' ? (parseFloat(apRaw) || 0) : total;
  const balance    = total - amountPaid;
  const isPaid     = total > 0 && balance <= 0.005;
  const isPartial  = !isPaid && amountPaid > 0;

  const fromName   = (document.getElementById('from-name')?.value   || '').trim();
  const fromEmail  = (document.getElementById('from-email')?.value  || '').trim();
  const fromPhone  = (document.getElementById('from-phone')?.value  || '').trim();
  const fromAddr   = addrLines(
    (document.getElementById('from-street')?.value || '').trim(),
    (document.getElementById('from-city')?.value   || '').trim(),
    (document.getElementById('from-state')?.value  || '').trim(),
    (document.getElementById('from-zip')?.value    || '').trim()
  );
  const bizCountryName = localStorage.getItem('biz_country_name') || '';
  if (localStorage.getItem('biz_show_country') === '1' && bizCountryName) fromAddr.push(bizCountryName);
  const toName  = (document.getElementById('to-name')?.value  || '').trim();
  const toEmail = (document.getElementById('to-email')?.value || '').trim();
  const toAddr  = addrLines(
    (document.getElementById('to-street')?.value || '').trim(),
    (document.getElementById('to-city')?.value   || '').trim(),
    (document.getElementById('to-state')?.value  || '').trim(),
    (document.getElementById('to-zip')?.value    || '').trim()
  );
  const recNum    = document.getElementById('rec-number')?.value || 'REC-001';
  const recDate   = document.getElementById('rec-date')?.value   || '';
  const payMethod = document.getElementById('payment-method')?.value || '';
  const notes     = (document.getElementById('notes')?.value || '').trim();
  const logo      = localStorage.getItem('biz_logo');

  const navy   = localStorage.getItem('biz_primary_color') || '#0f2d52';
  const fox    = localStorage.getItem('biz_accent_color')  || '#d4500a';
  const muted  = '#6b7c93';
  const border = '#e8ecf2';
  const bg     = '#f5f7fa';

  const lineRows = items.length
    ? items.map((r, i) => `
        <tr style="background:${i % 2 === 0 ? '#fff' : '#fafbfd'};">
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};font-size:.88em;color:#1a2332;">${esc(r.desc)}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:center;font-size:.88em;color:${muted};">${r.qty}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:right;font-size:.88em;color:${muted};">${fmt(r.rate)}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:right;font-size:.9em;font-weight:600;color:#1a2332;">${fmt(r.total)}</td>
        </tr>`).join('')
    : `<tr><td colspan="4" style="padding:1.5rem .7rem;text-align:center;font-size:.85em;color:#c0c8d4;font-style:italic;">Add an item to get started</td></tr>`;

  const showStamp = document.getElementById('show-stamp')?.checked ?? true;
  const stampHTML = (!showStamp || total <= 0)
    ? ''
    : isPaid
      ? `<div style="display:inline-block;border:3px solid #059669;border-radius:5px;color:#059669;font-size:1.5em;font-weight:900;letter-spacing:.12em;padding:.2em .9em;transform:rotate(-4deg);opacity:.88;">PAID</div>`
      : isPartial
        ? `<div style="display:inline-block;border:3px solid #d97706;border-radius:5px;color:#d97706;font-size:1.2em;font-weight:900;letter-spacing:.12em;padding:.2em .9em;transform:rotate(-4deg);opacity:.88;">PARTIAL PAYMENT</div>`
        : `<div style="display:inline-block;border:3px solid #d97706;border-radius:5px;color:#d97706;font-size:1.5em;font-weight:900;letter-spacing:.12em;padding:.2em .9em;transform:rotate(-4deg);opacity:.88;">UNPAID</div>`;

  document.getElementById('doc-paper').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.75rem;gap:1rem;">
      <div style="flex:1;min-width:0;">
        ${logo ? `<img src="${logo}" style="max-height:56px;max-width:170px;object-fit:contain;display:block;margin-bottom:.65rem;" alt="logo" />` : ''}
        ${fromName
          ? `<div style="font-size:1.08em;font-weight:700;color:${navy};margin-bottom:.18em;line-height:1.3;">${esc(fromName)}</div>`
          : `<div style="font-size:1.08em;font-weight:700;color:#d0d7e2;line-height:1.3;">Your Business Name</div>`}
        ${fromAddr.map(l => `<div style="font-size:.84em;color:${muted};line-height:1.55;">${esc(l)}</div>`).join('')}
        ${fromPhone ? `<div style="font-size:.84em;color:${muted};">${esc(fromPhone)}</div>` : ''}
        ${fromEmail ? `<div style="font-size:.84em;color:${muted};">${esc(fromEmail)}</div>` : ''}
      </div>
      <div style="text-align:right;flex-shrink:0;">
        <div style="font-size:2em;font-weight:800;color:${navy};letter-spacing:-.02em;line-height:1;margin-bottom:.4em;">RECEIPT</div>
        <div style="display:inline-block;background:${bg};border:1px solid ${border};border-radius:5px;padding:.3em .7em;text-align:left;">
          <div style="font-size:.78em;color:${muted};margin-bottom:.15em;">Receipt #</div>
          <div style="font-size:.95em;font-weight:700;color:${navy};">${esc(recNum)}</div>
          ${recDate   ? `<div style="font-size:.75em;color:${muted};margin-top:.25em;">Date: ${esc(recDate)}</div>` : ''}
          ${payMethod ? `<div style="font-size:.75em;color:${muted};">Payment: ${esc(payMethod)}</div>` : ''}
        </div>
      </div>
    </div>

    <div style="height:1px;background:${border};margin-bottom:1.4rem;"></div>

    <div style="margin-bottom:1.5rem;">
      <div style="font-size:.68em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.45em;">Receipt For</div>
      ${toName
        ? `<div style="font-size:1em;font-weight:600;color:#1a2332;margin-bottom:.2em;">${esc(toName)}</div>`
        : `<div style="font-size:1em;color:#d0d7e2;font-style:italic;">Customer name</div>`}
      ${toEmail ? `<div style="font-size:.85em;color:${muted};">${esc(toEmail)}</div>` : ''}
      ${toAddr.map(l => `<div style="font-size:.85em;color:${muted};line-height:1.5;">${esc(l)}</div>`).join('')}
    </div>

    <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;border-radius:6px;overflow:hidden;">
      <thead>
        <tr style="background:${navy};">
          <th style="padding:.55rem .7rem;text-align:left;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;">Description</th>
          <th style="padding:.55rem .7rem;text-align:center;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Qty</th>
          <th style="padding:.55rem .7rem;text-align:right;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Price</th>
          <th style="padding:.55rem .7rem;text-align:right;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Total</th>
        </tr>
      </thead>
      <tbody>${lineRows}</tbody>
    </table>

    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;">
      <div>${stampHTML}</div>
      <div style="width:240px;">
        <div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.87em;color:${muted};border-bottom:1px solid ${border};"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
        ${taxes.map(t => `<div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.87em;color:${muted};border-bottom:1px solid ${border};"><span>${esc(t.label)} (${t.rate}%)</span><span>${fmt(subtotal * t.rate / 100)}</span></div>`).join('')}
        <div style="display:flex;justify-content:space-between;padding:.55rem 0 .35rem;font-size:1.05em;font-weight:700;color:${navy};margin-top:.1rem;border-bottom:1px solid ${border};"><span>Total</span><span>${fmt(total)}</span></div>
        <div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.87em;color:${muted};"><span>Amount Paid</span><span>${fmt(amountPaid)}</span></div>
        <div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.9em;font-weight:600;color:${isPaid ? '#059669' : '#dc2626'};"><span>Balance Due</span><span>${fmt(Math.max(0, balance))}</span></div>
      </div>
    </div>

    ${notes ? `
    <div style="margin-top:1.75rem;padding:1rem 1.1rem;background:${bg};border-radius:7px;border:1px solid ${border};">
      <div style="font-size:.68em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.5em;">Notes</div>
      <div style="font-size:.84em;color:${muted};line-height:1.6;white-space:pre-wrap;">${esc(notes)}</div>
    </div>` : ''}
  `;
}
</script>

<script is:inline>
document.getElementById('embed-code').textContent = '<iframe src="https://foxmargin.com/embed/receipt-generator/" width="100%" height="680" frameborder="0" style="border-radius:8px;border:1px solid #e1e8ed;" title="Free Receipt Generator — FoxMargin"></iframe>';
function copyEmbed() {
  navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(() => {
    const btn = document.getElementById('embed-copy-btn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = 'Copy Embed Code', 2000);
  });
}
</script>
</content>
