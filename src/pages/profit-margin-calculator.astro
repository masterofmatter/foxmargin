---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": [
  { "@type": "WebApplication", "name": "Profit Margin Calculator",
    "url": "https://foxmargin.com/profit-margin-calculator/",
    "description": "Calculate gross profit margin, net margin, and profit instantly. Enter revenue and cost to see your margin percentage. Free, no signup.",
    "applicationCategory": "FinanceApplication", "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": ["Gross margin calculation", "Net margin calculation", "Live results", "No account required"] },
  { "@type": "FAQPage", "mainEntity": [
    { "@type": "Question", "name": "What is the difference between margin and markup?",
      "acceptedAnswer": { "@type": "Answer", "text": "Margin is calculated from revenue (what you sell for). Markup is calculated from cost (what you paid). A 50% markup on a $10 cost = $15 price = 33% margin." } },
    { "@type": "Question", "name": "Is 30% profit margin good?",
      "acceptedAnswer": { "@type": "Answer", "text": "30% gross margin is average for retail and reasonable for most product businesses. For services, aim for 40–60% gross margin. Net margin of 10% or more is generally considered healthy." } },
    { "@type": "Question", "name": "How do I improve my profit margin?",
      "acceptedAnswer": { "@type": "Answer", "text": "Two levers: raise prices (hardest psychologically but highest impact) or reduce COGS through better supplier terms, bulk purchasing, or more efficient production. Cutting operating expenses helps net margin but won't move gross margin." } },
    { "@type": "Question", "name": "Does this calculator include tax?",
      "acceptedAnswer": { "@type": "Answer", "text": "No — this calculates pre-tax margin. To get after-tax net margin, subtract your tax rate from the net profit figure before dividing by revenue." } }
  ]}
]});
---
<Layout
  title="Profit Margin Calculator — Free | FoxMargin"
  description="Calculate gross profit margin, net margin, and profit instantly. Enter revenue and cost to see your margin percentage. Free, no signup."
  schema={schema}
>
  <!-- Hero -->
  <section class="calc-hero">
    <h1>Profit Margin Calculator</h1>
    <p class="calc-hero-sub">Enter your revenue and costs to see gross profit margin and net profit. Results update live as you type.</p>
  </section>

  <!-- Calculator workspace -->
  <div class="calc-workspace">
    <!-- Inputs -->
    <div class="ws-card">
      <div class="ws-card-label">Inputs</div>
      <div class="calc-form" style="gap:0.75rem;">
        <div class="field-row">
          <div class="field">
            <label for="revenue">Revenue</label>
            <input type="number" id="revenue" placeholder="e.g. 10000" min="0" step="0.01" oninput="recalc()" />
          </div>
          <div class="field">
            <label for="cost">Cost of Goods</label>
            <input type="number" id="cost" placeholder="e.g. 6000" min="0" step="0.01" oninput="recalc()" />
          </div>
        </div>
        <div class="field">
          <label for="operating">Operating Expenses <span class="opt-tag">optional</span></label>
          <input type="number" id="operating" placeholder="e.g. 1500" min="0" step="0.01" oninput="recalc()" />
        </div>
      </div>
    </div>

    <!-- Results -->
    <div class="ws-card">
      <div class="ws-card-label">Results</div>
      <div class="calc-results-grid">
        <div class="calc-result-item primary">
          <div class="calc-result-value" id="gross-margin">—</div>
          <div class="calc-result-label">Gross Margin</div>
        </div>
        <div class="calc-result-item">
          <div class="calc-result-value" id="gross-profit">—</div>
          <div class="calc-result-label">Gross Profit</div>
        </div>
        <div class="calc-result-item primary">
          <div class="calc-result-value" id="net-margin">—</div>
          <div class="calc-result-label">Net Margin</div>
        </div>
        <div class="calc-result-item">
          <div class="calc-result-value" id="net-profit">—</div>
          <div class="calc-result-label">Net Profit</div>
        </div>
      </div>
    </div>
  </div>

  <!-- About / Formula / Benchmarks -->
  <div class="ws-card">
    <div class="ws-card-label">About Profit Margin</div>
    <p class="ws-body">Profit margin measures how much of every dollar of revenue your business keeps as profit after expenses. There are two types most businesses track:</p>
    <ul class="ws-list">
      <li><strong>Gross margin</strong> — Revenue minus cost of goods sold (COGS), before operating expenses.</li>
      <li><strong>Net margin</strong> — What's left after all expenses including operating costs.</li>
    </ul>
    <p class="ws-body">A 20% gross margin means you keep $0.20 of every $1.00 in revenue before operating costs.</p>

    <div class="ws-card-label" style="margin-top:1.5rem;">Formula</div>
    <div class="formula-box">
      <p><strong>Gross Margin %</strong> = (Revenue − COGS) ÷ Revenue × 100</p>
      <p><strong>Net Margin %</strong> = (Revenue − COGS − Operating Expenses) ÷ Revenue × 100</p>
    </div>

    <div class="ws-card-label" style="margin-top:1.5rem;">Typical Margins by Industry</div>
    <table class="bench-table">
      <thead><tr><th>Industry</th><th>Typical Gross Margin</th></tr></thead>
      <tbody>
        <tr><td>Software / SaaS</td><td>70–85%</td></tr>
        <tr><td>Professional Services</td><td>30–50%</td></tr>
        <tr><td>Retail</td><td>20–40%</td></tr>
        <tr><td>Restaurant</td><td>60–70% gross / 3–9% net</td></tr>
        <tr><td>Manufacturing</td><td>20–35%</td></tr>
        <tr><td>Construction</td><td>15–25%</td></tr>
      </tbody>
    </table>
  </div>

  <!-- FAQ -->
  <div class="ws-card">
    <div class="ws-card-label">Frequently Asked Questions</div>
    <details>
      <summary>What's the difference between margin and markup?</summary>
      <p>Margin is calculated from revenue (what you sell for). Markup is calculated from cost (what you paid). A 50% markup on a $10 cost = $15 price = 33% margin. Use our <a href="/markup-calculator/">Markup Calculator</a> to convert between them.</p>
    </details>
    <details>
      <summary>Is 30% profit margin good?</summary>
      <p>30% gross margin is average for retail and reasonable for most product businesses. For services, you should aim higher — 40–60% gross margin gives you enough to cover operating costs and still profit. Net margin of 10% or more is generally considered healthy.</p>
    </details>
    <details>
      <summary>How do I improve my profit margin?</summary>
      <p>Two levers: raise prices (hardest psychologically but highest impact) or reduce COGS through better supplier terms, bulk purchasing, or more efficient production. Cutting operating expenses helps net margin but won't move gross margin.</p>
    </details>
    <details>
      <summary>Does this calculator include tax?</summary>
      <p>No — this calculates pre-tax margin. To get after-tax net margin, subtract your tax rate from the net profit figure before dividing by revenue.</p>
    </details>
  </div>

  <!-- Embed -->
  <div class="ws-card">
    <div class="ws-card-label">Embed This Calculator</div>
    <p class="ws-body">Free to use on your website or blog. Paste one line of HTML — no account or backend needed.</p>
    <pre id="embed-code" class="embed-code"></pre>
    <button id="embed-copy-btn" onclick="copyEmbed()" class="btn" style="font-size:0.85rem;padding:0.5rem 1rem;">Copy Embed Code</button>
  </div>
</Layout>

<style>
  /* ── Calculator hero ── */
  .calc-hero {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.85rem 2.25rem;
    margin-bottom: 1.25rem;
  }
  .calc-hero h1 {
    font-size: 1.75rem;
    color: var(--navy);
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .calc-hero-sub { font-size: 0.95rem; color: var(--muted); line-height: 1.55; margin: 0; }
  @media (max-width: 600px) {
    .calc-hero { padding: 1.5rem 1.5rem; }
    .calc-hero h1 { font-size: 1.45rem; }
  }

  /* ── Calculator workspace ── */
  .calc-workspace {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 760px) { .calc-workspace { grid-template-columns: 1fr; } }

  /* ── Result tiles ── */
  .calc-results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .calc-result-item {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 1.1rem 1rem;
    text-align: center;
  }
  .calc-result-item.primary { background: #fff8f5; border-color: #f5d6c4; }
  .calc-result-value {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }
  .calc-result-item.primary .calc-result-value { color: var(--fox); }
  .calc-result-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  /* ── Optional label tag ── */
  .opt-tag { font-weight: 400; color: var(--muted); font-size: 0.78em; margin-left: 0.25rem; }

  /* ── Inline body inside ws-cards ── */
  .ws-body { font-size: 0.92rem; color: var(--muted); line-height: 1.6; margin: 0 0 0.85rem; }
  .ws-list { margin: 0 0 0.85rem 1.2rem; color: var(--muted); font-size: 0.92rem; line-height: 1.75; }
  .ws-list strong { color: var(--text); }

  /* ── Formula box ── */
  .formula-box {
    background: #fff8f5;
    border-left: 3px solid var(--fox);
    padding: 0.85rem 1rem;
    border-radius: 0 7px 7px 0;
    font-family: 'SF Mono', Menlo, monospace;
    font-size: 0.87rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--text);
  }
  .formula-box strong { color: var(--navy); }

  /* ── Benchmark table ── */
  .bench-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  .bench-table th {
    background: var(--navy); color: #fff; padding: 0.55rem 0.85rem;
    text-align: left; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600;
  }
  .bench-table td { padding: 0.55rem 0.85rem; border-bottom: 1px solid var(--border); color: var(--muted); }
  .bench-table tr:last-child td { border-bottom: none; }

  /* ── Embed code block ── */
  .embed-code {
    background: var(--bg); border: 1.5px solid var(--border); border-radius: 7px;
    padding: 0.85rem 1rem; font-size: 0.78rem; overflow-x: auto;
    white-space: pre-wrap; word-break: break-all; color: var(--muted);
    line-height: 1.6; margin-bottom: 0.75rem;
  }
</style>

<script is:inline>
function fmt(n, d) {
  if (typeof d !== 'number') d = 0;
  const c = window.__currency || { locale: 'en-US', code: 'USD' };
  return new Intl.NumberFormat(c.locale, { style: 'currency', currency: c.code, minimumFractionDigits: d, maximumFractionDigits: d }).format(n);
}
function fmtPct(n) { return n.toFixed(1) + '%'; }

function recalc() {
  const revenue   = parseFloat(document.getElementById('revenue').value)   || 0;
  const cost      = parseFloat(document.getElementById('cost').value)      || 0;
  const operating = parseFloat(document.getElementById('operating').value) || 0;

  const set = (id, v) => document.getElementById(id).textContent = v;

  if (revenue <= 0) {
    set('gross-margin', '—'); set('gross-profit', '—'); set('net-margin', '—'); set('net-profit', '—');
    return;
  }

  const grossProfit = revenue - cost;
  const grossMargin = (grossProfit / revenue) * 100;
  const netProfit   = grossProfit - operating;
  const netMargin   = (netProfit / revenue) * 100;

  set('gross-margin', fmtPct(grossMargin));
  set('gross-profit', fmt(grossProfit));
  set('net-margin',   fmtPct(netMargin));
  set('net-profit',   fmt(netProfit));
}

document.addEventListener('currencychange', recalc);
recalc();
</script>

<script is:inline>
document.getElementById('embed-code').textContent = '<iframe src="https://foxmargin.com/embed/profit-margin-calculator/" width="100%" height="450" frameborder="0" style="border-radius:8px;border:1px solid #e1e8ed;" title="Profit Margin Calculator — FoxMargin"></iframe>';
function copyEmbed() {
  navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(() => {
    const btn = document.getElementById('embed-copy-btn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = 'Copy Embed Code', 2000);
  });
}
</script>