---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Free Invoice Generator — Create & Print Invoices | FoxMargin"
  description="Create professional invoices online for free. Add line items, tax, and your logo. Print or save as PDF instantly. No signup required."
>

  <!-- Hidden inputs: filled by fillDocFromBiz() and quote conversion -->
  <input type="hidden" id="from-name" />
  <input type="hidden" id="from-email" />
  <input type="hidden" id="from-phone" />
  <input type="hidden" id="from-street" />
  <input type="hidden" id="from-city" />
  <input type="hidden" id="from-state" />
  <input type="hidden" id="from-zip" />

  <div class="inv-workspace">

    <!-- ── LEFT: scrollable form ── -->
    <div class="inv-form-col">

      <!-- My Business -->
      <div class="ws-card">
        <div class="ws-card-label">My Business</div>
        <div class="inv-biz-bar">
          <div class="inv-biz-bar-left">
            <img id="inv-biz-logo-thumb" class="inv-biz-logo-thumb" style="display:none;" alt="Logo" />
            <div class="inv-biz-text">
              <div class="inv-biz-name" id="inv-biz-disp-name" style="color:var(--muted);">No profile saved — click Edit to set up</div>
              <div class="inv-biz-meta" id="inv-biz-disp-meta"></div>
            </div>
          </div>
          <button class="ws-edit-btn" onclick="openBizModal()" type="button">Edit ›</button>
        </div>
      </div>

      <!-- Invoice Details -->
      <div class="ws-card">
        <div class="ws-card-label">Invoice Details</div>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field-row">
            <div class="field">
              <label for="inv-number">Invoice #</label>
              <input type="text" id="inv-number" placeholder="INV-001" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="inv-date">Date</label>
              <input type="date" id="inv-date" onchange="renderPreview()" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="due-date">Due Date</label>
              <input type="date" id="due-date" onchange="renderPreview()" />
            </div>
            <div class="field">
              <label for="tax-rate">Tax Rate (%)</label>
              <input type="number" id="tax-rate" placeholder="0" min="0" max="100" step="0.01" value="0" oninput="renderPreview()" />
            </div>
          </div>
        </div>
      </div>

      <!-- Bill To -->
      <div class="ws-card">
        <div class="ws-card-label">Bill To</div>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field-row">
            <div class="field">
              <label for="to-name">Client Name / Company</label>
              <input type="text" id="to-name" placeholder="Client Co." oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="to-email">Email</label>
              <input type="email" id="to-email" placeholder="client@example.com" oninput="renderPreview()" />
            </div>
          </div>
          <div class="field">
            <label for="to-street">Street Address</label>
            <input type="text" id="to-street" placeholder="456 Client Ave" autocomplete="off" oninput="renderPreview()" />
          </div>
          <div class="addr-grid">
            <div class="field"><label for="to-city">City</label><input type="text" id="to-city" placeholder="City" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field"><label for="to-state">Region</label><input type="text" id="to-state" placeholder="ST" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field"><label for="to-zip">Postal</label><input type="text" id="to-zip" placeholder="00000" autocomplete="off" oninput="renderPreview()" /></div>
          </div>
        </div>
      </div>

      <!-- Line Items -->
      <div class="ws-card">
        <div class="ws-card-label">Line Items</div>
        <div id="line-items">
          <div class="li-card">
            <div class="field">
              <label>Description</label>
              <input type="text" class="li-description" placeholder="Service or product description" oninput="renderPreview()" />
            </div>
            <div class="li-bottom-row">
              <div class="field li-field-sm">
                <label>Qty</label>
                <input type="text" inputmode="decimal" class="li-qty-val" placeholder="1" value="1" oninput="renderPreview()" />
              </div>
              <div class="field li-field-md">
                <label>Rate</label>
                <input type="text" inputmode="decimal" class="li-rate-val" placeholder="0.00" oninput="renderPreview()" />
              </div>
              <div class="li-total-block">
                <div class="li-total-label">Total</div>
                <div class="li-total-val inv-li-total">—</div>
              </div>
              <div class="li-remove-placeholder"></div>
            </div>
          </div>
        </div>
        <button class="ws-add-line-btn" onclick="addLine()" type="button">+ Add Line</button>
      </div>

      <!-- Notes / Payment Terms -->
      <div class="ws-card">
        <div class="ws-card-label">Notes / Payment Terms</div>
        <div class="field">
          <textarea id="notes" placeholder="e.g. Payment due within 30 days. Bank transfer to: BSB 000-000, Acct 12345678. Thank you for your business." rows="4" oninput="renderPreview()"></textarea>
        </div>
      </div>

    </div>

    <!-- ── RIGHT: sticky paper ── -->
    <div class="inv-paper-col">
      <div class="inv-paper-actions">
        <span class="inv-paper-label">Live Preview</span>
        <button class="btn" onclick="window.print()" style="font-size:0.82rem;padding:0.45rem 1rem;">Print / Save PDF</button>
      </div>
      <div class="inv-paper" id="invoice-paper"></div>
    </div>

  </div>

  <div class="card print-hide" style="margin-top:2rem;">
    <h2>Frequently Asked Questions</h2>
    <details>
      <summary>Is this invoice generator really free?</summary>
      <p>Yes — completely free, no account required, no watermark. Print or use your browser's "Save as PDF" to get a PDF copy.</p>
    </details>
    <details>
      <summary>How do I save the invoice as a PDF?</summary>
      <p>Click "Print / Save PDF," then in the print dialog choose "Save as PDF" as the destination. On Mac, click the PDF dropdown in the bottom-left of the print dialog.</p>
    </details>
    <details>
      <summary>What tax rate should I use?</summary>
      <p>In the US there is no federal sales tax — rates are set by state and locality. Common rates range from 0% (Oregon, Montana) to over 10% in some cities. Leave at 0% if you're exempt or selling B2B with a resale certificate.</p>
    </details>
    <details>
      <summary>Can I add my logo?</summary>
      <p>Yes — click "Edit ›" next to your business name, or click "My Business" in the nav. Your logo is stored in your browser and appears on every document automatically.</p>
    </details>
    <details>
      <summary>Can I create an invoice from a quote?</summary>
      <p>Yes — create your quote in the <a href="/quote-generator/">Quote Generator</a>, then click "Convert to Invoice." All your business info, client details, and line items transfer automatically.</p>
    </details>
  </div>

  <div class="card print-hide">
    <h2>Embed This Invoice Generator</h2>
    <p>Free to use on your website or blog. Paste one line of HTML — no account or backend needed.</p>
    <pre id="embed-code" style="background:var(--bg);border:1.5px solid var(--border);border-radius:7px;padding:0.85rem 1rem;font-size:0.78rem;overflow-x:auto;white-space:pre-wrap;word-break:break-all;color:var(--muted);line-height:1.6;margin-bottom:0.75rem;"></pre>
    <button id="embed-copy-btn" onclick="copyEmbed()" class="btn" style="font-size:0.85rem;padding:0.5rem 1rem;">Copy Embed Code</button>
  </div>

</Layout>


<script is:inline>
(function() {
  const today = new Date();
  const due   = new Date(today);
  due.setDate(due.getDate() + 30);
  const fmtD  = d => d.toISOString().slice(0, 10);
  document.getElementById('inv-date').value   = fmtD(today);
  document.getElementById('due-date').value   = fmtD(due);
  document.getElementById('inv-number').value = 'INV-001';

  document.addEventListener('currencychange', renderPreview);

  fillDocFromBiz();

  // Quote conversion
  const qd = sessionStorage.getItem('fm_quote_data');
  if (qd) {
    try {
      const q = JSON.parse(qd);
      sessionStorage.removeItem('fm_quote_data');
      const set = (id, v) => { const el = document.getElementById(id); if (el && v) el.value = v; };
      set('from-name', q.fromName); set('from-email', q.fromEmail); set('from-phone', q.fromPhone);
      set('from-street', q.fromStreet); set('from-city', q.fromCity); set('from-state', q.fromState); set('from-zip', q.fromZip);
      set('to-name', q.toName); set('to-email', q.toEmail);
      set('to-street', q.toStreet); set('to-city', q.toCity); set('to-state', q.toState); set('to-zip', q.toZip);
      set('tax-rate', q.taxRate); set('notes', q.notes);
      if (q.items && q.items.length) {
        const container = document.getElementById('line-items');
        container.innerHTML = '';
        q.items.forEach((item, i) => container.appendChild(buildLineRow(item.desc, item.qty, item.rate, i > 0)));
      }
    } catch(e) {}
  }

  if (!localStorage.getItem('biz_setup_done')) setTimeout(openBizModal, 400);

  renderPreview();
})();

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function fmt(n) {
  const c = window.__currency || { locale: 'en-US', code: 'USD' };
  return new Intl.NumberFormat(c.locale, { style: 'currency', currency: c.code, minimumFractionDigits: 2 }).format(n);
}

function addrLines(street, city, state, zip) {
  const line2 = [city, state].filter(Boolean).join(', ') + (zip ? ' ' + zip : '');
  return [street, line2].filter(Boolean);
}

function getLineItems() {
  return Array.from(document.querySelectorAll('#line-items .li-card')).map(card => {
    const qty  = parseFloat(card.querySelector('.li-qty-val')?.value)  || 0;
    const rate = parseFloat(card.querySelector('.li-rate-val')?.value) || 0;
    return { desc: card.querySelector('.li-description')?.value || '', qty, rate, total: qty * rate };
  }).filter(r => r.desc || r.total > 0);
}

function updateLineTotals() {
  document.querySelectorAll('#line-items .li-card').forEach(card => {
    const qty  = parseFloat(card.querySelector('.li-qty-val')?.value)  || 0;
    const rate = parseFloat(card.querySelector('.li-rate-val')?.value) || 0;
    const el   = card.querySelector('.inv-li-total');
    if (el) el.textContent = (qty && rate) ? fmt(qty * rate) : '—';
  });
}

function fillDocFromBiz() {
  const get = k => localStorage.getItem(k) || '';
  const name = get('biz_name'), email = get('biz_email'), phone = get('biz_phone');
  const street = get('biz_street'), city = get('biz_city'), state = get('biz_state'), zip = get('biz_zip');
  const logo = get('biz_logo');

  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
  set('from-name', name); set('from-email', email); set('from-phone', phone);
  set('from-street', street); set('from-city', city); set('from-state', state); set('from-zip', zip);

  const dispName  = document.getElementById('inv-biz-disp-name');
  const dispMeta  = document.getElementById('inv-biz-disp-meta');
  const logoThumb = document.getElementById('inv-biz-logo-thumb');
  if (dispName) { dispName.textContent = name || 'No profile saved — click Edit to set up'; dispName.style.color = name ? 'var(--text)' : 'var(--muted)'; }
  if (dispMeta) { const p = []; if (phone) p.push(phone); if (email) p.push(email); dispMeta.textContent = p.join('  ·  '); }
  if (logoThumb) { if (logo) { logoThumb.src = logo; logoThumb.style.display = 'block'; } else { logoThumb.style.display = 'none'; } }

  renderPreview();
}

function buildLineRow(desc, qty, rate, removable) {
  const card = document.createElement('div');
  card.className = 'li-card';
  const total = (parseFloat(qty) || 0) * (parseFloat(rate) || 0);
  card.innerHTML = `
    <div class="field">
      <label>Description</label>
      <input type="text" class="li-description" placeholder="Service or product description" oninput="renderPreview()" value="${esc(desc || '')}" />
    </div>
    <div class="li-bottom-row">
      <div class="field li-field-sm">
        <label>Qty</label>
        <input type="text" inputmode="decimal" class="li-qty-val" placeholder="1" value="${qty || 1}" oninput="renderPreview()" />
      </div>
      <div class="field li-field-md">
        <label>Rate</label>
        <input type="text" inputmode="decimal" class="li-rate-val" placeholder="0.00" value="${rate || ''}" oninput="renderPreview()" />
      </div>
      <div class="li-total-block">
        <div class="li-total-label">Total</div>
        <div class="li-total-val inv-li-total">${total > 0 ? fmt(total) : '—'}</div>
      </div>
      ${removable
        ? '<button class="li-remove-btn" onclick="this.closest(\'.li-card\').remove();renderPreview();" type="button" title="Remove line">×</button>'
        : '<div class="li-remove-placeholder"></div>'}
    </div>
  `;
  return card;
}

function addLine() {
  const container = document.getElementById('line-items');
  const card = buildLineRow('', 1, '', true);
  container.appendChild(card);
  card.querySelector('.li-description').focus();
}

function renderPreview() {
  updateLineTotals();

  const items    = getLineItems();
  const subtotal = items.reduce((s, r) => s + r.total, 0);
  const taxRate  = parseFloat(document.getElementById('tax-rate').value) || 0;
  const tax      = subtotal * (taxRate / 100);
  const total    = subtotal + tax;

  const fromName   = (document.getElementById('from-name')?.value   || '').trim();
  const fromEmail  = (document.getElementById('from-email')?.value  || '').trim();
  const fromPhone  = (document.getElementById('from-phone')?.value  || '').trim();
  const fromAddr   = addrLines(
    (document.getElementById('from-street')?.value || '').trim(),
    (document.getElementById('from-city')?.value   || '').trim(),
    (document.getElementById('from-state')?.value  || '').trim(),
    (document.getElementById('from-zip')?.value    || '').trim()
  );
  const toName  = (document.getElementById('to-name')?.value  || '').trim();
  const toEmail = (document.getElementById('to-email')?.value || '').trim();
  const toAddr  = addrLines(
    (document.getElementById('to-street')?.value || '').trim(),
    (document.getElementById('to-city')?.value   || '').trim(),
    (document.getElementById('to-state')?.value  || '').trim(),
    (document.getElementById('to-zip')?.value    || '').trim()
  );
  const invNum  = document.getElementById('inv-number')?.value || 'INV-001';
  const invDate = document.getElementById('inv-date')?.value   || '';
  const dueDate = document.getElementById('due-date')?.value   || '';
  const notes   = (document.getElementById('notes')?.value     || '').trim();
  const logo    = localStorage.getItem('biz_logo');

  const navy   = '#0f2d52';
  const fox    = '#d4500a';
  const muted  = '#6b7c93';
  const border = '#e8ecf2';
  const bg     = '#f5f7fa';

  const lineRows = items.length
    ? items.map((r, i) => `
        <tr style="background:${i % 2 === 0 ? '#fff' : '#fafbfd'};">
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};font-size:.88em;color:#1a2332;">${esc(r.desc)}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:center;font-size:.88em;color:${muted};">${r.qty}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:right;font-size:.88em;color:${muted};">${fmt(r.rate)}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:right;font-size:.9em;font-weight:600;color:#1a2332;">${fmt(r.total)}</td>
        </tr>`).join('')
    : `<tr><td colspan="4" style="padding:1.5rem .7rem;text-align:center;font-size:.85em;color:#c0c8d4;font-style:italic;">Add a line item to get started</td></tr>`;

  document.getElementById('invoice-paper').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.75rem;gap:1rem;">
      <div style="flex:1;min-width:0;">
        ${logo ? `<img src="${logo}" style="max-height:56px;max-width:170px;object-fit:contain;display:block;margin-bottom:.65rem;" alt="logo" />` : ''}
        ${fromName
          ? `<div style="font-size:1.08em;font-weight:700;color:${navy};margin-bottom:.18em;line-height:1.3;">${esc(fromName)}</div>`
          : `<div style="font-size:1.08em;font-weight:700;color:#d0d7e2;line-height:1.3;">Your Business Name</div>`}
        ${fromAddr.map(l => `<div style="font-size:.84em;color:${muted};line-height:1.55;">${esc(l)}</div>`).join('')}
        ${fromPhone ? `<div style="font-size:.84em;color:${muted};">${esc(fromPhone)}</div>` : ''}
        ${fromEmail ? `<div style="font-size:.84em;color:${muted};">${esc(fromEmail)}</div>` : ''}
      </div>
      <div style="text-align:right;flex-shrink:0;">
        <div style="font-size:2em;font-weight:800;color:${navy};letter-spacing:-.02em;line-height:1;margin-bottom:.4em;">INVOICE</div>
        <div style="display:inline-block;background:${bg};border:1px solid ${border};border-radius:5px;padding:.3em .7em;text-align:left;">
          <div style="font-size:.78em;color:${muted};margin-bottom:.15em;">Invoice #</div>
          <div style="font-size:.95em;font-weight:700;color:${navy};">${esc(invNum)}</div>
          ${invDate ? `<div style="font-size:.75em;color:${muted};margin-top:.25em;">Date: ${esc(invDate)}</div>` : ''}
          ${dueDate ? `<div style="font-size:.75em;color:${fox};font-weight:600;">Due: ${esc(dueDate)}</div>` : ''}
        </div>
      </div>
    </div>

    <div style="height:1px;background:${border};margin-bottom:1.4rem;"></div>

    <div style="margin-bottom:1.5rem;">
      <div style="font-size:.68em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.45em;">Bill To</div>
      ${toName
        ? `<div style="font-size:1em;font-weight:600;color:#1a2332;margin-bottom:.2em;">${esc(toName)}</div>`
        : `<div style="font-size:1em;color:#d0d7e2;font-style:italic;">Client name</div>`}
      ${toEmail ? `<div style="font-size:.85em;color:${muted};">${esc(toEmail)}</div>` : ''}
      ${toAddr.map(l => `<div style="font-size:.85em;color:${muted};line-height:1.5;">${esc(l)}</div>`).join('')}
    </div>

    <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;border-radius:6px;overflow:hidden;">
      <thead>
        <tr style="background:${navy};">
          <th style="padding:.55rem .7rem;text-align:left;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;">Description</th>
          <th style="padding:.55rem .7rem;text-align:center;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Qty</th>
          <th style="padding:.55rem .7rem;text-align:right;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Rate</th>
          <th style="padding:.55rem .7rem;text-align:right;font-size:.72em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Amount</th>
        </tr>
      </thead>
      <tbody>${lineRows}</tbody>
    </table>

    <div style="display:flex;justify-content:flex-end;">
      <div style="width:220px;">
        <div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.87em;color:${muted};border-bottom:1px solid ${border};"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
        ${taxRate > 0 ? `<div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.87em;color:${muted};border-bottom:1px solid ${border};"><span>Tax (${taxRate}%)</span><span>${fmt(tax)}</span></div>` : ''}
        <div style="display:flex;justify-content:space-between;padding:.55rem 0 .35rem;font-size:1.05em;font-weight:700;color:${navy};margin-top:.1rem;"><span>Total</span><span>${fmt(total)}</span></div>
      </div>
    </div>

    ${notes ? `
    <div style="margin-top:1.75rem;padding:1rem 1.1rem;background:${bg};border-radius:7px;border:1px solid ${border};">
      <div style="font-size:.68em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.5em;">Notes &amp; Payment Terms</div>
      <div style="font-size:.84em;color:${muted};line-height:1.6;white-space:pre-wrap;">${esc(notes)}</div>
    </div>` : ''}
  `;
}
</script>

<script is:inline>
document.getElementById('embed-code').textContent = '<iframe src="https://foxmargin.com/embed/invoice-generator/" width="100%" height="720" frameborder="0" style="border-radius:8px;border:1px solid #e1e8ed;" title="Free Invoice Generator — FoxMargin"></iframe>';
function copyEmbed() {
  navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(() => {
    const btn = document.getElementById('embed-copy-btn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = 'Copy Embed Code', 2000);
  });
}
</script>
