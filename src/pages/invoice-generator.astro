---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Free Invoice Generator — Create & Print Invoices | FoxMargin"
  description="Create professional invoices online for free. Add line items, tax, and your logo. Print or save as PDF instantly. No signup required."
>
  <div class="card">
    <h1>Free Invoice Generator</h1>
    <p>Create a professional invoice in seconds. Fill in your details, add line items, and print or save as PDF — no account needed.</p>
  </div>

  <!-- Invoice Builder -->
  <div class="card doc-builder" id="builder">
    <div class="biz-profile-bar" id="biz-bar">
      <span id="biz-bar-name">No business profile saved</span>
      <button onclick="openBizModal()">Edit My Business</button>
    </div>

    <h2>Invoice Details</h2>
    <div class="calc-form">
      <div class="section-label">Your Business</div>
      <div class="field-row">
        <div class="field">
          <label for="from-name">Business Name</label>
          <input type="text" id="from-name" placeholder="Acme Corp" />
        </div>
        <div class="field">
          <label for="from-phone">Phone</label>
          <input type="tel" id="from-phone" placeholder="+1 (555) 000-0000" />
        </div>
      </div>
      <div class="field">
        <label for="from-email">Email</label>
        <input type="email" id="from-email" placeholder="hello@acmecorp.com" />
      </div>
      <div class="field addr-wrap">
        <label for="from-address">Address</label>
        <input type="text" id="from-address" placeholder="Start typing your address…" autocomplete="off" />
      </div>

      <div class="section-label" style="margin-top:0.5rem;">Bill To</div>
      <div class="field-row">
        <div class="field">
          <label for="to-name">Client Name / Company</label>
          <input type="text" id="to-name" placeholder="Client Co." />
        </div>
        <div class="field">
          <label for="to-email">Client Email</label>
          <input type="email" id="to-email" placeholder="client@example.com" />
        </div>
      </div>
      <div class="field addr-wrap">
        <label for="to-address">Client Address</label>
        <input type="text" id="to-address" placeholder="Start typing address…" autocomplete="off" />
      </div>

      <div class="section-label" style="margin-top:0.5rem;">Invoice Info</div>
      <div class="field-row">
        <div class="field">
          <label for="inv-number">Invoice Number</label>
          <input type="text" id="inv-number" placeholder="INV-001" />
        </div>
        <div class="field">
          <label for="inv-date">Date</label>
          <input type="date" id="inv-date" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="due-date">Due Date</label>
          <input type="date" id="due-date" />
        </div>
        <div class="field">
          <label for="tax-rate">Tax Rate (%)</label>
          <input type="number" id="tax-rate" placeholder="0" min="0" max="100" step="0.01" value="0" />
        </div>
      </div>

      <div class="section-label" style="margin-top:0.5rem;">Line Items</div>
      <div id="line-items">
        <div class="line-item-row">
          <div class="field li-desc"><label>Description</label><input type="text" placeholder="Service or product" class="li-description" /></div>
          <div class="field li-qty"><label>Qty</label><input type="number" placeholder="1" min="0" step="0.01" class="li-qty-val" value="1" /></div>
          <div class="field li-rate"><label>Rate ($)</label><input type="number" placeholder="100.00" min="0" step="0.01" class="li-rate-val" /></div>
          <div class="field li-total"><label>Total</label><span class="li-total-val">—</span></div>
        </div>
      </div>
      <button class="btn btn-outline print-hide" onclick="addLine()" type="button" style="align-self:flex-start;font-size:0.85rem;padding:0.5rem 1rem;">+ Add Line</button>

      <div class="field" style="margin-top:0.25rem;">
        <label for="notes">Notes / Payment Terms</label>
        <textarea id="notes" placeholder="e.g. Payment due within 30 days. Thank you for your business." rows="2" style="width:100%;padding:0.6rem 0.85rem;border:1.5px solid var(--border);border-radius:7px;font-size:0.9rem;resize:vertical;font-family:inherit;"></textarea>
      </div>

      <button class="btn" onclick="generateInvoice()" type="button">Generate Invoice</button>
    </div>
  </div>

  <!-- Invoice Preview (hidden until generated) -->
  <div class="card doc-preview-card" id="preview" style="display:none;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:0.5rem;" class="print-hide">
      <h2 style="margin:0;">Preview</h2>
      <div style="display:flex;gap:0.5rem;">
        <button class="btn btn-outline" onclick="editInvoice()" style="font-size:0.85rem;padding:0.5rem 1rem;">Edit</button>
        <button class="btn" onclick="printInvoice()" style="font-size:0.85rem;padding:0.5rem 1rem;">Print / Save PDF</button>
      </div>
    </div>
    <div id="invoice-doc" class="doc-preview">
      <!-- Filled by JS -->
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <details>
      <summary>Is this invoice generator really free?</summary>
      <p>Yes — completely free, no account required, no watermark. Print or use your browser's "Save as PDF" function to get a PDF copy.</p>
    </details>
    <details>
      <summary>How do I save the invoice as a PDF?</summary>
      <p>Click "Print / Save PDF," then in the print dialog choose "Save as PDF" as the destination (available in all modern browsers). On Mac, click the PDF dropdown in the bottom left of the print dialog.</p>
    </details>
    <details>
      <summary>What tax rate should I use?</summary>
      <p>In the US there is no federal sales tax — rates are set by state and locality. Common rates range from 0% (Oregon, Montana, New Hampshire) to over 10% in some cities. Enter your applicable state/local rate, or leave at 0% if you're exempt or selling to another business with a resale certificate.</p>
    </details>
    <details>
      <summary>Can I add my logo?</summary>
      <p>Yes — click "My Business" in the nav bar to upload your logo. It's stored in your browser and appears automatically on every invoice, receipt, quote, and purchase order you create.</p>
    </details>
    <details>
      <summary>Can I create an invoice from a quote?</summary>
      <p>Yes — create your quote in the <a href="/quote-generator/">Quote Generator</a>, then click "Convert to Invoice." All your business info, client details, and line items transfer automatically. Just confirm the invoice number and due date.</p>
    </details>
  </div>

  <div class="card">
    <h2>Embed This Invoice Generator</h2>
    <p>Free to use on your website or blog. Paste one line of HTML — no account or backend needed.</p>
    <pre id="embed-code" style="background:var(--bg);border:1.5px solid var(--border);border-radius:7px;padding:0.85rem 1rem;font-size:0.78rem;overflow-x:auto;white-space:pre-wrap;word-break:break-all;color:var(--muted);line-height:1.6;margin-bottom:0.75rem;"></pre>
    <button id="embed-copy-btn" onclick="copyEmbed()" class="btn" style="font-size:0.85rem;padding:0.5rem 1rem;">Copy Embed Code</button>
  </div>
</Layout>

<style>
  /* line-item-row override for invoice (4-col, no remove button) */
  .line-item-row {
    display: grid;
    grid-template-columns: 1fr 80px 110px 90px 28px;
    gap: 0.5rem;
    align-items: end;
    margin-bottom: 0.5rem;
  }
  @media (max-width: 520px) {
    .line-item-row { grid-template-columns: 1fr 1fr; }
    .li-total { grid-column: span 2; }
  }
</style>

<script is:inline>
(function() {
  const today = new Date();
  const due = new Date(today);
  due.setDate(due.getDate() + 30);
  const fmtD = d => d.toISOString().slice(0, 10);
  document.getElementById('inv-date').value = fmtD(today);
  document.getElementById('due-date').value = fmtD(due);
  document.getElementById('inv-number').value = 'INV-001';
  document.getElementById('line-items').addEventListener('input', updateLineTotals);

  // Autocomplete on address fields
  initAutocomplete(document.getElementById('from-address'));
  initAutocomplete(document.getElementById('to-address'));

  // Load business profile
  fillDocFromBiz();

  // Check for quote conversion data
  const qd = sessionStorage.getItem('fm_quote_data');
  if (qd) {
    try {
      const q = JSON.parse(qd);
      sessionStorage.removeItem('fm_quote_data');
      if (q.fromName)  document.getElementById('from-name').value = q.fromName;
      if (q.fromEmail) document.getElementById('from-email').value = q.fromEmail;
      if (q.fromPhone) document.getElementById('from-phone').value = q.fromPhone || '';
      if (q.fromAddr)  document.getElementById('from-address').value = q.fromAddr;
      if (q.toName)    document.getElementById('to-name').value = q.toName;
      if (q.toEmail)   document.getElementById('to-email').value = q.toEmail;
      if (q.toAddr)    document.getElementById('to-address').value = q.toAddr;
      if (q.taxRate)   document.getElementById('tax-rate').value = q.taxRate;
      if (q.notes)     document.getElementById('notes').value = q.notes;
      if (q.items && q.items.length) {
        const container = document.getElementById('line-items');
        container.innerHTML = '';
        q.items.forEach((item, i) => {
          const row = document.createElement('div');
          row.className = 'line-item-row';
          row.innerHTML = `
            <div class="field li-desc">${i === 0 ? '<label>Description</label>' : ''}<input type="text" placeholder="Service or product" class="li-description" value="${item.desc}" /></div>
            <div class="field li-qty">${i === 0 ? '<label>Qty</label>' : ''}<input type="number" placeholder="1" min="0" step="0.01" class="li-qty-val" value="${item.qty}" /></div>
            <div class="field li-rate">${i === 0 ? '<label>Rate ($)</label>' : ''}<input type="number" placeholder="100.00" min="0" step="0.01" class="li-rate-val" value="${item.rate}" /></div>
            <div class="field li-total">${i === 0 ? '<label>Total</label>' : ''}<span class="li-total-val">${item.total > 0 ? fmt(item.total) : '—'}</span></div>
            <div class="li-remove">${i > 0 ? '<button class="li-remove-btn" onclick="this.closest(\'.line-item-row\').remove()" type="button" title="Remove">×</button>' : ''}</div>
          `;
          container.appendChild(row);
        });
      }
    } catch(e) {}
  }

  // Show modal on first visit if no profile
  if (!localStorage.getItem('biz_setup_done')) setTimeout(openBizModal, 400);
})();

function fillDocFromBiz() {
  const name = localStorage.getItem('biz_name') || '';
  const email = localStorage.getItem('biz_email') || '';
  const phone = localStorage.getItem('biz_phone') || '';
  const addr = localStorage.getItem('biz_address') || '';
  if (name)  document.getElementById('from-name').value = name;
  if (email) document.getElementById('from-email').value = email;
  if (phone && document.getElementById('from-phone')) document.getElementById('from-phone').value = phone;
  if (addr)  document.getElementById('from-address').value = addr;
  const bar = document.getElementById('biz-bar-name');
  if (bar) bar.textContent = name ? '👤 ' + name : 'No business profile saved';
}

function addLine() {
  const container = document.getElementById('line-items');
  const row = document.createElement('div');
  row.className = 'line-item-row';
  row.innerHTML = `
    <div class="field li-desc"><input type="text" placeholder="Service or product" class="li-description" /></div>
    <div class="field li-qty"><input type="number" placeholder="1" min="0" step="0.01" class="li-qty-val" value="1" /></div>
    <div class="field li-rate"><input type="number" placeholder="0.00" min="0" step="0.01" class="li-rate-val" /></div>
    <div class="field li-total"><span class="li-total-val">—</span></div>
  `;
  container.appendChild(row);
}

function updateLineTotals() {
  const rows = document.querySelectorAll('.line-item-row');
  rows.forEach(row => {
    const qty = parseFloat(row.querySelector('.li-qty-val')?.value) || 0;
    const rate = parseFloat(row.querySelector('.li-rate-val')?.value) || 0;
    const total = qty * rate;
    const el = row.querySelector('.li-total-val');
    if (el) el.textContent = total > 0 ? fmt(total) : '—';
  });
}

function getLineItems() {
  const rows = document.querySelectorAll('.line-item-row');
  return Array.from(rows).map(row => ({
    desc: row.querySelector('.li-description')?.value || '',
    qty: parseFloat(row.querySelector('.li-qty-val')?.value) || 0,
    rate: parseFloat(row.querySelector('.li-rate-val')?.value) || 0,
    total: (parseFloat(row.querySelector('.li-qty-val')?.value) || 0) * (parseFloat(row.querySelector('.li-rate-val')?.value) || 0),
  })).filter(r => r.desc || r.total > 0);
}

function fmt(n) {
  const c = window.__currency || { locale: 'en-US', code: 'USD' };
  return new Intl.NumberFormat(c.locale, { style: 'currency', currency: c.code, minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);
}

function generateInvoice() {
  const items = getLineItems();
  const subtotal = items.reduce((s, r) => s + r.total, 0);
  const taxRate = parseFloat(document.getElementById('tax-rate').value) || 0;
  const tax = subtotal * (taxRate / 100);
  const total = subtotal + tax;

  const fromName  = document.getElementById('from-name').value || 'Your Business';
  const fromEmail = document.getElementById('from-email').value;
  const fromPhone = document.getElementById('from-phone') ? document.getElementById('from-phone').value : '';
  const fromAddr  = document.getElementById('from-address').value;
  const toName    = document.getElementById('to-name').value || 'Client';
  const toEmail   = document.getElementById('to-email').value;
  const toAddr    = document.getElementById('to-address').value;
  const invNum    = document.getElementById('inv-number').value || 'INV-001';
  const invDate   = document.getElementById('inv-date').value;
  const dueDate   = document.getElementById('due-date').value;
  const notes     = document.getElementById('notes').value;
  const logo      = localStorage.getItem('biz_logo');

  const lineRows = items.map(r => `
    <tr>
      <td>${r.desc}</td>
      <td style="text-align:center">${r.qty}</td>
      <td style="text-align:right">${fmt(r.rate)}</td>
      <td>${fmt(r.total)}</td>
    </tr>
  `).join('');

  document.getElementById('invoice-doc').innerHTML = `
    <div class="doc-header">
      <div>
        ${logo ? `<img src="${logo}" class="doc-logo" alt="Logo" />` : ''}
        <div class="doc-title">INVOICE</div>
        <p style="color:var(--muted);font-size:0.85rem;margin-top:0.2rem;">${fromName}</p>
      </div>
      <div class="doc-meta">
        <p><strong>#${invNum}</strong></p>
        <p>Date: <strong>${invDate}</strong></p>
        <p>Due: <strong>${dueDate}</strong></p>
      </div>
    </div>
    <div class="doc-parties">
      <div>
        <h3>From</h3>
        <p class="party-name">${fromName}</p>
        ${fromPhone ? `<p>${fromPhone}</p>` : ''}
        ${fromEmail ? `<p>${fromEmail}</p>` : ''}
        ${fromAddr  ? `<p>${fromAddr}</p>`  : ''}
      </div>
      <div>
        <h3>Bill To</h3>
        <p class="party-name">${toName}</p>
        ${toEmail ? `<p>${toEmail}</p>` : ''}
        ${toAddr  ? `<p>${toAddr}</p>`  : ''}
      </div>
    </div>
    <table class="doc-table">
      <thead><tr><th>Description</th><th style="text-align:center">Qty</th><th style="text-align:right">Rate</th><th style="text-align:right">Amount</th></tr></thead>
      <tbody>${lineRows || '<tr><td colspan="4" style="text-align:center;color:var(--muted);">No items added</td></tr>'}</tbody>
    </table>
    <div class="doc-totals">
      <div class="doc-total-row"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
      ${taxRate > 0 ? `<div class="doc-total-row"><span>Tax (${taxRate}%)</span><span>${fmt(tax)}</span></div>` : ''}
      <div class="doc-total-row grand"><span>Total</span><span>${fmt(total)}</span></div>
    </div>
    ${notes ? `<div class="doc-notes"><strong>Notes</strong>${notes}</div>` : ''}
  `;

  document.getElementById('builder').style.display = 'none';
  document.getElementById('preview').style.display = 'block';
  document.getElementById('preview').scrollIntoView({ behavior: 'smooth' });
}

function editInvoice() {
  document.querySelector('.doc-builder').style.display = 'block';
  document.getElementById('preview').style.display = 'none';
}

function printInvoice() {
  window.print();
}
</script>

<script is:inline>
document.getElementById('embed-code').textContent = '<iframe src="https://foxmargin.com/embed/invoice-generator/" width="100%" height="720" frameborder="0" style="border-radius:8px;border:1px solid #e1e8ed;" title="Free Invoice Generator — FoxMargin"></iframe>';
function copyEmbed() {
  navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(() => {
    const btn = document.getElementById('embed-copy-btn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = 'Copy Embed Code', 2000);
  });
}
</script>
