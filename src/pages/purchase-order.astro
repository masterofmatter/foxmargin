---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": [
  { "@type": "WebApplication", "name": "Free Purchase Order Generator",
    "url": "https://foxmargin.com/purchase-order/",
    "description": "Create professional purchase orders online for free. Add vendor details, line items, delivery date, and an authorization block. Print or save as PDF. No signup.",
    "applicationCategory": "BusinessApplication", "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": ["Free PO creation", "PDF export", "Logo upload", "Authorization block", "Delivery date", "No account required"] },
  { "@type": "FAQPage", "mainEntity": [
    { "@type": "Question", "name": "What is a purchase order and when do I need one?",
      "acceptedAnswer": { "@type": "Answer", "text": "A purchase order (PO) is a formal document from a buyer to a supplier that commits to purchasing specific goods or services at agreed terms. It becomes a legally binding contract when the supplier accepts it. Use POs when you need a paper trail for approval processes, when ordering from new vendors, or when your accounting requires matching POs to invoices before payment." } },
    { "@type": "Question", "name": "What is the difference between a PO and an invoice?",
      "acceptedAnswer": { "@type": "Answer", "text": "A PO is created by the buyer and sent to the supplier before goods are delivered — it's a commitment to buy. An invoice is created by the supplier and sent to the buyer after delivery — it's a request for payment. In a typical purchase cycle: you send a PO, the supplier delivers and sends an invoice, you match the invoice to your PO, then you pay." } },
    { "@type": "Question", "name": "What does Net 30 payment terms mean?",
      "acceptedAnswer": { "@type": "Answer", "text": "Net 30 means the invoice is due 30 days after the invoice date. Net 15 = 15 days, Net 60 = 60 days. 2/10 Net 30 means you get a 2% discount if you pay within 10 days, otherwise the full amount is due in 30 days. Due on Receipt means payment is expected immediately upon delivery." } },
    { "@type": "Question", "name": "Does my business info get saved?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes — click Edit next to your business name, or click My Business in the nav. Your company name, email, phone, address, and logo are stored locally in your browser and pre-fill every document you create. Nothing is sent to any server." } }
  ]}
]});
---
<Layout
  title="Free Purchase Order Generator — Create Professional POs | FoxMargin"
  description="Create professional purchase orders online for free. Add vendor details, line items, delivery date, and an authorization block. Print or save as PDF. No signup."
  schema={schema}
>

  <!-- Hidden inputs: filled by fillDocFromBiz() (these are the BUYER / Bill To) -->
  <input type="hidden" id="from-name" />
  <input type="hidden" id="from-email" />
  <input type="hidden" id="from-phone" />
  <input type="hidden" id="from-street" />
  <input type="hidden" id="from-city" />
  <input type="hidden" id="from-state" />
  <input type="hidden" id="from-zip" />

  <div class="inv-workspace">

    <!-- ── LEFT: scrollable form ── -->
    <div class="inv-form-col">

      <!-- My Business (Buyer) -->
      <div class="ws-card">
        <div class="ws-card-label">My Business (Buyer)</div>
        <div class="inv-biz-bar">
          <div class="inv-biz-bar-left">
            <img id="inv-biz-logo-thumb" class="inv-biz-logo-thumb" style="display:none;" alt="Logo" />
            <div class="inv-biz-text">
              <div class="inv-biz-name" id="inv-biz-disp-name" style="color:var(--muted);">No profile saved — click Edit to set up</div>
              <div class="inv-biz-meta" id="inv-biz-disp-meta"></div>
            </div>
          </div>
          <button class="ws-edit-btn" onclick="openBizModal()" type="button">Edit ›</button>
        </div>
      </div>

      <!-- PO Details -->
      <div class="ws-card">
        <div class="ws-card-label">PO Details</div>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field-row">
            <div class="field">
              <label for="po-date">Date</label>
              <input type="text" id="po-date" placeholder="YYYY-MM-DD" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="po-number">PO #</label>
              <input type="text" id="po-number" placeholder="PO-2026-001" oninput="renderPreview()" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="delivery-date">Expected Delivery</label>
              <input type="text" id="delivery-date" placeholder="YYYY-MM-DD" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="payment-terms">Payment Terms</label>
              <select id="payment-terms" onchange="renderPreview()">
                <option value="Net 30">Net 30</option>
                <option value="Net 15">Net 15</option>
                <option value="Net 60">Net 60</option>
                <option value="Due on Receipt">Due on Receipt</option>
                <option value="2/10 Net 30">2/10 Net 30</option>
                <option value="Prepaid">Prepaid</option>
              </select>
            </div>
          </div>
        </div>
        <div id="tax-lines" style="margin-top:0.75rem;">
          <div class="tax-row">
            <div class="field">
              <label>Tax Label</label>
              <input type="text" class="tax-name" placeholder="Sales Tax" oninput="renderPreview()" />
            </div>
            <div class="field">
              <label>Rate (%)</label>
              <input type="text" inputmode="decimal" class="tax-pct" placeholder="0" oninput="renderPreview()" />
            </div>
            <div class="tax-remove-placeholder"></div>
          </div>
        </div>
        <button class="ws-add-line-btn" onclick="addTax()" type="button">+ Add Tax</button>
        <div class="field" style="margin-top:0.75rem;">
          <label for="shipping-cost">Shipping / Freight</label>
          <input type="text" inputmode="decimal" id="shipping-cost" placeholder="0.00" oninput="renderPreview()" />
        </div>
      </div>

      <!-- Vendor / Supplier -->
      <div class="ws-card">
        <div class="ws-card-label">Vendor / Supplier</div>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field-row">
            <div class="field">
              <label for="to-name">Vendor Name / Company</label>
              <input type="text" id="to-name" placeholder="Supplier Ltd." oninput="renderPreview()" />
            </div>
            <div class="field">
              <label for="to-email">Email</label>
              <input type="email" id="to-email" placeholder="orders@supplier.com" oninput="renderPreview()" />
            </div>
          </div>
          <div class="field">
            <label for="to-country">Country</label>
            <select id="to-country" onchange="updateToAddrLabels();renderPreview()">
              <optgroup label="Popular">
                <option value="US">United States</option>
                <option value="CA">Canada</option>
                <option value="GB">United Kingdom</option>
                <option value="AU">Australia</option>
                <option value="NZ">New Zealand</option>
                <option value="IE">Ireland</option>
                <option value="IN">India</option>
                <option value="SG">Singapore</option>
                <option value="ZA">South Africa</option>
                <option value="NG">Nigeria</option>
              </optgroup>
              <optgroup label="Europe">
                <option value="AT">Austria</option>
                <option value="BE">Belgium</option>
                <option value="CH">Switzerland</option>
                <option value="CZ">Czech Republic</option>
                <option value="DE">Germany</option>
                <option value="DK">Denmark</option>
                <option value="ES">Spain</option>
                <option value="FI">Finland</option>
                <option value="FR">France</option>
                <option value="GR">Greece</option>
                <option value="HU">Hungary</option>
                <option value="IT">Italy</option>
                <option value="NL">Netherlands</option>
                <option value="NO">Norway</option>
                <option value="PL">Poland</option>
                <option value="PT">Portugal</option>
                <option value="SE">Sweden</option>
              </optgroup>
              <optgroup label="Americas">
                <option value="AR">Argentina</option>
                <option value="BR">Brazil</option>
                <option value="CL">Chile</option>
                <option value="CO">Colombia</option>
                <option value="MX">Mexico</option>
              </optgroup>
              <optgroup label="Asia &amp; Pacific">
                <option value="AE">United Arab Emirates</option>
                <option value="CN">China</option>
                <option value="HK">Hong Kong</option>
                <option value="ID">Indonesia</option>
                <option value="JP">Japan</option>
                <option value="KR">South Korea</option>
                <option value="MY">Malaysia</option>
                <option value="PH">Philippines</option>
                <option value="TH">Thailand</option>
                <option value="TR">Turkey</option>
              </optgroup>
              <optgroup label="Africa &amp; Middle East">
                <option value="EG">Egypt</option>
                <option value="GH">Ghana</option>
                <option value="IL">Israel</option>
                <option value="KE">Kenya</option>
                <option value="SA">Saudi Arabia</option>
              </optgroup>
            </select>
          </div>
          <div class="field">
            <label for="to-street">Street Address</label>
            <input type="text" id="to-street" placeholder="456 Supplier Blvd" autocomplete="off" oninput="renderPreview()" />
          </div>
          <div class="addr-grid">
            <div class="field"><label for="to-city">City</label><input type="text" id="to-city" placeholder="City" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field" id="field-to-state"><label id="lbl-to-state" for="to-state">State</label><input type="text" id="to-state" placeholder="TX" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field" id="field-to-zip"><label id="lbl-to-zip" for="to-zip">ZIP Code</label><input type="text" id="to-zip" placeholder="10001" autocomplete="off" oninput="renderPreview()" /></div>
          </div>
        </div>
      </div>

      <!-- Ship To (optional) -->
      <div class="ws-card">
        <div class="ws-card-label">Ship To (optional)</div>
        <p style="font-size:0.77rem;color:var(--muted);margin:-0.6rem 0 0.8rem;line-height:1.5;">Leave blank to ship to your billing address.</p>
        <div class="calc-form" style="gap:0.75rem;">
          <div class="field">
            <label for="ship-name">Recipient / Department</label>
            <input type="text" id="ship-name" placeholder="Receiving / Warehouse" autocomplete="off" oninput="renderPreview()" />
          </div>
          <div class="field">
            <label for="ship-street">Street Address</label>
            <input type="text" id="ship-street" placeholder="Leave blank for billing address" autocomplete="off" oninput="renderPreview()" />
          </div>
          <div class="addr-grid">
            <div class="field"><label for="ship-city">City</label><input type="text" id="ship-city" placeholder="City" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field"><label for="ship-state">State</label><input type="text" id="ship-state" placeholder="TX" autocomplete="off" oninput="renderPreview()" /></div>
            <div class="field"><label for="ship-zip">ZIP</label><input type="text" id="ship-zip" placeholder="10001" autocomplete="off" oninput="renderPreview()" /></div>
          </div>
        </div>
      </div>

      <!-- Line Items -->
      <div class="ws-card">
        <div class="ws-card-label">Line Items</div>
        <div id="line-items">
          <div class="li-card">
            <div class="field">
              <label>Description / Part #</label>
              <input type="text" class="li-description" placeholder="Item description or part number" oninput="renderPreview()" />
            </div>
            <div class="li-bottom-row">
              <div class="field li-field-sm">
                <label>Qty</label>
                <input type="text" inputmode="decimal" class="li-qty-val" placeholder="1" value="1" oninput="renderPreview()" />
              </div>
              <div class="field li-field-md">
                <label>Unit Price</label>
                <input type="text" inputmode="decimal" class="li-rate-val" placeholder="0.00" oninput="renderPreview()" />
              </div>
              <div class="li-total-block">
                <div class="li-total-label">Total</div>
                <div class="li-total-val inv-li-total">—</div>
              </div>
              <div class="li-remove-placeholder"></div>
            </div>
          </div>
        </div>
        <button class="ws-add-line-btn" onclick="addLine()" type="button">+ Add Item</button>
      </div>

      <!-- Special Instructions / Notes -->
      <div class="ws-card">
        <div class="ws-card-label">Special Instructions / Notes</div>
        <div class="field">
          <textarea id="notes" placeholder="e.g. All items must be individually labeled. Contact purchasing@company.com before delivery." rows="3" oninput="renderPreview()"></textarea>
        </div>
      </div>

      <!-- Authorization -->
      <div class="ws-card">
        <div class="ws-card-label">Authorization</div>
        <div class="field">
          <label for="authorized-by">Authorized By</label>
          <input type="text" id="authorized-by" placeholder="Full name of approving manager" oninput="renderPreview()" />
        </div>
      </div>

    </div>

    <!-- ── RIGHT: sticky paper ── -->
    <div class="inv-paper-col">
      <div class="inv-paper-actions">
        <span class="inv-paper-label">Live Preview</span>
        <button class="btn" onclick="track('print_po');window.print()" type="button" style="font-size:0.82rem;padding:0.45rem 1rem;">Print / Save PDF</button>
      </div>
      <div class="inv-paper" id="doc-paper"></div>
    </div>

  </div>

  <div class="ws-card print-hide" style="margin-top:2rem;">
    <div class="ws-card-label">Frequently Asked Questions</div>
    <p style="font-size:0.88rem;color:var(--muted);margin-bottom:1.25rem;line-height:1.55;">Common questions about creating and using purchase orders with FoxMargin.</p>
    <details>
      <summary>What is a purchase order and when do I need one?</summary>
      <p>A purchase order (PO) is a formal document from a buyer to a supplier that commits to purchasing specific goods or services at agreed terms. It becomes a legally binding contract when the supplier accepts it. Use POs when you need a paper trail for approval processes, when ordering from new vendors, or when your accounting requires matching POs to invoices before payment.</p>
    </details>
    <details>
      <summary>What is the difference between a PO and an invoice?</summary>
      <p>A PO is created by the buyer and sent to the supplier before goods are delivered — it's a commitment to buy. An invoice is created by the supplier and sent to the buyer after delivery — it's a request for payment. In a typical purchase cycle: you send a PO → supplier delivers and sends an invoice → you match the invoice to your PO → you pay.</p>
    </details>
    <details>
      <summary>What does "Net 30" payment terms mean?</summary>
      <p>Net 30 means the invoice is due 30 days after the invoice date. Net 15 = 15 days, Net 60 = 60 days. "2/10 Net 30" means you get a 2% discount if you pay within 10 days, otherwise full amount is due in 30 days. "Due on Receipt" means payment is expected immediately upon delivery.</p>
    </details>
    <details>
      <summary>Does my business info get saved?</summary>
      <p>Yes — click "Edit ›" next to your business name, or click "My Business" in the nav. Your company name, email, phone, address, and logo are stored locally in your browser and pre-fill every document you create. Nothing is sent to any server.</p>
    </details>
  </div>

  <div class="ws-card print-hide">
    <div class="ws-card-label">Embed This Purchase Order Generator</div>
    <p style="font-size:0.88rem;color:var(--muted);margin-bottom:1.25rem;line-height:1.55;">Free to use on your website or blog. Paste one line of HTML — no account or backend needed.</p>
    <pre id="embed-code" style="background:var(--bg);border:1.5px solid var(--border);border-radius:7px;padding:0.85rem 1rem;font-size:0.78rem;overflow-x:auto;white-space:pre-wrap;word-break:break-all;color:var(--muted);line-height:1.6;margin-bottom:0.75rem;"></pre>
    <button id="embed-copy-btn" onclick="copyEmbed()" class="btn" style="font-size:0.85rem;padding:0.5rem 1rem;">Copy Embed Code</button>
  </div>

</Layout>


<script is:inline>
(function() {
  const today = new Date();
  const delivery = new Date(today);
  delivery.setDate(delivery.getDate() + 14);
  const fmtD = d => d.toISOString().slice(0, 10);
  document.getElementById('po-date').value       = fmtD(today);
  document.getElementById('delivery-date').value = fmtD(delivery);
  document.getElementById('po-number').value     = 'PO-' + today.getFullYear() + '-001';

  document.addEventListener('currencychange', renderPreview);

  fillDocFromBiz();

  if (!localStorage.getItem('biz_setup_done')) setTimeout(openBizModal, 400);

  renderPreview();
})();

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function fmt(n) {
  const c = window.__currency || { locale: 'en-US', code: 'USD' };
  return new Intl.NumberFormat(c.locale, { style: 'currency', currency: c.code, minimumFractionDigits: 2 }).format(n);
}

function addrLines(street, city, state, zip) {
  const line2 = [city, state].filter(Boolean).join(', ') + (zip ? ' ' + zip : '');
  return [street, line2].filter(Boolean);
}

function getLineItems() {
  return Array.from(document.querySelectorAll('#line-items .li-card')).map(card => {
    const qty  = parseFloat(card.querySelector('.li-qty-val')?.value)  || 0;
    const rate = parseFloat(card.querySelector('.li-rate-val')?.value) || 0;
    return { desc: card.querySelector('.li-description')?.value || '', qty, rate, total: qty * rate };
  }).filter(r => r.desc || r.total > 0);
}

function updateLineTotals() {
  document.querySelectorAll('#line-items .li-card').forEach(card => {
    const qty  = parseFloat(card.querySelector('.li-qty-val')?.value)  || 0;
    const rate = parseFloat(card.querySelector('.li-rate-val')?.value) || 0;
    const el   = card.querySelector('.inv-li-total');
    if (el) el.textContent = (qty && rate) ? fmt(qty * rate) : '—';
  });
}

function fillDocFromBiz() {
  const get = k => localStorage.getItem(k) || '';
  const name = get('biz_name'), email = get('biz_email'), phone = get('biz_phone');
  const street = get('biz_street'), city = get('biz_city'), state = get('biz_state'), zip = get('biz_zip');
  const logo = get('biz_logo');

  const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
  set('from-name', name); set('from-email', email); set('from-phone', phone);
  set('from-street', street); set('from-city', city); set('from-state', state); set('from-zip', zip);

  const dispName  = document.getElementById('inv-biz-disp-name');
  const dispMeta  = document.getElementById('inv-biz-disp-meta');
  const logoThumb = document.getElementById('inv-biz-logo-thumb');
  if (dispName) { dispName.textContent = name || 'No profile saved — click Edit to set up'; dispName.style.color = name ? 'var(--text)' : 'var(--muted)'; }
  if (dispMeta) { const p = []; if (phone) p.push(phone); if (email) p.push(email); dispMeta.textContent = p.join('  ·  '); }
  if (logoThumb) { if (logo) { logoThumb.src = logo; logoThumb.style.display = 'block'; } else { logoThumb.style.display = 'none'; } }

  renderPreview();
}

function updateToAddrLabels() {
  var code = (document.getElementById('to-country')?.value || 'US');
  var cfg  = (typeof ADDR_CONFIG !== 'undefined' ? ADDR_CONFIG[code] : null) || { regionLabel: 'State / Region', regionPh: '', postalLabel: 'Postal Code', postalPh: '' };
  var lblState = document.getElementById('lbl-to-state');
  var lblZip   = document.getElementById('lbl-to-zip');
  var fldState = document.getElementById('field-to-state');
  var fldZip   = document.getElementById('field-to-zip');
  var inpState = document.getElementById('to-state');
  var inpZip   = document.getElementById('to-zip');
  if (cfg.regionLabel) {
    if (fldState) fldState.style.display = '';
    if (lblState) lblState.textContent = cfg.regionLabel;
    if (inpState) inpState.placeholder  = cfg.regionPh;
  } else {
    if (fldState) fldState.style.display = 'none';
    if (inpState) inpState.value = '';
  }
  if (cfg.postalLabel) {
    if (fldZip) fldZip.style.display = '';
    if (lblZip) lblZip.textContent = cfg.postalLabel;
    if (inpZip) inpZip.placeholder  = cfg.postalPh;
  } else {
    if (fldZip) fldZip.style.display = 'none';
    if (inpZip) inpZip.value = '';
  }
}

function buildLineRow(desc, qty, rate, removable) {
  const card = document.createElement('div');
  card.className = 'li-card';
  const total = (parseFloat(qty) || 0) * (parseFloat(rate) || 0);
  card.innerHTML = `
    <div class="field">
      <label>Description / Part #</label>
      <input type="text" class="li-description" placeholder="Item description or part number" oninput="renderPreview()" value="${esc(desc || '')}" />
    </div>
    <div class="li-bottom-row">
      <div class="field li-field-sm">
        <label>Qty</label>
        <input type="text" inputmode="decimal" class="li-qty-val" placeholder="1" value="${qty || 1}" oninput="renderPreview()" />
      </div>
      <div class="field li-field-md">
        <label>Unit Price</label>
        <input type="text" inputmode="decimal" class="li-rate-val" placeholder="0.00" value="${rate || ''}" oninput="renderPreview()" />
      </div>
      <div class="li-total-block">
        <div class="li-total-label">Total</div>
        <div class="li-total-val inv-li-total">${total > 0 ? fmt(total) : '—'}</div>
      </div>
      ${removable
        ? '<button class="li-remove-btn" onclick="this.closest(\'.li-card\').remove();renderPreview();" type="button" title="Remove line">×</button>'
        : '<div class="li-remove-placeholder"></div>'}
    </div>
  `;
  return card;
}

function addLine() {
  const container = document.getElementById('line-items');
  const card = buildLineRow('', 1, '', true);
  container.appendChild(card);
  card.querySelector('.li-description').focus();
}

function getTaxLines() {
  return Array.from(document.querySelectorAll('#tax-lines .tax-row')).map(row => {
    const label = (row.querySelector('.tax-name')?.value || '').trim();
    const rate  = parseFloat(row.querySelector('.tax-pct')?.value) || 0;
    return { label: label || 'Tax', rate };
  });
}

function buildTaxRow(label, rate) {
  const row = document.createElement('div');
  row.className = 'tax-row';
  row.innerHTML = `
    <div class="field">
      <label>Tax Label</label>
      <input type="text" class="tax-name" value="${esc(label)}" placeholder="Sales Tax" oninput="renderPreview()" />
    </div>
    <div class="field">
      <label>Rate (%)</label>
      <input type="text" inputmode="decimal" class="tax-pct" placeholder="0" value="${esc(String(rate))}" oninput="renderPreview()" />
    </div>
    <button class="li-remove-btn" onclick="this.closest('.tax-row').remove();renderPreview();" type="button" title="Remove tax">×</button>
  `;
  return row;
}

function addTax() {
  const container = document.getElementById('tax-lines');
  const row = buildTaxRow('', 0);
  container.appendChild(row);
  row.querySelector('.tax-name').focus();
}

function renderPreview() {
  updateLineTotals();

  const items    = getLineItems();
  const subtotal = items.reduce((s, r) => s + r.total, 0);
  const taxes    = getTaxLines().filter(t => t.rate > 0);
  const taxTotal = taxes.reduce((s, t) => s + subtotal * (t.rate / 100), 0);
  const shipping = parseFloat(document.getElementById('shipping-cost')?.value) || 0;
  const total    = subtotal + taxTotal + shipping;

  const fromName   = (document.getElementById('from-name')?.value   || '').trim();
  const fromEmail  = (document.getElementById('from-email')?.value  || '').trim();
  const fromPhone  = (document.getElementById('from-phone')?.value  || '').trim();
  const fromAddr   = addrLines(
    (document.getElementById('from-street')?.value || '').trim(),
    (document.getElementById('from-city')?.value   || '').trim(),
    (document.getElementById('from-state')?.value  || '').trim(),
    (document.getElementById('from-zip')?.value    || '').trim()
  );
  const bizCountryName = localStorage.getItem('biz_country_name') || '';
  if (localStorage.getItem('biz_show_country') === '1' && bizCountryName) fromAddr.push(bizCountryName);
  const toName  = (document.getElementById('to-name')?.value  || '').trim();
  const toEmail = (document.getElementById('to-email')?.value || '').trim();
  const toAddr  = addrLines(
    (document.getElementById('to-street')?.value || '').trim(),
    (document.getElementById('to-city')?.value   || '').trim(),
    (document.getElementById('to-state')?.value  || '').trim(),
    (document.getElementById('to-zip')?.value    || '').trim()
  );
  const shipName  = (document.getElementById('ship-name')?.value  || '').trim();
  const shipAddr  = addrLines(
    (document.getElementById('ship-street')?.value || '').trim(),
    (document.getElementById('ship-city')?.value   || '').trim(),
    (document.getElementById('ship-state')?.value  || '').trim(),
    (document.getElementById('ship-zip')?.value    || '').trim()
  );
  const hasShip = !!(shipName || shipAddr.length);

  const poNum     = document.getElementById('po-number')?.value || 'PO-001';
  const poDate    = document.getElementById('po-date')?.value   || '';
  const delivDate = document.getElementById('delivery-date')?.value || '';
  const payTerms  = document.getElementById('payment-terms')?.value || '';
  const notes     = (document.getElementById('notes')?.value || '').trim();
  const authBy    = (document.getElementById('authorized-by')?.value || '').trim();
  const logo      = localStorage.getItem('biz_logo');

  const navy   = localStorage.getItem('biz_primary_color') || '#0f2d52';
  const fox    = localStorage.getItem('biz_accent_color')  || '#d4500a';
  const muted  = '#6b7c93';
  const border = '#e8ecf2';
  const bg     = '#f5f7fa';

  const lineRows = items.length
    ? items.map((r, i) => `
        <tr style="background:${i % 2 === 0 ? '#fff' : '#fafbfd'};">
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};font-size:.86em;color:#1a2332;">${esc(r.desc)}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:center;font-size:.86em;color:${muted};">${r.qty}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:right;font-size:.86em;color:${muted};">${fmt(r.rate)}</td>
          <td style="padding:.55rem .7rem;border-bottom:1px solid ${border};text-align:right;font-size:.88em;font-weight:600;color:#1a2332;">${fmt(r.total)}</td>
        </tr>`).join('')
    : `<tr><td colspan="4" style="padding:1.5rem .7rem;text-align:center;font-size:.85em;color:#c0c8d4;font-style:italic;">Add a line item to get started</td></tr>`;

  const billToBlock = `
    <div>
      <div style="font-size:.66em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.4em;">Bill To</div>
      ${fromName
        ? `<div style="font-size:.94em;font-weight:600;color:#1a2332;margin-bottom:.18em;">${esc(fromName)}</div>`
        : `<div style="font-size:.94em;color:#d0d7e2;font-style:italic;">Your Company</div>`}
      ${fromPhone ? `<div style="font-size:.8em;color:${muted};">${esc(fromPhone)}</div>` : ''}
      ${fromEmail ? `<div style="font-size:.8em;color:${muted};">${esc(fromEmail)}</div>` : ''}
      ${fromAddr.map(l => `<div style="font-size:.8em;color:${muted};line-height:1.5;">${esc(l)}</div>`).join('')}
    </div>`;

  const vendorBlock = `
    <div>
      <div style="font-size:.66em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.4em;">Vendor</div>
      ${toName
        ? `<div style="font-size:.94em;font-weight:600;color:#1a2332;margin-bottom:.18em;">${esc(toName)}</div>`
        : `<div style="font-size:.94em;color:#d0d7e2;font-style:italic;">Vendor name</div>`}
      ${toEmail ? `<div style="font-size:.8em;color:${muted};">${esc(toEmail)}</div>` : ''}
      ${toAddr.map(l => `<div style="font-size:.8em;color:${muted};line-height:1.5;">${esc(l)}</div>`).join('')}
    </div>`;

  const shipBlock = hasShip ? `
    <div>
      <div style="font-size:.66em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.4em;">Ship To</div>
      ${shipName
        ? `<div style="font-size:.94em;font-weight:600;color:#1a2332;margin-bottom:.18em;">${esc(shipName)}</div>`
        : (fromName ? `<div style="font-size:.94em;font-weight:600;color:#1a2332;margin-bottom:.18em;">${esc(fromName)}</div>` : '')}
      ${(shipAddr.length ? shipAddr : fromAddr).map(l => `<div style="font-size:.8em;color:${muted};line-height:1.5;">${esc(l)}</div>`).join('')}
    </div>` : '';

  document.getElementById('doc-paper').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.5rem;gap:1rem;">
      <div style="flex:1;min-width:0;">
        ${logo ? `<img src="${logo}" style="max-height:56px;max-width:170px;object-fit:contain;display:block;margin-bottom:.65rem;" alt="logo" />` : ''}
        ${fromName
          ? `<div style="font-size:1.05em;font-weight:700;color:${navy};margin-bottom:.18em;line-height:1.3;">${esc(fromName)}</div>`
          : `<div style="font-size:1.05em;font-weight:700;color:#d0d7e2;line-height:1.3;">Your Company</div>`}
      </div>
      <div style="text-align:right;flex-shrink:0;">
        <div style="font-size:1.7em;font-weight:800;color:${navy};letter-spacing:-.02em;line-height:1;margin-bottom:.4em;">PURCHASE ORDER</div>
        <div style="display:inline-block;background:${bg};border:1px solid ${border};border-radius:5px;padding:.3em .7em;text-align:left;">
          <div style="font-size:.74em;color:${muted};margin-bottom:.15em;">PO #</div>
          <div style="font-size:.92em;font-weight:700;color:${navy};">${esc(poNum)}</div>
          ${poDate    ? `<div style="font-size:.72em;color:${muted};margin-top:.25em;">Date: ${esc(poDate)}</div>` : ''}
          ${delivDate ? `<div style="font-size:.72em;color:${muted};">Delivery: ${esc(delivDate)}</div>` : ''}
          ${payTerms  ? `<div style="font-size:.72em;color:${fox};font-weight:600;">Terms: ${esc(payTerms)}</div>` : ''}
        </div>
      </div>
    </div>

    <div style="height:1px;background:${border};margin-bottom:1.3rem;"></div>

    <div style="display:grid;grid-template-columns:${hasShip ? '1fr 1fr 1fr' : '1fr 1fr'};gap:1.25rem;margin-bottom:1.5rem;">
      ${billToBlock}
      ${vendorBlock}
      ${shipBlock}
    </div>

    <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;border-radius:6px;overflow:hidden;">
      <thead>
        <tr style="background:${navy};">
          <th style="padding:.55rem .7rem;text-align:left;font-size:.7em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;">Description / Part #</th>
          <th style="padding:.55rem .7rem;text-align:center;font-size:.7em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Qty</th>
          <th style="padding:.55rem .7rem;text-align:right;font-size:.7em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Unit Price</th>
          <th style="padding:.55rem .7rem;text-align:right;font-size:.7em;text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,0.85);font-weight:600;white-space:nowrap;">Total</th>
        </tr>
      </thead>
      <tbody>${lineRows}</tbody>
    </table>

    <div style="display:flex;justify-content:flex-end;">
      <div style="width:230px;">
        <div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.85em;color:${muted};border-bottom:1px solid ${border};"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
        ${taxes.map(t => `<div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.85em;color:${muted};border-bottom:1px solid ${border};"><span>${esc(t.label)} (${t.rate}%)</span><span>${fmt(subtotal * t.rate / 100)}</span></div>`).join('')}
        ${shipping > 0 ? `<div style="display:flex;justify-content:space-between;padding:.3rem 0;font-size:.85em;color:${muted};border-bottom:1px solid ${border};"><span>Shipping / Freight</span><span>${fmt(shipping)}</span></div>` : ''}
        <div style="display:flex;justify-content:space-between;padding:.5rem 0 .35rem;font-size:1.02em;font-weight:700;color:${navy};margin-top:.1rem;"><span>Total</span><span>${fmt(total)}</span></div>
      </div>
    </div>

    ${notes ? `
    <div style="margin-top:1.5rem;padding:1rem 1.1rem;background:${bg};border-radius:7px;border:1px solid ${border};">
      <div style="font-size:.66em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.5em;">Special Instructions</div>
      <div style="font-size:.82em;color:${muted};line-height:1.6;white-space:pre-wrap;">${esc(notes)}</div>
    </div>` : ''}

    <div style="margin-top:1.5rem;padding:1.1rem 1.2rem;border:1px solid ${border};border-radius:7px;background:#fafbfd;">
      <div style="font-size:.66em;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:${fox};margin-bottom:.5em;">Authorization</div>
      <div style="font-size:.8em;color:${muted};line-height:1.6;margin-bottom:1rem;">This purchase order constitutes authorization to ship the above items at the stated prices and terms. All deliveries must reference PO #${esc(poNum)}.</div>
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1.4;min-width:90px;border-top:1px solid #1a2332;padding-top:.3rem;font-size:.7em;color:${muted};">${authBy ? esc(authBy) : 'Authorized By'}</div>
        <div style="flex:1;min-width:60px;border-top:1px solid #1a2332;padding-top:.3rem;font-size:.7em;color:${muted};">Title</div>
        <div style="flex:1;min-width:60px;border-top:1px solid #1a2332;padding-top:.3rem;font-size:.7em;color:${muted};">Date</div>
        <div style="flex:1.2;min-width:80px;border-top:1px solid #1a2332;padding-top:.3rem;font-size:.7em;color:${muted};">Signature</div>
      </div>
    </div>
  `;
}
</script>

<script is:inline>
document.getElementById('embed-code').textContent = '<iframe src="https://foxmargin.com/embed/purchase-order/" width="100%" height="760" frameborder="0" style="border-radius:8px;border:1px solid #e1e8ed;" title="Free Purchase Order Generator — FoxMargin"></iframe>';
function copyEmbed() {
  navigator.clipboard.writeText(document.getElementById('embed-code').textContent).then(() => {
    const btn = document.getElementById('embed-copy-btn');
    btn.textContent = '✓ Copied!';
    setTimeout(() => btn.textContent = 'Copy Embed Code', 2000);
  });
}
</script>
</content>
</invoke>